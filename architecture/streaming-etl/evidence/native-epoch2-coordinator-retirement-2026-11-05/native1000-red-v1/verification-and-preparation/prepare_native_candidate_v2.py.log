s=s.replace("    raise SystemExit(result)","    if (trial/'health-red.json').exists():raise SystemExit(91)\n    if monitor is not None and monitor.returncode!=0:raise SystemExit(92)\n    if mode=='run' and not (trial/'health-summary.json').exists():raise SystemExit(93)\n    raise SystemExit(result)")
s=s.replace("'audit_hook_sha256':hashlib.sha256(site.encode()).hexdigest()", "'audit_hook_sha256':hashlib.sha256(site.encode()).hexdigest(),'declared_workload_documents':1000,'external_wrapper_sha256':hashlib.sha256((BASE/'test_native_normal1000.py').read_bytes()).hexdigest(),'health_monitor_sha256':hashlib.sha256((BASE/'health_monitor.py').read_bytes()).hexdigest(),'health_interval_seconds':2,'health_red_rule':'Any normal-probe HTTP5xx mention or persisted Task.run_count>1 triggers guarded stop before further volume'")
