        (trial/'session.json').write_text(json.dumps({'pytest_pid':process.pid,'pytest_start_ticks':start_ticks,'trial':str(trial)},indent=2)+'\\n')
        monitor=None
        if mode=='run':
            monitor=subprocess.Popen([str(ROOT/'.venv/bin/python'),str(BASE/'health_monitor.py'),str(trial)],cwd=ROOT,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            (trial/'health-session.json').write_text(json.dumps({'monitor_pid':monitor.pid},indent=2)+'\\n')"""
