    revisions={}
    for path in (ROOT/'src/prefect/server/database/_migrations/versions'/backend).glob('*.py'):
        values={}
        for node in ast.parse(path.read_text()).body:
            if isinstance(node,ast.Assign):
                for target in node.targets:
                    if isinstance(target,ast.Name) and target.id in {'revision','down_revision'}:values[target.id]=ast.literal_eval(node.value)
        if 'revision' in values:revisions[values['revision']]=values.get('down_revision')
    parents={x for down in revisions.values() for x in ((down,) if isinstance(down,str) else (down or ()))}
    assert set(revisions)-parents=={expected};heads[backend]=expected
