+            manifest.manifest_digest == execution.manifest_digest,
+            task.id == execution.task_run_id,
+            assignment.input_stream_id == execution.input_stream_id,
+            manifest.stream_id == execution.output_stream_id,
+        )
+    if not all(expected):
