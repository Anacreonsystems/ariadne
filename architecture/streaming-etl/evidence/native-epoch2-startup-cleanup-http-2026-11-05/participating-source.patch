+async def _graph(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph_id: UUID,
+    execution: StreamExecutionCredentials | WorkerStreamAuthorization | None,
+    *,
+    update: bool = False,
+    terminal_replay: bool = False,
+) -> orm_models.StreamGraphRevision:
+    await _backend(session, db)
+    if isinstance(execution, WorkerStreamAuthorization):
+        execution.validate(session, graph_revision_id=graph_id)
+        if update and not execution.graph_update:
+            raise NativeStreamError(
+                "PROTOCOL_ERROR",
+                "Worker graph mutation requires its prelocked exclusive graph proof",
+            )
+        authority = await control_authority(
+            session,
+            db,
+            execution.flow_run_id,
+            execution,
+            allowed_states=("ACTIVE", "TERMINAL", "RELEASED")
+            if terminal_replay
+            else ("ACTIVE",),
+        )
+        if authority is None or authority.cancel_requested and not terminal_replay:
+            raise NativeStreamError(
+                "CANCEL_REQUESTED", "Flow authority no longer admits physical work"
+            )
+        if execution.graph.state == "RELEASED" and not terminal_replay:
+            raise NativeStreamError("RECOVERY_HORIZON_EXPIRED", "Graph was released")
+        return execution.graph
+    graph = await session.get(db.StreamGraphRevision, graph_id)
+    if graph is None:
+        raise NativeStreamError("NOT_FOUND", "Unknown graph revision")
+    if (
+        isinstance(execution, WorkerStreamAuthorization)
+        and graph.id != execution.graph_revision_id
+    ):
+        raise NativeStreamError(
+            "SUBTASK_SCOPE_DENIED", "Worker authorization belongs to another graph"
+        )
+    await session.execute(
+        sa.select(db.FlowRun.id)
+        .where(db.FlowRun.id == graph.flow_run_id)
+        .with_for_update(read=not update)
+    )
+    authority = await control_authority(
+        session,
+        db,
+        graph.flow_run_id,
+        execution,
+        allowed_states=("ACTIVE", "TERMINAL", "RELEASED")
+        if terminal_replay
+        else ("ACTIVE",),
+    )
+    if authority is None or authority.cancel_requested and not terminal_replay:
+        raise NativeStreamError(
+            "CANCEL_REQUESTED", "Flow authority no longer admits physical work"
+        )
+    graph = await session.scalar(
+        sa.select(db.StreamGraphRevision)
+        .where(db.StreamGraphRevision.id == graph_id)
+        .with_for_update(read=not update)
+        .execution_options(populate_existing=True)
+    )
+    assert graph is not None
+    if graph.state == "RELEASED" and not terminal_replay:
+        raise NativeStreamError("RECOVERY_HORIZON_EXPIRED", "Graph was released")
+    return graph
