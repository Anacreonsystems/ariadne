+def death_for(grant: s.StreamSubtaskGrant) -> dict[str, object]:
+    return {
+        "kind": "WAITPID",
+        "observed_at": now("UTC"),
+        "host_id": grant.host_id,
+        "boot_id": grant.boot_id,
+        "child_process_id": grant.child_process_id,
+        "process_start_ticks": grant.process_start_ticks,
+        "exit_code": -9,
+    }
