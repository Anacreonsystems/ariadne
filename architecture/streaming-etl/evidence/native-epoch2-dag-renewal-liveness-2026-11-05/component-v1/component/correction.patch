+async def _renewal_grant_row(db: PrefectDBInterface, grant_id: UUID) -> dict[str, Any]:
+    async with db.session_context() as check:
+        row = (
+            (
+                await check.execute(
+                    sa.select(db.StreamSubtaskGrant.__table__).where(
+                        db.StreamSubtaskGrant.id == grant_id
+                    )
+                )
+            )
+            .mappings()
+            .one()
+        )
+        return dict(row)
