+                                db.StreamSubtaskAllocation,
+                                db.StreamSubtaskAllocation.subtask_id
+                                == db.StreamPhysicalSubtask.id,
+                            )
+                            .where(
+                                db.StreamGraphRevision.flow_run_id == run.id,
+                                db.StreamOperatorRun.operator_uid == "operator.sign",
+                                db.StreamPhysicalSubtask.subtask_index == 0,
+                            )
+                        )
+                    ).one()
+                    assert row.state_type.value == "COMPLETED"
+                    assert row.state == "COMPLETED"
+                    assert row.physical_slot_released is False
+                    assert row.released is True
+                    pending = (
+                        sa.select(sa.func.count())
+                        .select_from(db.StreamSubtaskAllocation)
+                        .where(
+                            db.StreamSubtaskAllocation.concurrency_limit_id
+                            == db.ConcurrencyLimitV2.id,
+                            db.StreamSubtaskAllocation.released.is_(False),
+                        )
+                        .correlate(db.ConcurrencyLimitV2)
+                        .scalar_subquery()
+                    )
+                    tag_slots, allocations = (
+                        await session.execute(
+                            sa.select(
+                                db.ConcurrencyLimitV2.active_slots, pending
+                            ).where(
+                                db.ConcurrencyLimitV2.name
+                                == "tag:partitioned-fixed-capacity"
+                            )
+                        )
+                    ).one()
+                    assert tag_slots == allocations
+                lifecycle_checks["terminal_stall"] = {
+                    "subtask_id": str(row.id),
+                    "pid": stall_pid,
+                    "task_state": "COMPLETED",
+                    "output_state": "COMPLETED",
+                    "physical_slot_released": False,
+                    "logical_tag_allocation_released": True,
+                    "flow_state": "RUNNING",
+                    "flow_lease_id": str(lease_id),
+                    "flow_slots": 1,
+                    "tag_slots": tag_slots,
+                    "unreleased_tag_allocations": allocations,
+                }
+                observed = True
+            with server.client() as client:
+                completed = client.read_flow_run(run.id)
+            if completed.state is not None and completed.state.is_final():
+                final_ns = time.monotonic_ns()
+                break
+            assert time.monotonic() < deadline, diagnostics()
+            time.sleep(1)
+        if fault in {"after-activation", "import-exit"}:
+            assert completed.state.is_failed(), diagnostics()
+        else:
+            assert completed.state.is_completed(), diagnostics()
+        assert completed.run_count == (2 if fault == "before-declaration" else 1)
+        assert await _deployment_slots(db, deployment_id) == 0
+        lifecycle_checks["final_flow_slots"] = 0
+        with server.client() as client:
+            assert (
+                client.read_global_concurrency_limit_by_name(
+                    "tag:partitioned-fixed-capacity"
+                ).active_slots
+                == 0
+            )
+        pids = [int(path.read_text()) for path in tmp_path.glob("*.pid")]
+        assert (
+            len(pids)
+            == len(set(pids))
+            == (
+                0
+                if fault == "import-exit"
+                else (
+                    5
+                    if fault in {"operator-loss-200", "operator-before-yield-200"}
+                    else 4
+                )
+            )
+        )
+        signed = [
+            json.loads(path.read_text()) for path in tmp_path.glob("signed-*.json")
+        ]
+        assert len(signed) == (0 if fault == "import-exit" else count)
+        assert all(item["partition"] == (item["number"] - 1) % 2 for item in signed)
+        if fault in {"import-probe", "import-exit"}:
+            imports = [
+                json.loads(path.read_text()) for path in tmp_path.glob("import-*.json")
+            ]
+            assert (
+                (1 <= len(imports) <= 4)
+                if fault == "import-exit"
+                else len(imports) == 4
+            )
+            assert all(
+                item
+                == {
+                    "physical_context": False,
+                    "flow_context": False,
+                    "headers_present": False,
+                    "auth_present": False,
+                    "http_status": 401,
+                    "import_count": 1,
+                }
+                for item in imports
+            )
+        if fault in {"operator-loss-200", "operator-before-yield-200"}:
+            assert observed
+            replay = 200 if fault == "operator-before-yield-200" else 201
+            assert (tmp_path / "replacement-started").read_text() == str(replay)
+            first = [
+                json.loads(line)
+                for line in (tmp_path / "calls-0-1.jsonl").read_text().splitlines()
+            ]
+            second = [
+                json.loads(line)
+                for line in (tmp_path / "calls-0-2.jsonl").read_text().splitlines()
+            ]
+            assert [item["sequence"] for item in first] == list(range(1, 201))
+            assert [item["sequence"] for item in second] == list(
+                range(replay, count // 2 + 1)
+            )
+            assert {item["task_run_id"] for item in first} == {
+                item["task_run_id"] for item in second
+            }
+            assert len(list(tmp_path.glob("source-*.pid"))) == 2
+            assert len(list(tmp_path.glob("operator-1-*.pid"))) == 1
+        async with db.session_context() as session:
+            task_runs = (
+                await session.scalars(
+                    sa.select(db.TaskRun).where(db.TaskRun.flow_run_id == run.id)
+                )
+            ).all()
+            assert len(task_runs) == 4
+            for task_run in task_runs:
+                states = (
+                    await session.scalars(
+                        sa.select(db.TaskRunState.type)
+                        .where(db.TaskRunState.task_run_id == task_run.id)
+                        .order_by(db.TaskRunState.timestamp)
+                    )
+                ).all()
+                assert states[0].value == "PENDING"
+                if fault == "import-exit":
+                    assert {state.value for state in states} == {"PENDING", "FAILED"}
+                    assert task_run.run_count == 0
+                else:
+                    assert {state.value for state in states} >= {
+                        "PENDING",
+                        "RUNNING",
+                        "COMPLETED",
+                    }
+                    assert states[-1].value == "COMPLETED"
+                    assert task_run.run_count == (
+                        2
+                        if fault in {"operator-loss-200", "operator-before-yield-200"}
+                        and task_run.name.startswith("partitioned_operator")
+                        and task_run.name.endswith("[0]")
+                        else 1
+                    )
+            assert (
+                await session.scalar(
+                    sa.select(sa.func.count())
+                    .select_from(db.StreamPartition)
+                    .where(db.StreamPartition.flow_run_id == run.id)
+                )
+                == 4
+            )
+            placement = (
+                await session.execute(
+                    sa.select(
+                        db.StreamPhysicalSubtask.subtask_index,
+                        db.StreamOperatorRun.operator_uid,
+                        db.StreamPhysicalSubtask.assigned_worker_id,
+                        db.StreamPhysicalSubtask.physical_slot_released,
+                    )
+                    .join(
+                        db.StreamOperatorRun,
+                        db.StreamOperatorRun.id
+                        == db.StreamPhysicalSubtask.operator_run_id,
+                    )
+                    .join(
+                        db.StreamGraphRevision,
+                        db.StreamGraphRevision.id
+                        == db.StreamPhysicalSubtask.graph_revision_id,
+                    )
+                    .where(db.StreamGraphRevision.flow_run_id == run.id)
+                )
+            ).all()
+            assert len(placement) == 4
+            assert {item.assigned_worker_id for item in placement} == {
+                worker.id for worker in registered
+            }
+            assert all(item.physical_slot_released for item in placement)
+            if fault == "terminal-exit-stall":
+                assert observed
+                assert not (tmp_path / "terminal-stall-natural-exit").exists()
+                stall = lifecycle_checks["terminal_stall"]
+                with pytest.raises(ProcessLookupError):
+                    os.kill(stall["pid"], 0)
+                retirement = (
+                    await session.scalars(
+                        sa.select(db.StreamSubtaskReplacement).where(
+                            db.StreamSubtaskReplacement.subtask_id
+                            == UUID(stall["subtask_id"])
+                        )
+                    )
+                ).one()
+                assert retirement.state == "RETIRED"
+                assert retirement.death_witness["child_process_id"] == stall["pid"]
+                assert retirement.retirement_outcome["task_state"] == "COMPLETED"
+                assert (
+                    retirement.retirement_outcome["outcome_kind"]
+                    == "COMPLETED_RECONCILED"
+                )
+                lifecycle_checks["terminal_stall_retirement"] = {
+                    "state": retirement.state,
+                    "death_witness_kind": retirement.death_witness["kind"],
+                    "outcome_kind": retirement.retirement_outcome["outcome_kind"],
+                    "physical_slot_released": True,
+                    "natural_exit_marker_present": False,
+                }
+            worker_pids = {
+                worker.id: workers[worker_names.index(worker.name)].pid
+                for worker in registered
+            }
+            if fault != "import-exit":
+                for item in placement:
+                    prefix = (
+                        "source"
+                        if item.operator_uid == "source.documents"
+                        else "operator"
+                    )
+                    assert (
+                        int(
+                            (
+                                tmp_path / f"{prefix}-{item.subtask_index}-1.ppid"
+                            ).read_text()
+                        )
+                        == worker_pids[item.assigned_worker_id]
+                    )
+        passed = True
+    finally:
+        for worker in workers:
+            if worker.poll() is None:
+                worker.terminate()
+        for worker in workers:
+            try:
+                worker.wait(timeout=15)
+            except subprocess.TimeoutExpired:
+                worker.kill()
+                worker.wait(timeout=5)
+        try:
+            observation = {
+                "status": "PASS" if passed else "FAIL",
+                "count": count,
+                "fault": fault,
+                "asynchronous": asynchronous,
+                "flow_run_id": str(run.id) if run is not None else None,
+                "workers": [
+                    {
+                        "worker_id": str(item.id),
+                        "name": item.name,
+                        "pid": workers[worker_names.index(item.name)].pid,
+                    }
+                    for item in registered
+                ],
+                "phase_timings": _phase_observation(tmp_path, ready_ns, final_ns),
+                "lifecycle_checks": lifecycle_checks,
+            }
+        except Exception as timing_error:
+            (tmp_path / "case-observation.json").write_text(
+                json.dumps(
+                    {
+                        "status": "TIMING_CAPTURE_FAILED",
+                        "error_type": type(timing_error).__name__,
+                    }
+                )
+                + "\n"
+            )
+            if passed:
+                raise
+        else:
+            (tmp_path / "case-observation.json").write_text(
+                json.dumps(observation, indent=2) + "\n"
+            )
diff --git a/tests/fixtures/native_partitioned_stream_flow.py b/tests/fixtures/native_partitioned_stream_flow.py
new file mode 100644
index 0000000..e583cb7
--- /dev/null
+++ b/tests/fixtures/native_partitioned_stream_flow.py
@@ -0,0 +1,315 @@
+"""Versioned fixed-P2 Tasks used by real ProcessWorker acceptance."""
+
+import asyncio
+import atexit
+import json
+import os
+import sys
+import time
+from pathlib import Path
+from uuid import uuid4
+
+import httpx
+
+from prefect import flow, task
+from prefect._internal.stream_execution import (
+    get_stream_execution,
+    get_stream_subtask_execution,
+    stream_subtask_headers,
+)
+from prefect.streams import (
+    NativeStreamFlowConfig,
+    SourceContext,
+    SourceRecord,
+    StreamContext,
+    StreamPartitionCall,
+    StreamSourceConfig,
+    StreamTaskConfig,
+)
+
+if (
+    os.environ.get("NATIVE_PARTITIONED_IMPORT_PROBE")
+    and Path(sys.argv[0]).name == "stream_subtask_entrypoint.py"
+):
+    probe_directory = Path(os.environ["NATIVE_PARTITIONED_IMPORT_DIRECTORY"])
+    probe_path = probe_directory / f"import-{os.getpid()}.json"
+    prior_imports = (
+        json.loads(probe_path.read_text())["import_count"] if probe_path.exists() else 0
+    )
+    probe_api = os.environ["PREFECT_API_URL"]
+    probe = {
+        "import_count": prior_imports + 1,
+        "physical_context": get_stream_subtask_execution() is not None,
+        "flow_context": get_stream_execution() is not None,
+        "headers_present": bool(
+            stream_subtask_headers(probe_api, probe_api + "/streams/v1/create", "POST")
+        ),
+        "auth_present": any(
+            os.environ.get(name)
+            for name in (
+                "PREFECT_API_AUTH_STRING",
+                "PREFECT_SERVER_API_AUTH_STRING",
+                "PREFECT_API_KEY",
+            )
+        ),
+    }
+    probe_response = httpx.post(
+        probe_api + "/streams/v1/create",
+        json={
+            "flow_run_id": os.environ.get(
+                "NATIVE_PARTITIONED_IMPORT_FLOW", str(uuid4())
+            ),
+            "stream_id": str(uuid4()),
+        },
+        timeout=5,
+    )
+    probe["http_status"] = probe_response.status_code
+    probe_path.write_text(json.dumps(probe))
+    assert not any(
+        probe[key]
+        for key in (
+            "physical_context",
+            "flow_context",
+            "headers_present",
+            "auth_present",
+        )
+    )
+    assert probe_response.status_code == 401
+    if os.environ["NATIVE_PARTITIONED_IMPORT_PROBE"] == "exit":
+        raise SystemExit(73)
+
+
+@task(
+    version="native-partitioned-v1",
+    retries=2,
+    tags={"partitioned-fixed-capacity"},
+    stream=StreamSourceConfig(),
+)
+def partitioned_source(
+    ctx: SourceContext, split: int, count: int, directory: str, fault: str = "none"
+):
+    target = Path(directory)
+    (target / f"source-{split}-{ctx.attempt}.pid").write_text(str(os.getpid()))
+    (target / f"source-{split}-{ctx.attempt}.ppid").write_text(str(os.getppid()))
+    for position in range(ctx.accepted_source_position + 1, count // 2 + 1):
+        number = 2 * (position - 1) + split + 1
+        yield SourceRecord(
+            position,
+            {"number": number, "document_ref": str(target / f"document-{number}.json")},
+        )
+        if position == 1:
+            (target / f"source-first-accepted-{split}.time").write_text(
+                str(time.monotonic_ns())
+            )
+    if fault in {"operator-loss-200", "operator-before-yield-200"}:
+        deadline = time.monotonic() + 90
+        while not (target / "replacement-started").exists():
+            if time.monotonic() > deadline:
+                raise TimeoutError(
+                    "Replacement did not start while healthy sources waited"
+                )
+            time.sleep(0.02)
+
+
+@task(
+    version="native-partitioned-v1",
+    retries=2,
+    tags={"partitioned-fixed-capacity"},
+    stream=StreamTaskConfig(input="document"),
+)
+def partitioned_operator(
+    ctx: StreamContext, document: dict, directory: str, fault: str = "none"
+):
+    target = Path(directory)
+    if (
+        fault == "terminal-exit-stall"
+        and ctx.partition_index == 0
+        and ctx.attempt == 1
+        and ctx.input_sequence == 1
+    ):
+
+        def stall_after_terminal() -> None:
+            (target / "terminal-stall-entered").write_text(str(os.getpid()))
+            time.sleep(30)
+            (target / "terminal-stall-natural-exit").touch()
+
+        atexit.register(stall_after_terminal)
+    (target / f"operator-{ctx.partition_index}-{ctx.attempt}.pid").write_text(
+        str(os.getpid())
+    )
+    (target / f"operator-{ctx.partition_index}-{ctx.attempt}.ppid").write_text(
+        str(os.getppid())
+    )
+    if (
+        ctx.partition_index == 0
+        and ctx.attempt > 1
+        and not (target / "replacement-started").exists()
+    ):
+        if fault in {"operator-loss-200", "operator-before-yield-200"}:
+            deadline = time.monotonic() + 30
+            while not (target / "cut-observed").exists():
+                if time.monotonic() > deadline:
+                    raise TimeoutError(
+                        "Recovery observer did not record the durable cursor"
+                    )
+                time.sleep(0.02)
+        (target / "replacement-started").write_text(str(ctx.input_sequence))
+    if (
+        fault == "operator-loss-200"
+        and ctx.partition_index == 0
+        and ctx.attempt == 1
+        and ctx.input_sequence == 201
+    ):
+        (target / "operator-loss").write_text(
+            json.dumps(
+                {
+                    "pid": os.getpid(),
+                    "task_run_id": str(ctx.task_run_id),
+                    "monotonic_ns": time.monotonic_ns(),
+                }
+            )
+        )
+        os._exit(77)
+    with (target / f"calls-{ctx.partition_index}-{ctx.attempt}.jsonl").open(
+        "a"
+    ) as calls:
+        calls.write(
+            json.dumps(
+                {
+                    "sequence": ctx.input_sequence,
+                    "task_run_id": str(ctx.task_run_id),
+                    "pid": os.getpid(),
+                    "assignment_epoch": ctx.assignment_epoch,
+                    "operator_uid": ctx.operator_uid,
+                    "monotonic_ns": time.monotonic_ns(),
+                }
+            )
+            + "\n"
+        )
+    value = json.loads(Path(document["document_ref"]).read_text())
+    signed = {
+        **value,
+        "signed": True,
+        "partition": ctx.partition_index,
+        "input_sequence": ctx.input_sequence,
+    }
+    (target / f"signed-{value['number']}.json").write_text(json.dumps(signed))
+    if (
+        fault == "operator-before-yield-200"
+        and ctx.partition_index == 0
+        and ctx.attempt == 1
+        and ctx.input_sequence == 200
+    ):
+        # The stable document filename is client-owned idempotence. This effect
+        # can repeat because the platform has not accepted the terminal yield.
+        (target / "operator-loss").write_text(
+            json.dumps(
+                {
+                    "pid": os.getpid(),
+                    "task_run_id": str(ctx.task_run_id),
+                    "monotonic_ns": time.monotonic_ns(),
+                }
+            )
+        )
+        os._exit(77)
+    yield {
+        "number": value["number"],
+        "signed_ref": str(target / f"signed-{value['number']}.json"),
+    }
+
+
+@task(
+    version="native-partitioned-v1",
+    retries=2,
+    tags={"partitioned-fixed-capacity"},
+    stream=StreamSourceConfig(),
+)
+async def partitioned_source_async(
+    ctx: SourceContext, split: int, count: int, directory: str, fault: str = "none"
+):
+    for record in partitioned_source.fn(ctx, split, count, directory, fault):
+        await asyncio.sleep(0)
+        yield record
+
+
+@task(
+    version="native-partitioned-v1",
+    retries=2,
+    tags={"partitioned-fixed-capacity"},
+    stream=StreamTaskConfig(input="document"),
+)
+async def partitioned_operator_async(
+    ctx: StreamContext, document: dict, directory: str, fault: str = "none"
+):
+    await asyncio.sleep(0)
+    for value in partitioned_operator.fn(ctx, document, directory, fault):
+        yield value
+
+
+def _partitioned_graph(directory: str, count: int, fault: str, asynchronous: bool):
+    target = Path(directory)
+    if fault == "before-declaration" and not (target / "before-declaration").exists():
+        (target / "before-declaration").touch()
+        deadline = time.monotonic() + 30
+        while not (target / "declaration-observed").exists():
+            if time.monotonic() > deadline:
+                raise TimeoutError("No pre-declaration observation")
+            time.sleep(0.02)
+        raise RuntimeError("Application error before graph declaration")
+    source_task = partitioned_source_async if asynchronous else partitioned_source
+    operator_task = partitioned_operator_async if asynchronous else partitioned_operator
+    source = source_task.submit_partitioned_stream(
+        operator_uid="source.documents",
+        partitions=(
+            StreamPartitionCall(
+                parameters={
+                    "split": 0,
+                    "count": count,
+                    "directory": directory,
+                    "fault": fault,
+                }
+            ),
+            StreamPartitionCall(
+                parameters={
+                    "split": 1,
+                    "count": count,
+                    "directory": directory,
+                    "fault": fault,
+                }
+            ),
+        ),
+    )
+    output = operator_task.submit_partitioned_stream(
+        operator_uid="operator.sign",
+        upstream=source,
+        partitions=(
+            StreamPartitionCall(parameters={"directory": directory, "fault": fault}),
+            StreamPartitionCall(parameters={"directory": directory, "fault": fault}),
+        ),
+    )
+    if fault == "after-activation":
+        raise RuntimeError("Application error after graph activation")
+    return output
+
+
+@flow(
+    version="native-partitioned-v1",
+    retries=2,
+    streaming=NativeStreamFlowConfig(profile="partitioned-fixed-v1", partition_count=2),
+)
+def partitioned_documents(directory: str, count: int = 8, fault: str = "none"):
+    _partitioned_graph(directory, count, fault, False).wait()
+    return {"documents": count}
+
+
+@flow(
+    version="native-partitioned-v1",
+    retries=2,
+    streaming=NativeStreamFlowConfig(profile="partitioned-fixed-v1", partition_count=2),
+)
+async def partitioned_documents_async(
+    directory: str, count: int = 8, fault: str = "none"
+):
+    output = _partitioned_graph(directory, count, fault, True)
+    await asyncio.to_thread(output.wait)
+    return {"documents": count}
