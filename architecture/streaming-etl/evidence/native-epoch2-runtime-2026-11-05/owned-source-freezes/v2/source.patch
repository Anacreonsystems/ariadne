+                raise httpx.ReadError("ack lost")
+            return receipt(event)
+
+        async def adeliver(**kwargs: Any):
+            return deliver(**kwargs)
+
+        client = SimpleNamespace(
+            emit_stream_subtask_event=adeliver if asynchronous else deliver
+        )
