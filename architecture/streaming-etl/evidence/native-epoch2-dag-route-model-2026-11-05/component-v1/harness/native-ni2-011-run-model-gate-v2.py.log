import datetime,hashlib,json,os,subprocess,sys,time,uuid
from pathlib import Path
root=Path('/workspace/ariadne'); base=Path('/tmp')/sys.argv[1]; base.mkdir(exist_ok=False); options=sys.argv[4:]; sqlite='--sqlite' in options; options=[p for p in options if p!='--sqlite']; dbname='native_ni2011_model_'+uuid.uuid4().hex[:8]
paths=[p for p in (root/'src/prefect').rglob('*.py') if '__pycache__' not in p.parts]+[root/p for p in ['tests/server/models/test_stream_routes.py','tests/server/models/test_stream_dags.py','tests/server/models/test_stream_executions.py','tests/conftest.py','pyproject.toml','uv.lock']]
files={str(p.relative_to(root)):hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(paths)}; (base/'source-before.json').write_text(json.dumps({'captured_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'files':files},indent=2)+'\n')
for rel in ['src/prefect/server/models/stream_routes.py','tests/server/models/test_stream_routes.py','tests/conftest.py']:
 p=base/'source-copies'/(rel+'.log');p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes((root/rel).read_bytes())
(base/'config.json').write_text(json.dumps({'database_name':dbname},indent=2)+'\n'); env=os.environ.copy(); env['PREFECT_SERVER_DATABASE_CONNECTION_URL']=(f'sqlite+aiosqlite:///{base}/seed.db' if sqlite else f'postgresql+asyncpg://native_recovery:native_recovery@127.0.0.1:55436/{dbname}')
command=['uv','run','--no-sync','python','-m','pytest','-q',sys.argv[2],'--basetemp',str(base/'pytest-temp'),'--junitxml',str(base/'result.xml'),*options]
record={'command':command,'started_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'classification':sys.argv[3],'head':subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip()}; (base/'command.json').write_text(json.dumps(record,indent=2)+'\n'); start=time.monotonic()
with (base/'result.log').open('w') as log: result=subprocess.run(command,cwd=root,env=env,stdout=log,stderr=subprocess.STDOUT)
record.update(exit_code=result.returncode,elapsed_seconds=time.monotonic()-start); (base/'result.exit').write_text(str(result.returncode)+'\n'); (base/'result.json').write_text(json.dumps(record,indent=2)+'\n')
after={rel:hashlib.sha256((root/rel).read_bytes()).hexdigest() for rel in files}; (base/'source-after.json').write_text(json.dumps({'files':after,'drift':[rel for rel in files if files[rel]!=after[rel]]},indent=2)+'\n'); print(json.dumps(record,indent=2)); print((base/'result.log').read_text()[-10000:])
