diff --git a/src/prefect/server/models/stream_dag_executions.py b/src/prefect/server/models/stream_dag_executions.py
new file mode 100644
index 0000000..2430c94
--- /dev/null
+++ b/src/prefect/server/models/stream_dag_executions.py
@@ -0,0 +1,2685 @@
+"""Transactional DAG lifecycle authority, separate from fixed-P2 execution.
+
+The graph lock serializes start, activation and control. Physical reservations
+remain held until the assigned worker closes the complete persisted launch set.
+"""
+
+import hmac
+from dataclasses import dataclass
+from datetime import timedelta
+from typing import Any, Literal, TypeAlias, TypeVar, cast
+from uuid import UUID, uuid5
+
+import sqlalchemy as sa
+from pydantic import BaseModel
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from prefect._internal.stream_event_auth import (
+    canonical_dag_bootstrap_ready_witness,
+    dag_worker_generation_digest,
+    verify_dag_bootstrap_ready,
+)
+from prefect._internal.stream_route_plan import graph_routing_digest
+from prefect._internal.uuid7 import uuid7
+from prefect.server.database import PrefectDBInterface, orm_models
+from prefect.server.models import flow_runs as flow_run_models
+from prefect.server.models import stream_dags, stream_routes
+from prefect.server.models import task_runs as task_run_models
+from prefect.server.models._stream_errors import NativeStreamError
+from prefect.server.models.stream_executions import (
+    apply_flow_lifecycle_result,
+    guard_flow_lifecycle,
+    guard_task_lifecycle,
+    require_execution,
+    require_no_remaining_dag_flow_retry,
+)
+from prefect.server.models.stream_subtask_authority import (
+    capability_digest,
+    dag_lifecycle_control,
+    release_allocations,
+    require_physical_backend,
+)
+from prefect.server.models.stream_subtasks import grant_projection
+from prefect.server.models.streams import (
+    canonical_stream_payload,
+    finish_stream_partition,
+)
+from prefect.server.orchestration.core_policy import CoreFlowPolicy, CoreTaskPolicy
+from prefect.server.schemas import core, states
+from prefect.server.schemas import stream_dag_executions as s
+from prefect.server.schemas import stream_dags as topology
+from prefect.server.schemas import stream_routes as routed
+from prefect.server.schemas import stream_subtasks as physical
+from prefect.server.schemas import streams as storage
+from prefect.server.schemas.responses import SetStateStatus
+from prefect.server.schemas.states import StateType
+from prefect.server.schemas.statuses import WorkerStatus
+from prefect.server.schemas.streams import StreamExecutionCredentials
+from prefect.types import DateTime
+from prefect.types._datetime import now
+
+DAG_PROFILE: Literal["partitioned-dag-v1"] = "partitioned-dag-v1"
+OperationRequest: TypeAlias = (
+    s.StreamDAGStartRequest
+    | s.StreamDAGActivateRequest
+    | s.StreamDAGAbortPreviewRequest
+    | s.StreamDAGCancelRequest
+    | s.StreamDAGFailRequest
+)
+ReceiptT = TypeVar("ReceiptT", bound=BaseModel)
+
+
+def dag_digest(value: object) -> str:
+    """Digest strict server-built JSON using the existing stream encoding."""
+    return canonical_stream_payload(value)[2]
+
+
+def make_dag_receipt(model: type[ReceiptT], material: dict[str, Any]) -> ReceiptT:
+    """Hash canonical wire values, including normalized timestamp spelling."""
+    candidate = model.model_validate({**material, "outcome_digest": "0" * 64})
+    return candidate.model_copy(
+        update={
+            "outcome_digest": dag_digest(
+                candidate.model_dump(mode="json", exclude={"outcome_digest"})
+            )
+        }
+    )
+
+
+@dataclass(frozen=True)
+class DAGGraphScope:
+    """Session-bound ordered Flow/authority/graph lock prefix."""
+
+    session: AsyncSession
+    transaction: object
+    flow: orm_models.FlowRun
+    authority: orm_models.StreamExecutionAuthority
+    graph: orm_models.StreamGraphRevision
+    update: bool
+
+    def validate(self, session: AsyncSession, *, update: bool = False) -> None:
+        if (
+            self.session is not session
+            or self.transaction is not session.get_transaction()
+            or self.graph.profile != DAG_PROFILE
+            or self.graph.flow_run_id != self.flow.id
+            or self.authority.flow_run_id != self.flow.id
+            or self.authority.flow_run_run_count != self.flow.run_count
+            or (update and not self.update)
+        ):
+            raise NativeStreamError("IDENTITY_CONFLICT", "DAG lock scope differs")
+
+
+def complete_closed_launch_digest(
+    scope: DAGGraphScope,
+    subtask: orm_models.StreamPhysicalSubtask,
+    attempts: list[orm_models.StreamDAGLaunchAttempt],
+) -> str:
+    """Bind the complete immutable birth/closure set to this physical target."""
+    if not attempts or [row.attempt_index for row in attempts] != list(
+        range(1, len(attempts) + 1)
+    ):
+        raise NativeStreamError(
+            "PHYSICAL_STOP_REQUIRED", "Complete process birth history is missing"
+        )
+    material: list[dict[str, Any]] = []
+    for row in attempts:
+        if (
+            row.state != "CLOSED"
+            or row.close_receipt is None
+            or row.graph_revision_id != scope.graph.id
+            or row.subtask_id != subtask.id
+            or row.task_run_id != subtask.task_run_id
+            or row.worker_id != subtask.assigned_worker_id
+            or row.start_operation_id != scope.graph.admission_operation_id
+            or (row.flow_generation, row.flow_holder_id, row.flow_run_run_count)
+            != (
+                scope.authority.generation,
+                scope.authority.holder_id,
+                scope.flow.run_count,
+            )
+        ):
+            raise NativeStreamError(
+                "PHYSICAL_STOP_REQUIRED",
+                "A current exact process birth remains open or outside its target",
+            )
+        receipt = s.StreamDAGLaunchCloseReceipt.model_validate(row.close_receipt)
+        if (
+            receipt.operation_id != row.close_operation_id
+            or receipt.launch_attempt_id != row.id
+            or receipt.graph_revision_id != row.graph_revision_id
+            or receipt.subtask_id != row.subtask_id
+            or receipt.attempt_index != row.attempt_index
+            or receipt.request_digest != row.close_request_digest
+            or receipt.outcome_digest
+            != dag_digest(receipt.model_dump(mode="json", exclude={"outcome_digest"}))
+        ):
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT", "Persisted process closure differs"
+            )
+        material.append(
+            {
+                "launch_attempt_id": str(row.id),
+                "attempt_index": row.attempt_index,
+                "close_outcome_digest": receipt.outcome_digest,
+            }
+        )
+    if not any(row.grant_id == subtask.current_grant_id for row in attempts):
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "Current grant has no closed recorded birth"
+        )
+    return dag_digest(
+        {
+            "graph_revision_id": str(scope.graph.id),
+            "subtask_id": str(subtask.id),
+            "task_run_id": str(subtask.task_run_id),
+            "grant_id": str(subtask.current_grant_id),
+            "physical_epoch": subtask.physical_epoch,
+            "attempts": material,
+        }
+    )
+
+
+async def lock_dag_graph(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph_id: UUID,
+    execution: StreamExecutionCredentials | None,
+    *,
+    update: bool,
+    worker: bool = False,
+) -> DAGGraphScope:
+    """Acquire one lock prefix; worker=True is internal trusted-worker authority.
+
+    A worker caller must subsequently validate its exact assigned principal under
+    the Worker lock before using the scope. This flag is never a wire field.
+    """
+    await require_physical_backend(session, db)
+    flow_id = await session.scalar(
+        sa.select(db.StreamGraphRevision.flow_run_id).where(
+            db.StreamGraphRevision.id == graph_id
+        )
+    )
+    if flow_id is None:
+        raise NativeStreamError("NOT_FOUND", "Unknown DAG revision")
+    flow = await session.scalar(
+        sa.select(db.FlowRun)
+        .where(db.FlowRun.id == flow_id)
+        .with_for_update(read=not update)
+        .execution_options(populate_existing=True)
+    )
+    if flow is None:
+        raise NativeStreamError("NOT_FOUND", "Unknown DAG FlowRun")
+    # Refresh before require_execution: an existing identity-map row cannot
+    # substitute for the authority protected by this transaction's lock.
+    authority = await session.scalar(
+        sa.select(db.StreamExecutionAuthority)
+        .where(db.StreamExecutionAuthority.flow_run_id == flow_id)
+        .with_for_update(read=not update)
+        .execution_options(populate_existing=True)
+    )
+    if not worker:
+        authority = await require_execution(
+            session,
+            db,
+            flow_id,
+            execution,
+            allowed_states=("CLAIMED", "ACTIVE", "TERMINAL", "RELEASED"),
+            update=update,
+        )
+    if authority is None:
+        raise NativeStreamError(
+            "EXECUTION_BINDING_REQUIRED", "DAG execution requires Flow authority"
+        )
+    graph = await session.scalar(
+        sa.select(db.StreamGraphRevision)
+        .where(db.StreamGraphRevision.id == graph_id)
+        .with_for_update(read=not update)
+        .execution_options(populate_existing=True)
+    )
+    if graph is None or graph.profile != DAG_PROFILE:
+        raise NativeStreamError("UNSUPPORTED_PROFILE", "A DAG revision is required")
+    scope = DAGGraphScope(
+        session, session.get_transaction(), flow, authority, graph, update
+    )
+    scope.validate(session)
+    # Public lifecycle belongs to the same deployed immutable Flow attempt.
+    snapshot = await session.scalar(
+        sa.select(db.NativeStreamDeploymentSnapshot).where(
+            db.NativeStreamDeploymentSnapshot.flow_run_id == flow.id
+        )
+    )
+    declaration = topology.StreamDAGSealRequest.model_validate(graph.declaration)
+    if (
+        snapshot is None
+        or snapshot.profile != DAG_PROFILE
+        or snapshot.state not in {"ACTIVE", "RELEASED"}
+        or flow.deployment_id != snapshot.deployment_id
+        or declaration.deployment_id != snapshot.deployment_id
+        or declaration.deployment_version != snapshot.deployment_version
+        or declaration.flow_version != snapshot.flow_version
+        or declaration.working_directory is None
+    ):
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "DAG execution differs from its deployed snapshot"
+        )
+    return scope
+
+
+def validate_operation(
+    scope: DAGGraphScope, request: OperationRequest, action: str
+) -> str:
+    graph = scope.graph
+    if (
+        request.operation_id != uuid5(graph.id, f"prefect-stream-dag-{action}-v1")
+        or request.graph_digest != graph.graph_digest
+        or request.routing_digest != graph_routing_digest(graph.graph_digest)
+    ):
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "DAG action identity or topology digest differs"
+        )
+    return dag_digest(request.model_dump(mode="json"))
+
+
+async def known_operation(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    scope: DAGGraphScope,
+    operation_id: UUID,
+    kind: str,
+    request_digest: str,
+) -> s.StreamDAGOperationReceipt | None:
+    row = await session.get(db.StreamDAGLifecycleOperation, operation_id)
+    if row is None:
+        return None
+    if (
+        row.graph_revision_id != scope.graph.id
+        or row.kind != kind
+        or row.request_digest != request_digest
+        or row.flow_run_run_count != scope.flow.run_count
+        or row.flow_generation != scope.authority.generation
+        or row.flow_holder_id != scope.authority.holder_id
+    ):
+        raise NativeStreamError("IDENTITY_CONFLICT", "DAG operation replay differs")
+    receipt = s.StreamDAGOperationReceipt.model_validate(row.accepted_receipt)
+    material = receipt.model_dump(mode="json", exclude={"outcome_digest"})
+    if (
+        receipt.operation_id != operation_id
+        or receipt.graph_revision_id != scope.graph.id
+        or receipt.request_digest != request_digest
+        or receipt.outcome_digest != row.outcome_digest
+        or receipt.outcome_digest != dag_digest(material)
+    ):
+        raise NativeStreamError("IDENTITY_CONFLICT", "Stored action receipt differs")
+    return receipt
+
+
+def require_mutable_execution(scope: DAGGraphScope) -> None:
+    if scope.graph.terminal_operation_id is not None or scope.graph.state == "RELEASED":
+        raise NativeStreamError("TERMINAL_CONFLICT", "DAG lifetime is already terminal")
+    if scope.authority.state not in {"CLAIMED", "ACTIVE"}:
+        raise NativeStreamError(
+            "RECOVERY_NOT_READY", "DAG Flow authority is not active"
+        )
+
+
+async def save_operation(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    scope: DAGGraphScope,
+    operation_id: UUID,
+    kind: Literal["START", "ACTIVATE", "ABORT_PREVIEW", "CANCEL", "FAIL"],
+    request_digest: str,
+    control: orm_models.StreamDAGLifecycleOperation | None = None,
+) -> s.StreamDAGOperationReceipt:
+    accepted_at = now("UTC")
+    material: dict[str, Any] = {
+        "operation_id": str(operation_id),
+        "graph_revision_id": str(scope.graph.id),
+        "kind": kind,
+        "request_digest": request_digest,
+        "accepted_at": accepted_at.isoformat(),
+        "effective_control_kind": control.effective_control_kind if control else None,
+        "control_operation_id": str(control.id) if control else None,
+    }
+    receipt = make_dag_receipt(s.StreamDAGOperationReceipt, material)
+    session.add(
+        db.StreamDAGLifecycleOperation(
+            id=operation_id,
+            operation_id=operation_id,
+            graph_revision_id=scope.graph.id,
+            flow_run_id=scope.flow.id,
+            kind=kind,
+            flow_generation=scope.authority.generation,
+            flow_holder_id=scope.authority.holder_id,
+            flow_run_run_count=scope.flow.run_count,
+            request_digest=request_digest,
+            accepted_receipt=receipt.model_dump(mode="json"),
+            outcome_digest=receipt.outcome_digest,
+            state="ACCEPTED",
+            effective_control_kind=control.effective_control_kind if control else None,
+            control_operation_id=control.id if control else None,
+        )
+    )
+    await session.flush()
+    return receipt
+
+
+async def project_execution(
+    session: AsyncSession, db: PrefectDBInterface, scope: DAGGraphScope
+) -> s.StreamDAGExecution:
+    scope.validate(session)
+    graph = scope.graph
+    subtasks = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamPhysicalSubtask).where(
+                    db.StreamPhysicalSubtask.graph_revision_id == graph.id
+                )
+            )
+        ).all()
+    )
+    declaration = topology.StreamDAGSealRequest.model_validate(graph.declaration)
+    if len(subtasks) != sum(row.parallelism for row in declaration.operators):
+        raise NativeStreamError("IDENTITY_CONFLICT", "DAG physical set is incomplete")
+    task_ids = {row.task_run_id for row in subtasks}
+    tasks = list(
+        (
+            await session.scalars(
+                sa.select(db.TaskRun).where(db.TaskRun.flow_run_id == scope.flow.id)
+            )
+        ).all()
+    )
+    if {row.id for row in tasks} != task_ids:
+        raise NativeStreamError("IDENTITY_CONFLICT", "DAG Flow TaskRun set differs")
+    grants = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamSubtaskGrant).where(
+                    db.StreamSubtaskGrant.id.in_(
+                        [
+                            row.current_grant_id
+                            for row in subtasks
+                            if row.current_grant_id
+                        ]
+                    )
+                )
+            )
+        ).all()
+    )
+    slots = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamPhysicalSlotAllocation).where(
+                    db.StreamPhysicalSlotAllocation.graph_revision_id == graph.id
+                )
+            )
+        ).all()
+    )
+    tags = await session.scalar(
+        sa.select(sa.func.count())
+        .select_from(db.StreamSubtaskAllocation)
+        .where(
+            db.StreamSubtaskAllocation.subtask_id.in_([row.id for row in subtasks]),
+            db.StreamSubtaskAllocation.released.is_(False),
+        )
+    )
+    control = (
+        await session.get(
+            db.StreamDAGLifecycleOperation, graph.current_control_operation_id
+        )
+        if graph.current_control_operation_id is not None
+        else None
+    )
+    terminal = (
+        await session.get(db.StreamDAGLifecycleOperation, graph.terminal_operation_id)
+        if graph.terminal_operation_id is not None
+        else None
+    )
+    if graph.current_control_operation_id is not None and (
+        control is None
+        or control.kind != "CONTROL"
+        or control.graph_revision_id != graph.id
+    ):
+        raise NativeStreamError("IDENTITY_CONFLICT", "DAG control journal differs")
+    if graph.terminal_operation_id is not None and (
+        terminal is None
+        or terminal.kind != "FINALIZE"
+        or terminal.graph_revision_id != graph.id
+        or terminal.state != "COMPLETED"
+        or terminal.terminal_outcome is None
+        or dag_digest(terminal.terminal_outcome) != terminal.outcome_digest
+    ):
+        raise NativeStreamError("IDENTITY_CONFLICT", "DAG terminal journal differs")
+    activation = (
+        await session.get(db.StreamDAGLifecycleOperation, graph.activation_operation_id)
+        if graph.activation_operation_id is not None
+        else None
+    )
+    if graph.activation_operation_id is not None and (
+        activation is None
+        or activation.kind != "ACTIVATE"
+        or activation.graph_revision_id != graph.id
+        or activation.target_set_digest is None
+    ):
+        raise NativeStreamError("IDENTITY_CONFLICT", "DAG activation journal differs")
+    phase: s.DAGPhase = (
+        "TERMINAL"
+        if terminal is not None
+        else "STOPPING"
+        if control is not None
+        else "ACTIVE"
+        if graph.startup_completed_at is not None
+        else "STARTING"
+        if graph.admission_operation_id is not None
+        else "PREVIEW"
+    )
+    return s.StreamDAGExecution(
+        graph_revision_id=graph.id,
+        flow_run_id=scope.flow.id,
+        graph_digest=graph.graph_digest,
+        routing_digest=graph_routing_digest(graph.graph_digest),
+        phase=phase,
+        terminal_state=cast(
+            s.TerminalState | None, terminal.terminal_state if terminal else None
+        ),
+        cleanup_complete=terminal is not None,
+        counts=s.StreamDAGExecutionCounts(
+            total=len(subtasks),
+            registered=sum(row.state == "REGISTERED" for row in grants),
+            bootstrap_ready=sum(
+                row.state == "REGISTERED" and row.bootstrap_ready_at is not None
+                for row in grants
+            ),
+            terminal_tasks=sum(
+                row.state_type
+                in {
+                    StateType.COMPLETED,
+                    StateType.FAILED,
+                    StateType.CRASHED,
+                    StateType.CANCELLED,
+                }
+                for row in tasks
+            ),
+            stopped=sum(row.released for row in slots),
+            physical_slots_remaining=sum(not row.released for row in slots),
+            tags_remaining=int(tags or 0),
+        ),
+        control=(
+            s.StreamDAGControlProjection(
+                operation_id=control.id,
+                kind=cast(s.ControlKind, control.effective_control_kind),
+                state="COMPLETED" if control.state == "COMPLETED" else "STOPPING",
+            )
+            if control
+            else None
+        ),
+        activation_operation_id=graph.activation_operation_id,
+        readiness_set_digest=activation.target_set_digest if activation else None,
+        terminal_operation_id=graph.terminal_operation_id,
+        terminal_outcome_digest=terminal.outcome_digest if terminal else None,
+    )
+
+
+async def read_stream_dag_execution(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph_id: UUID,
+    execution: StreamExecutionCredentials | None,
+) -> s.StreamDAGExecution:
+    scope = await lock_dag_graph(session, db, graph_id, execution, update=False)
+    return await project_execution(session, db, scope)
+
+
+async def start_stream_dag(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph_id: UUID,
+    request: s.StreamDAGStartRequest,
+    execution: StreamExecutionCredentials | None,
+) -> s.StreamDAGOperationResult:
+    scope = await lock_dag_graph(session, db, graph_id, execution, update=True)
+    digest = validate_operation(scope, request, "start")
+    receipt = await known_operation(
+        session, db, scope, request.operation_id, "START", digest
+    )
+    if receipt is not None:
+        return s.StreamDAGOperationResult(
+            receipt=receipt, execution=await project_execution(session, db, scope)
+        )
+    require_mutable_execution(scope)
+    require_no_remaining_dag_flow_retry(scope.flow)
+    if scope.graph.state != "SEALED" or scope.flow.state_type != StateType.RUNNING:
+        raise NativeStreamError(
+            "ADMISSION_NOT_ALLOWED",
+            "START requires its Running Flow and sealed preview",
+        )
+    snapshot = await session.scalar(
+        sa.select(db.NativeStreamDeploymentSnapshot).where(
+            db.NativeStreamDeploymentSnapshot.flow_run_id == scope.flow.id
+        )
+    )
+    if snapshot is None or snapshot.state != "ACTIVE":
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "START requires its active deployment snapshot"
+        )
+    # The receipt and complete region reservation commit together or neither does.
+    async with session.begin_nested():
+        receipt = await save_operation(
+            session, db, scope, request.operation_id, "START", digest
+        )
+        await stream_dags.admit_dag_metadata(
+            session,
+            db,
+            graph_id,
+            topology.StreamDAGAdmissionRequest(
+                operation_id=request.operation_id, graph_digest=request.graph_digest
+            ),
+            work_pool_id=snapshot.work_pool_id,
+        )
+    return s.StreamDAGOperationResult(
+        receipt=receipt, execution=await project_execution(session, db, scope)
+    )
+
+
+async def begin_dag_control(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    scope: DAGGraphScope,
+    kind: s.ControlKind,
+    cause: dict[str, Any],
+) -> orm_models.StreamDAGLifecycleOperation:
+    """Freeze every admitted target, including candidates without a grant."""
+    scope.validate(session, update=True)
+    graph = scope.graph
+    if graph.current_control_operation_id is not None:
+        row = await session.get(
+            db.StreamDAGLifecycleOperation, graph.current_control_operation_id
+        )
+        if row is None or row.kind != "CONTROL" or row.graph_revision_id != graph.id:
+            raise NativeStreamError("IDENTITY_CONFLICT", "Current DAG control differs")
+        compatible = row.effective_control_kind == kind or (
+            kind in {"FAIL", "STARTUP_ABORT"}
+            and row.effective_control_kind in {"FAIL", "STARTUP_ABORT"}
+        )
+        if not compatible:
+            raise NativeStreamError(
+                "CONTROL_CONFLICT", "An opposite DAG control is already authoritative"
+            )
+        return row
+    require_mutable_execution(scope)
+    subtasks = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamPhysicalSubtask)
+                .where(db.StreamPhysicalSubtask.graph_revision_id == graph.id)
+                .order_by(db.StreamPhysicalSubtask.id)
+            )
+        ).all()
+    )
+    worker_ids = sorted(
+        {
+            row.assigned_worker_id
+            for row in subtasks
+            if row.assigned_worker_id is not None
+        }
+    )
+    await session.execute(
+        sa.select(db.Worker.id)
+        .where(db.Worker.id.in_(worker_ids))
+        .order_by(db.Worker.id)
+        .with_for_update(read=True)
+    )
+    capabilities = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamWorkerCapability)
+                .where(
+                    db.StreamWorkerCapability.worker_id.in_(worker_ids),
+                    db.StreamWorkerCapability.protocol == DAG_PROFILE,
+                    db.StreamWorkerCapability.protocol_version == 1,
+                )
+                .order_by(db.StreamWorkerCapability.worker_id)
+                .with_for_update(read=True)
+            )
+        ).all()
+    )
+    by_worker = {row.worker_id: row for row in capabilities}
+    control_id = uuid5(
+        graph.id,
+        "prefect-stream-dag-startup-abort-v1"
+        if kind == "STARTUP_ABORT"
+        else f"prefect-stream-dag-control-{kind.lower().replace('_', '-')}-v1",
+    )
+    target_material: list[dict[str, Any]] = []
+    targets: list[orm_models.StreamDAGControlTarget] = []
+    for subtask in subtasks:
+        if subtask.assigned_worker_id is None:
+            if graph.admission_operation_id is not None:
+                raise NativeStreamError(
+                    "IDENTITY_CONFLICT", "Admitted target is unassigned"
+                )
+            continue
+        capability: (
+            orm_models.StreamWorkerCapability | orm_models.StreamDAGLaunchAttempt | None
+        ) = by_worker.get(subtask.assigned_worker_id)
+        retired_receipt: physical.StreamSubtaskVerifiedRetirement | None = None
+        closed_digest: str | None = None
+        if subtask.physical_slot_released:
+            slot = await session.scalar(
+                sa.select(db.StreamPhysicalSlotAllocation)
+                .where(db.StreamPhysicalSlotAllocation.subtask_id == subtask.id)
+                .with_for_update()
+            )
+            retired = await session.scalar(
+                sa.select(db.StreamSubtaskReplacement)
+                .where(
+                    db.StreamSubtaskReplacement.subtask_id == subtask.id,
+                    db.StreamSubtaskReplacement.operation_id
+                    == (slot.release_operation_id if slot else None),
+                    db.StreamSubtaskReplacement.state == "RETIRED",
+                )
+                .with_for_update()
+            )
+            if (
+                slot is None
+                or not slot.released
+                or slot.worker_id != subtask.assigned_worker_id
+                or retired is None
+                or retired.retirement_outcome is None
+            ):
+                raise NativeStreamError(
+                    "IDENTITY_CONFLICT",
+                    "Released control target lacks its exact normal-retirement proof",
+                )
+            envelope = retired.retirement_outcome
+            retired_receipt = physical.StreamSubtaskVerifiedRetirement.model_validate(
+                envelope.get("receipt")
+            )
+            attempts = list(
+                (
+                    await session.scalars(
+                        sa.select(db.StreamDAGLaunchAttempt)
+                        .where(db.StreamDAGLaunchAttempt.subtask_id == subtask.id)
+                        .order_by(db.StreamDAGLaunchAttempt.attempt_index)
+                        .with_for_update()
+                    )
+                ).all()
+            )
+            closed_digest = complete_closed_launch_digest(scope, subtask, attempts)
+            if (
+                envelope.get("all_attempts_closed_digest") != closed_digest
+                or retired_receipt.task_state != "COMPLETED"
+                or retired_receipt.grant_id != subtask.current_grant_id
+                or retired_receipt.physical_epoch != subtask.physical_epoch
+                or retired_receipt.task_run_id != subtask.task_run_id
+            ):
+                raise NativeStreamError(
+                    "IDENTITY_CONFLICT",
+                    "Normal retirement differs from the frozen control target",
+                )
+            capability = next(
+                (
+                    row
+                    for row in attempts
+                    if row.registered_grant_id == subtask.current_grant_id
+                ),
+                None,
+            )
+        if capability is None:
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT",
+                "Control cannot freeze an unknown assigned worker identity",
+            )
+        generation = dag_worker_generation_digest(
+            worker_id=UUID(str(capability.worker_id)),
+            work_pool_id=UUID(str(capability.work_pool_id)),
+            host_id=UUID(str(capability.host_id)),
+            boot_id=UUID(str(capability.boot_id)),
+            launcher_process_id=capability.launcher_process_id,
+            launcher_start_ticks=capability.launcher_start_ticks,
+        )
+        target_material.append(
+            {
+                "subtask_id": str(subtask.id),
+                "task_run_id": str(subtask.task_run_id),
+                "worker_id": str(capability.worker_id),
+                "worker_generation_digest": generation,
+                "grant_id": str(subtask.current_grant_id)
+                if subtask.current_grant_id
+                else None,
+                "physical_epoch": subtask.physical_epoch,
+            }
+        )
+        target = db.StreamDAGControlTarget(
+            id=uuid7(),
+            graph_revision_id=graph.id,
+            control_operation_id=control_id,
+            start_operation_id=graph.admission_operation_id,
+            subtask_id=subtask.id,
+            task_run_id=subtask.task_run_id,
+            worker_id=capability.worker_id,
+            work_pool_id=capability.work_pool_id,
+            host_id=capability.host_id,
+            boot_id=capability.boot_id,
+            launcher_process_id=capability.launcher_process_id,
+            launcher_start_ticks=capability.launcher_start_ticks,
+            worker_generation_digest=generation,
+            flow_generation=scope.authority.generation,
+            flow_holder_id=scope.authority.holder_id,
+            flow_run_run_count=scope.flow.run_count,
+            grant_id=subtask.current_grant_id,
+            physical_epoch=subtask.physical_epoch,
+            state="PENDING",
+        )
+        if retired_receipt is not None and closed_digest is not None:
+            stop_id = uuid5(control_id, "prefect-stream-dag-stop-v1/" + str(subtask.id))
+            principal = physical.StreamWorkerPrincipal(
+                work_pool_id=capability.work_pool_id,
+                host_id=capability.host_id,
+                boot_id=capability.boot_id,
+                launcher_process_id=capability.launcher_process_id,
+                launcher_start_ticks=capability.launcher_start_ticks,
+            )
+            stop_digest = dag_digest(
+                s.StreamDAGWorkerStopRequest(
+                    principal=principal,
+                    operation_id=stop_id,
+                    control_operation_id=control_id,
+                ).model_dump(mode="json")
+            )
+            stop_receipt = make_dag_receipt(
+                s.StreamDAGStopReceipt,
+                {
+                    "operation_id": str(stop_id),
+                    "control_operation_id": str(control_id),
+                    "graph_revision_id": str(graph.id),
+                    "subtask_id": str(subtask.id),
+                    "task_run_id": str(subtask.task_run_id),
+                    "grant_id": str(subtask.current_grant_id),
+                    "physical_epoch": subtask.physical_epoch,
+                    "state": "STOPPED",
+                    "task_state": "COMPLETED",
+                    "tag_allocation_released": True,
+                    "physical_slot_released": True,
+                    "all_attempts_closed_digest": closed_digest,
+                },
+            )
+            target.state = "STOPPED"
+            target.stop_operation_id = stop_id
+            target.stop_request_digest = stop_digest
+            target.all_attempts_closed_digest = closed_digest
+            target.stop_receipt = stop_receipt.model_dump(mode="json")
+            target.stopped_at = cast(DateTime, now("UTC"))
+            target_material[-1]["retired_outcome_digest"] = (
+                retired_receipt.outcome_digest
+            )
+            target_material[-1]["all_attempts_closed_digest"] = closed_digest
+        targets.append(target)
+    material = {
+        "graph_revision_id": str(graph.id),
+        "kind": kind,
+        "cause": cause,
+        "targets": target_material,
+    }
+    row = db.StreamDAGLifecycleOperation(
+        id=control_id,
+        operation_id=control_id,
+        graph_revision_id=graph.id,
+        flow_run_id=scope.flow.id,
+        kind="CONTROL",
+        flow_generation=scope.authority.generation,
+        flow_holder_id=scope.authority.holder_id,
+        flow_run_run_count=scope.flow.run_count,
+        request_digest=dag_digest(material),
+        accepted_receipt=material,
+        outcome_digest=dag_digest(material),
+        state="STOPPING",
+        effective_control_kind=kind,
+        first_cause=cause,
+        target_set_digest=dag_digest(target_material),
+    )
+    session.add(row)
+    await session.flush()
+    session.add_all(targets)
+    graph.current_control_operation_id = control_id
+    await session.flush()
+    return row
+
+
+async def finalize_preview(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    scope: DAGGraphScope,
+    control: orm_models.StreamDAGLifecycleOperation,
+) -> None:
+    """Only an unassigned, zero-process preview can clean up synchronously."""
+    if scope.graph.admission_operation_id is not None:
+        raise NativeStreamError(
+            "PHYSICAL_STOP_REQUIRED", "Every admitted target needs worker closure"
+        )
+    await stream_dags.abort_dag_metadata(
+        session,
+        db,
+        scope.graph.id,
+        physical.StreamGraphAbortRequest(
+            operation_id=control.id,
+            graph_digest=scope.graph.graph_digest,
+            error="Unstarted streaming DAG preview was closed",
+        ),
+    )
+    finished_at = now("UTC")
+    terminal_id = uuid5(scope.graph.id, "prefect-stream-dag-finalize-v1")
+    material = {
+        "graph_revision_id": str(scope.graph.id),
+        "terminal_state": "FAILED",
+        "control_operation_id": str(control.id),
+        "total": sum(
+            row.parallelism
+            for row in topology.StreamDAGSealRequest.model_validate(
+                scope.graph.declaration
+            ).operators
+        ),
+        "stopped": 0,
+    }
+    terminal = db.StreamDAGLifecycleOperation(
+        id=terminal_id,
+        operation_id=terminal_id,
+        graph_revision_id=scope.graph.id,
+        flow_run_id=scope.flow.id,
+        kind="FINALIZE",
+        flow_generation=scope.authority.generation,
+        flow_holder_id=scope.authority.holder_id,
+        flow_run_run_count=scope.flow.run_count,
+        request_digest=dag_digest(material),
+        accepted_receipt=material,
+        outcome_digest=dag_digest(material),
+        state="COMPLETED",
+        effective_control_kind=control.effective_control_kind,
+        control_operation_id=control.id,
+        terminal_state="FAILED",
+        terminal_outcome=material,
+        completed_at=finished_at,
+    )
+    session.add(terminal)
+    await session.flush()
+    scope.graph.terminal_operation_id = terminal_id
+    control.state = "COMPLETED"
+    control.completed_at = cast(DateTime, finished_at)
+    await session.flush()
+
+
+async def abort_stream_dag_preview(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph_id: UUID,
+    request: s.StreamDAGAbortPreviewRequest,
+    execution: StreamExecutionCredentials | None,
+) -> s.StreamDAGOperationResult:
+    scope = await lock_dag_graph(session, db, graph_id, execution, update=True)
+    digest = validate_operation(scope, request, "abort-preview")
+    receipt = await known_operation(
+        session, db, scope, request.operation_id, "ABORT_PREVIEW", digest
+    )
+    if receipt is None:
+        require_mutable_execution(scope)
+        if (
+            scope.graph.state != "SEALED"
+            or scope.graph.admission_operation_id is not None
+        ):
+            raise NativeStreamError(
+                "CONTROL_CONFLICT", "Only an unassigned preview can be aborted"
+            )
+        async with session.begin_nested():
+            control = await begin_dag_control(
+                session, db, scope, "PREVIEW_ABORT", {"kind": "PREVIEW_ABORT"}
+            )
+            await finalize_preview(session, db, scope, control)
+            receipt = await save_operation(
+                session,
+                db,
+                scope,
+                request.operation_id,
+                "ABORT_PREVIEW",
+                digest,
+                control,
+            )
+    return s.StreamDAGOperationResult(
+        receipt=receipt, execution=await project_execution(session, db, scope)
+    )
+
+
+async def cancel_stream_dag(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph_id: UUID,
+    request: s.StreamDAGCancelRequest,
+    execution: StreamExecutionCredentials | None,
+) -> s.StreamDAGOperationResult:
+    scope = await lock_dag_graph(session, db, graph_id, execution, update=True)
+    digest = validate_operation(scope, request, "cancel")
+    receipt = await known_operation(
+        session, db, scope, request.operation_id, "CANCEL", digest
+    )
+    if receipt is None:
+        require_mutable_execution(scope)
+        if scope.graph.admission_operation_id is None:
+            raise NativeStreamError(
+                "CONTROL_CONFLICT", "An unstarted preview must use abort-preview"
+            )
+        async with session.begin_nested():
+            control = await begin_dag_control(
+                session,
+                db,
+                scope,
+                "CANCEL",
+                {"kind": "CANCEL", "reason": request.reason},
+            )
+            receipt = await save_operation(
+                session, db, scope, request.operation_id, "CANCEL", digest, control
+            )
+    return s.StreamDAGOperationResult(
+        receipt=receipt, execution=await project_execution(session, db, scope)
+    )
+
+
+async def fail_stream_dag(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph_id: UUID,
+    request: s.StreamDAGFailRequest,
+    execution: StreamExecutionCredentials | None,
+) -> s.StreamDAGOperationResult:
+    scope = await lock_dag_graph(session, db, graph_id, execution, update=True)
+    digest = validate_operation(scope, request, "fail")
+    receipt = await known_operation(
+        session, db, scope, request.operation_id, "FAIL", digest
+    )
+    if receipt is None:
+        require_mutable_execution(scope)
+        kind: s.ControlKind = (
+            "PREVIEW_ABORT"
+            if scope.graph.admission_operation_id is None
+            else "STARTUP_ABORT"
+            if scope.graph.startup_completed_at is None
+            else "FAIL"
+        )
+        async with session.begin_nested():
+            control = await begin_dag_control(
+                session, db, scope, kind, {"kind": request.failure_kind}
+            )
+            if scope.graph.admission_operation_id is None:
+                await finalize_preview(session, db, scope, control)
+            receipt = await save_operation(
+                session, db, scope, request.operation_id, "FAIL", digest, control
+            )
+    return s.StreamDAGOperationResult(
+        receipt=receipt, execution=await project_execution(session, db, scope)
+    )
+
+
+@dataclass(frozen=True)
+class DAGChildScope:
+    graph: DAGGraphScope
+    subtask: orm_models.StreamPhysicalSubtask
+    grant: orm_models.StreamSubtaskGrant
+    launch: orm_models.StreamDAGLaunchAttempt
+
+
+async def lock_dag_child(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    credentials: physical.StreamSubtaskCredentials,
+    *,
+    subtask_id: UUID | None = None,
+    graph_update: bool = False,
+    grant_update: bool = False,
+    observe: bool = False,
+    ready: bool = False,
+    active: bool = False,
+) -> DAGChildScope:
+    """One ordered prefix for scoped bootstrap, DATA and signed events."""
+    await require_physical_backend(session, db)
+    locator = await session.get(db.StreamSubtaskGrant, credentials.grant_id)
+    if locator is None or not hmac.compare_digest(
+        locator.capability_digest, capability_digest(credentials.capability)
+    ):
+        raise NativeStreamError("SUBTASK_AUTH_INVALID", "Invalid subtask credential")
+    graph_id = await session.scalar(
+        sa.select(db.StreamPhysicalSubtask.graph_revision_id).where(
+            db.StreamPhysicalSubtask.id == locator.subtask_id
+        )
+    )
+    if graph_id is None:
+        raise NativeStreamError("SUBTASK_FENCED", "Physical target no longer exists")
+    scope = await lock_dag_graph(
+        session, db, graph_id, None, update=graph_update, worker=True
+    )
+    if locator.worker_id is None:
+        raise NativeStreamError(
+            "SUBTASK_FENCED", "DAG grants require an assigned worker"
+        )
+    await session.execute(
+        sa.select(db.Worker.id)
+        .where(db.Worker.id == locator.worker_id)
+        .with_for_update(read=True)
+    )
+    subtask = await session.scalar(
+        sa.select(db.StreamPhysicalSubtask)
+        .where(db.StreamPhysicalSubtask.id == locator.subtask_id)
+        .with_for_update(read=True)
+        .execution_options(populate_existing=True)
+    )
+    grant = await session.scalar(
+        sa.select(db.StreamSubtaskGrant)
+        .where(db.StreamSubtaskGrant.id == credentials.grant_id)
+        .with_for_update(read=not grant_update)
+        .execution_options(populate_existing=True)
+    )
+    if (
+        subtask is None
+        or grant is None
+        or (
+            not hmac.compare_digest(
+                grant.capability_digest, capability_digest(credentials.capability)
+            )
+            or (subtask_id is not None and subtask.id != subtask_id)
+            or subtask.current_grant_id != grant.id
+            or subtask.physical_epoch != grant.physical_epoch
+            or subtask.assigned_worker_id != grant.worker_id
+            or subtask.graph_revision_id != scope.graph.id
+            or grant.flow_generation != scope.authority.generation
+            or grant.flow_holder_id != scope.authority.holder_id
+            or grant.launcher_binding_kind != "ASSIGNED_WORKER"
+            or grant.state
+            not in (
+                {"REGISTERED", "RETIRED", "RELEASED"} if observe else {"REGISTERED"}
+            )
+        )
+    ):
+        raise NativeStreamError(
+            "SUBTASK_FENCED", "DAG subtask grant is no longer current"
+        )
+    slot = await session.scalar(
+        sa.select(db.StreamPhysicalSlotAllocation)
+        .where(db.StreamPhysicalSlotAllocation.subtask_id == subtask.id)
+        .with_for_update(read=True)
+        .execution_options(populate_existing=True)
+    )
+    if (
+        slot is None
+        or slot.graph_revision_id != scope.graph.id
+        or slot.worker_id != subtask.assigned_worker_id
+        or slot.admission_operation_id != scope.graph.admission_operation_id
+        or slot.released != subtask.physical_slot_released
+    ):
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "DAG child reservation identity differs"
+        )
+    if not observe and slot.released:
+        raise NativeStreamError(
+            "SUBTASK_FENCED", "A released physical target cannot perform child work"
+        )
+    launches = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamDAGLaunchAttempt)
+                .where(db.StreamDAGLaunchAttempt.registered_grant_id == grant.id)
+                .with_for_update(read=True)
+                .execution_options(populate_existing=True)
+            )
+        ).all()
+    )
+    if len(launches) != 1:
+        raise NativeStreamError(
+            "SUBTASK_FENCED", "DAG grant lacks its unique recorded launch"
+        )
+    launch = launches[0]
+    if (
+        launch.graph_revision_id != scope.graph.id
+        or launch.subtask_id != subtask.id
+        or launch.task_run_id != subtask.task_run_id
+        or launch.start_operation_id != scope.graph.admission_operation_id
+        or launch.grant_id != grant.id
+        or launch.planned_physical_epoch != grant.physical_epoch
+        or launch.worker_id != grant.worker_id
+        or (
+            launch.host_id,
+            launch.boot_id,
+            launch.launcher_process_id,
+            launch.launcher_start_ticks,
+            launch.child_process_id,
+            launch.process_start_ticks,
+        )
+        != (
+            grant.host_id,
+            grant.boot_id,
+            grant.launcher_process_id,
+            grant.launcher_start_ticks,
+            grant.child_process_id,
+            grant.process_start_ticks,
+        )
+        or (not observe and launch.state != "PID_RECORDED")
+        or launch.flow_generation != scope.authority.generation
+        or launch.flow_holder_id != scope.authority.holder_id
+        or launch.flow_run_run_count != scope.flow.run_count
+    ):
+        raise NativeStreamError(
+            "SUBTASK_FENCED", "DAG recorded process identity differs"
+        )
+    if not observe and (
+        scope.authority.state != "ACTIVE"
+        or scope.authority.cancel_requested
+        or scope.graph.current_control_operation_id is not None
+        or scope.graph.terminal_operation_id is not None
+    ):
+        raise NativeStreamError(
+            "CANCEL_REQUESTED", "DAG execution is fenced by control"
+        )
+    if ready and grant.bootstrap_ready_at is None:
+        raise NativeStreamError(
+            "BOOTSTRAP_NOT_READY",
+            "The current child has not acknowledged its bootstrap",
+        )
+    if active and (
+        scope.graph.state != "ADMITTED" or scope.graph.startup_completed_at is None
+    ):
+        raise NativeStreamError(
+            "ACTIVATION_NOT_READY", "DAG activation barrier has not committed"
+        )
+    child = DAGChildScope(scope, subtask, grant, launch)
+    if ready:
+        validate_current_bootstrap_ready(child)
+    return child
+
+
+def bootstrap_ready_witness(
+    child: DAGChildScope, operation_id: UUID, bootstrap_digest: str
+) -> bytes:
+    grant, graph = child.grant, child.graph.graph
+    if grant.child_process_id is None or grant.process_start_ticks is None:
+        raise NativeStreamError("SUBTASK_FENCED", "Registered child process is missing")
+    return canonical_dag_bootstrap_ready_witness(
+        operation_id=UUID(str(operation_id)),
+        flow_run_id=UUID(str(child.graph.flow.id)),
+        flow_run_run_count=child.graph.flow.run_count,
+        flow_generation=child.graph.authority.generation,
+        flow_holder_id=UUID(str(child.graph.authority.holder_id)),
+        graph_revision_id=UUID(str(graph.id)),
+        graph_digest=graph.graph_digest,
+        routing_digest=graph_routing_digest(graph.graph_digest),
+        assignment_epoch=child.subtask.assignment_epoch,
+        subtask_id=UUID(str(child.subtask.id)),
+        task_run_id=UUID(str(child.subtask.task_run_id)),
+        physical_epoch=grant.physical_epoch,
+        grant_id=UUID(str(grant.id)),
+        holder_id=UUID(str(grant.holder_id)),
+        scope_digest=grant.scope_digest,
+        event_key_id=grant.event_key_id,
+        child_process_id=grant.child_process_id,
+        process_start_ticks=grant.process_start_ticks,
+        bootstrap_digest=bootstrap_digest,
+    )
+
+
+def validate_current_bootstrap_ready(child: DAGChildScope) -> None:
+    """A non-null receipt is not authority without its exact signed witness."""
+    grant, graph = child.grant, child.graph.graph
+    if (
+        grant.bootstrap_digest is None
+        or grant.bootstrap_witness is None
+        or grant.bootstrap_ready_operation_id is None
+        or grant.bootstrap_ready_request_digest is None
+        or grant.bootstrap_ready_signature is None
+        or grant.bootstrap_ready_receipt is None
+        or grant.bootstrap_ready_at is None
+    ):
+        raise NativeStreamError(
+            "BOOTSTRAP_NOT_READY",
+            "Current child has no complete bootstrap acknowledgement",
+        )
+    try:
+        bootstrap = s.StreamDAGSubtaskBootstrap.model_validate(grant.bootstrap_witness)
+        receipt = s.StreamDAGBootstrapReadyResult.model_validate(
+            grant.bootstrap_ready_receipt
+        )
+        request = s.StreamDAGBootstrapReadyRequest(
+            operation_id=grant.bootstrap_ready_operation_id,
+            bootstrap_digest=grant.bootstrap_digest,
+            signature=grant.bootstrap_ready_signature,
+        )
+        valid = (
+            bootstrap.grant.id == grant.id
+            and bootstrap.launch_attempt_id == child.launch.id
+            and bootstrap.bootstrap_digest == grant.bootstrap_digest
+            and dag_digest(
+                bootstrap.model_dump(mode="json", exclude={"bootstrap_digest"})
+            )
+            == grant.bootstrap_digest
+            and receipt.operation_id
+            == request.operation_id
+            == uuid5(grant.id, "prefect-stream-dag-bootstrap-ready-v1")
+            and receipt.graph_revision_id == graph.id
+            and receipt.subtask_id == child.subtask.id
+            and receipt.grant_id == grant.id
+            and receipt.physical_epoch == grant.physical_epoch
+            and receipt.bootstrap_digest == grant.bootstrap_digest
+            and receipt.ready_at == grant.bootstrap_ready_at
+            and receipt.request_digest
+            == grant.bootstrap_ready_request_digest
+            == dag_digest(request.model_dump(mode="json"))
+            and receipt.outcome_digest
+            == dag_digest(receipt.model_dump(mode="json", exclude={"outcome_digest"}))
+            and verify_dag_bootstrap_ready(
+                bytes.fromhex(grant.event_public_key),
+                bootstrap_ready_witness(
+                    child, request.operation_id, grant.bootstrap_digest
+                ),
+                request.signature,
+            )
+        )
+    except (ValueError, TypeError) as exc:
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "Stored bootstrap acknowledgement is invalid"
+        ) from exc
+    if not valid:
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT",
+            "Stored bootstrap acknowledgement differs from its current child",
+        )
+
+
+async def read_stream_dag_subtask_bootstrap(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    subtask_id: UUID,
+    execution: physical.StreamSubtaskCredentials,
+) -> s.StreamDAGSubtaskBootstrap:
+    child = await lock_dag_child(
+        session, db, execution, subtask_id=subtask_id, grant_update=True
+    )
+    graph, subtask, grant = child.graph.graph, child.subtask, child.grant
+    if grant.bootstrap_witness is not None:
+        bootstrap = s.StreamDAGSubtaskBootstrap.model_validate(grant.bootstrap_witness)
+        if (
+            bootstrap.grant.id != grant.id
+            or bootstrap.launch_attempt_id != child.launch.id
+            or bootstrap.bootstrap_digest != grant.bootstrap_digest
+            or dag_digest(
+                bootstrap.model_dump(mode="json", exclude={"bootstrap_digest"})
+            )
+            != grant.bootstrap_digest
+        ):
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT", "Stored bootstrap witness differs"
+            )
+        return bootstrap
+    plan = await stream_dags.dag_admission_topology_witness(session, db, graph)
+    projected = next(row for row in plan.subtasks if row.id == subtask.id)
+    declaration = topology.StreamDAGSealRequest.model_validate(graph.declaration)
+    spec = next(
+        row
+        for row in declaration.operators
+        if row.operator_uid == projected.operator_uid
+    )
+    task = await session.scalar(
+        sa.select(db.TaskRun)
+        .where(db.TaskRun.id == subtask.task_run_id)
+        .with_for_update(read=True)
+        .execution_options(populate_existing=True)
+    )
+    if task is None or task.flow_run_run_count != child.graph.flow.run_count:
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "Bootstrap TaskRun attempt differs"
+        )
+    incoming = next(
+        (
+            (edge, part)
+            for edge in plan.edges
+            for part in edge.partitions
+            if part.target_subtask_id == subtask.id
+        ),
+        None,
+    )
+    input_projection = None
+    if incoming is not None:
+        edge, part = incoming
+        if spec.input_port is None:
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT", "Operator input port is missing"
+            )
+        input_projection = s.StreamDAGInputProjection(
+            subscriber_id=part.subscriber_id,
+            edge_id=edge.id,
+            edge_partition_id=part.id,
+            input_port_uid=spec.input_port.uid,
+            input_stream_id=part.stream_id,
+            schema_id=spec.input_port.schema_id,
+            schema_digest=spec.input_port.schema_digest,
+        )
+    assignment = s.StreamDAGExecutionAssignment.model_validate(
+        {
+            **projected.model_dump(mode="json"),
+            "graph_revision_id": graph.id,
+            "current_grant_id": grant.id,
+            "physical_epoch": grant.physical_epoch,
+        }
+    )
+    material = {
+        "flow_run_id": child.graph.flow.id,
+        "flow_run_run_count": child.graph.flow.run_count,
+        "flow_generation": child.graph.authority.generation,
+        "flow_holder_id": child.graph.authority.holder_id,
+        "assignment": assignment,
+        "grant": grant_projection(grant, subtask),
+        "context": stream_routes.context_for_subtask(plan, subtask.id),
+        "operator_parallelism": spec.parallelism,
+        "input": input_projection,
+        "output": s.StreamDAGOutputProjection(
+            port_uid=spec.output_port.uid, stream_id=subtask.output_stream_id
+        ),
+        "entrypoint": spec.entrypoint,
+        "task_key": spec.task_key,
+        "task_version": spec.task_version,
+        "artifact_digest": spec.artifact_digest,
+        "context_key": spec.context_key,
+        "task_policy": spec.task_policy,
+        "timeout_seconds": spec.timeout_seconds,
+        "effective_tags": sorted(set(spec.tags)),
+        "parameters": spec.parameters[subtask.subtask_index],
+        "input_key": spec.input_key,
+        "task_run": core.TaskRun.model_validate(task, from_attributes=True),
+        "reserved_tag_names": ["tag:" + tag for tag in sorted(set(spec.tags))],
+        "event_public_key": grant.event_public_key,
+        "launch_attempt_id": child.launch.id,
+        "worker_generation_digest": child.launch.worker_generation_digest,
+    }
+    # Validate/canonicalize through the exact wire model before its one-time digest.
+    candidate = s.StreamDAGSubtaskBootstrap.model_validate(
+        {**material, "bootstrap_digest": "0" * 64}
+    )
+    bootstrap = candidate.model_copy(
+        update={
+            "bootstrap_digest": dag_digest(
+                candidate.model_dump(mode="json", exclude={"bootstrap_digest"})
+            )
+        }
+    )
+    grant.bootstrap_digest = bootstrap.bootstrap_digest
+    grant.bootstrap_witness = bootstrap.model_dump(mode="json")
+    await session.flush()
+    return bootstrap
+
+
+async def mark_stream_dag_subtask_bootstrap_ready(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    subtask_id: UUID,
+    request: s.StreamDAGBootstrapReadyRequest,
+    execution: physical.StreamSubtaskCredentials,
+) -> s.StreamDAGBootstrapReadyResult:
+    child = await lock_dag_child(
+        session, db, execution, subtask_id=subtask_id, grant_update=True
+    )
+    grant, graph = child.grant, child.graph.graph
+    digest = dag_digest(request.model_dump(mode="json"))
+    if (
+        request.operation_id != uuid5(grant.id, "prefect-stream-dag-bootstrap-ready-v1")
+        or grant.bootstrap_digest != request.bootstrap_digest
+        or grant.bootstrap_witness is None
+    ):
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "Bootstrap acknowledgement differs"
+        )
+    if grant.bootstrap_ready_operation_id is not None:
+        if (
+            grant.bootstrap_ready_operation_id != request.operation_id
+            or grant.bootstrap_ready_request_digest != digest
+        ):
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT", "Bootstrap acknowledgement replay differs"
+            )
+        return s.StreamDAGBootstrapReadyResult.model_validate(
+            grant.bootstrap_ready_receipt
+        )
+    if grant.child_process_id is None or grant.process_start_ticks is None:
+        raise NativeStreamError("SUBTASK_FENCED", "Registered child process is missing")
+    witness = bootstrap_ready_witness(
+        child, request.operation_id, request.bootstrap_digest
+    )
+    if not verify_dag_bootstrap_ready(
+        bytes.fromhex(grant.event_public_key), witness, request.signature
+    ):
+        raise NativeStreamError(
+            "SUBTASK_AUTH_INVALID", "Invalid bootstrap acknowledgement signature"
+        )
+    ready_at = now("UTC")
+    material = {
+        "operation_id": str(request.operation_id),
+        "graph_revision_id": str(graph.id),
+        "subtask_id": str(subtask_id),
+        "grant_id": str(grant.id),
+        "physical_epoch": grant.physical_epoch,
+        "bootstrap_digest": request.bootstrap_digest,
+        "ready_at": ready_at.isoformat(),
+        "request_digest": digest,
+    }
+    receipt = make_dag_receipt(s.StreamDAGBootstrapReadyResult, material)
+    grant.bootstrap_ready_operation_id = request.operation_id
+    grant.bootstrap_ready_request_digest = digest
+    grant.bootstrap_ready_signature = request.signature
+    grant.bootstrap_ready_at = cast(DateTime, ready_at)
+    grant.bootstrap_ready_receipt = receipt.model_dump(mode="json")
+    await session.flush()
+    return receipt
+
+
+async def read_stream_dag_subtask_activation(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    subtask_id: UUID,
+    execution: physical.StreamSubtaskCredentials,
+) -> s.StreamDAGActivationObservation:
+    child = await lock_dag_child(
+        session, db, execution, subtask_id=subtask_id, observe=True
+    )
+    graph = child.graph.graph
+    phase: Literal["WAITING", "ACTIVE", "STOPPING", "TERMINAL"] = (
+        "TERMINAL"
+        if graph.terminal_operation_id is not None
+        else "STOPPING"
+        if graph.current_control_operation_id is not None
+        else "ACTIVE"
+        if graph.startup_completed_at is not None
+        and child.grant.bootstrap_ready_at is not None
+        else "WAITING"
+    )
+    return s.StreamDAGActivationObservation(
+        graph_revision_id=graph.id,
+        subtask_id=subtask_id,
+        grant_id=child.grant.id,
+        physical_epoch=child.grant.physical_epoch,
+        phase=phase,
+        activation_operation_id=graph.activation_operation_id,
+    )
+
+
+async def activate_stream_dag(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph_id: UUID,
+    request: s.StreamDAGActivateRequest,
+    execution: StreamExecutionCredentials | None,
+) -> s.StreamDAGOperationResult:
+    scope = await lock_dag_graph(session, db, graph_id, execution, update=True)
+    digest = validate_operation(scope, request, "activate")
+    receipt = await known_operation(
+        session, db, scope, request.operation_id, "ACTIVATE", digest
+    )
+    if receipt is not None:
+        return s.StreamDAGOperationResult(
+            receipt=receipt, execution=await project_execution(session, db, scope)
+        )
+    require_mutable_execution(scope)
+    if (
+        scope.graph.current_control_operation_id is not None
+        or scope.graph.state != "ADMITTED"
+    ):
+        raise NativeStreamError(
+            "CONTROL_CONFLICT", "DAG control or admission prevents activation"
+        )
+    plan = await stream_dags.dag_plan(session, db, scope.graph)
+    worker_ids = sorted(
+        {
+            row.assigned_worker_id
+            for row in plan.subtasks
+            if row.assigned_worker_id is not None
+        }
+    )
+    workers = list(
+        (
+            await session.scalars(
+                sa.select(db.Worker)
+                .where(db.Worker.id.in_(worker_ids))
+                .order_by(db.Worker.id)
+                .with_for_update(read=True)
+            )
+        ).all()
+    )
+    capabilities = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamWorkerCapability)
+                .where(
+                    db.StreamWorkerCapability.worker_id.in_(worker_ids),
+                    db.StreamWorkerCapability.protocol == DAG_PROFILE,
+                    db.StreamWorkerCapability.protocol_version == 1,
+                )
+                .order_by(db.StreamWorkerCapability.worker_id)
+                .with_for_update(read=True)
+            )
+        ).all()
+    )
+    if (
+        len(workers) != len(worker_ids)
+        or len(capabilities) != len(worker_ids)
+        or any(row.status != WorkerStatus.ONLINE for row in workers)
+        or any(
+            row.last_renewed_at < now("UTC") - timedelta(seconds=120)
+            for row in capabilities
+        )
+    ):
+        raise NativeStreamError(
+            "WORKER_NOT_READY",
+            "Activation requires the exact current online worker set",
+        )
+    by_worker = {row.worker_id: row for row in capabilities}
+    subtasks = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamPhysicalSubtask)
+                .where(db.StreamPhysicalSubtask.graph_revision_id == graph_id)
+                .order_by(db.StreamPhysicalSubtask.id)
+                .with_for_update(read=True)
+            )
+        ).all()
+    )
+    grants = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamSubtaskGrant)
+                .where(
+                    db.StreamSubtaskGrant.id.in_(
+                        [
+                            row.current_grant_id
+                            for row in subtasks
+                            if row.current_grant_id is not None
+                        ]
+                    )
+                )
+                .order_by(db.StreamSubtaskGrant.id)
+                .with_for_update(read=True)
+            )
+        ).all()
+    )
+    by_grant = {row.id: row for row in grants}
+    material: list[dict[str, Any]] = []
+    for subtask in subtasks:
+        grant = (
+            by_grant.get(subtask.current_grant_id) if subtask.current_grant_id else None
+        )
+        capability = (
+            by_worker.get(subtask.assigned_worker_id)
+            if subtask.assigned_worker_id
+            else None
+        )
+        launch = (
+            await session.scalar(
+                sa.select(db.StreamDAGLaunchAttempt).where(
+                    db.StreamDAGLaunchAttempt.registered_grant_id
+                    == subtask.current_grant_id
+                )
+            )
+            if subtask.current_grant_id
+            else None
+        )
+        if (
+            grant is None
+            or capability is None
+            or launch is None
+            or grant.state != "REGISTERED"
+            or grant.bootstrap_ready_at is None
+            or grant.bootstrap_digest is None
+            or grant.bootstrap_ready_receipt is None
+            or launch.state != "PID_RECORDED"
+            or launch.grant_id != grant.id
+            or launch.subtask_id != subtask.id
+            or grant.physical_epoch != subtask.physical_epoch
+            or grant.subtask_id != subtask.id
+            or grant.launcher_binding_kind != "ASSIGNED_WORKER"
+            or grant.worker_id != subtask.assigned_worker_id
+            or (
+                grant.work_pool_id,
+                grant.host_id,
+                grant.boot_id,
+                grant.launcher_process_id,
+                grant.launcher_start_ticks,
+            )
+            != (
+                capability.work_pool_id,
+                capability.host_id,
+                capability.boot_id,
+                capability.launcher_process_id,
+                capability.launcher_start_ticks,
+            )
+            or (grant.child_process_id, grant.process_start_ticks)
+            != (launch.child_process_id, launch.process_start_ticks)
+            or (grant.flow_generation, grant.flow_holder_id)
+            != (scope.authority.generation, scope.authority.holder_id)
+        ):
+            raise NativeStreamError(
+                "BOOTSTRAP_NOT_READY",
+                "Activation requires all current recorded children and bootstrap acknowledgements",
+            )
+        material.append(
+            {
+                "subtask_id": str(subtask.id),
+                "grant_id": str(grant.id),
+                "physical_epoch": grant.physical_epoch,
+                "launch_attempt_id": str(launch.id),
+                "bootstrap_digest": grant.bootstrap_digest,
+                "ready_operation_id": str(grant.bootstrap_ready_operation_id),
+            }
+        )
+        validate_current_bootstrap_ready(DAGChildScope(scope, subtask, grant, launch))
+    async with session.begin_nested():
+        receipt = await save_operation(
+            session, db, scope, request.operation_id, "ACTIVATE", digest
+        )
+        operation = await session.get(
+            db.StreamDAGLifecycleOperation, request.operation_id
+        )
+        assert operation is not None
+        operation.target_set_digest = dag_digest(material)
+        scope.graph.activation_operation_id = request.operation_id
+        scope.graph.activation_request_digest = digest
+        scope.graph.startup_completed_at = cast(DateTime, now("UTC"))
+        await session.flush()
+    return s.StreamDAGOperationResult(
+        receipt=receipt, execution=await project_execution(session, db, scope)
+    )
+
+
+async def authorize_dag_child_routing(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    context: routed.StreamDAGRouteContext,
+    execution: physical.StreamSubtaskCredentials,
+) -> tuple[DAGChildScope, stream_routes.NativeDAGRouteStore]:
+    child = await lock_dag_child(
+        session,
+        db,
+        execution,
+        subtask_id=context.producer_subtask_id,
+        ready=True,
+        active=True,
+    )
+    plan = await stream_dags.dag_admission_topology_witness(
+        session, db, child.graph.graph
+    )
+    if stream_routes.context_for_subtask(plan, child.subtask.id) != context:
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT",
+            "DAG route context differs from the sealed own producer",
+        )
+    proof = stream_routes.DAGRouteAuthorization(
+        session=session,
+        transaction=session.get_transaction(),
+        context=context,
+        flow_run_id=child.graph.flow.id,
+        task_run_id=child.subtask.task_run_id,
+        generation=child.graph.authority.generation,
+        holder_id=child.graph.authority.holder_id,
+        flow_run_run_count=child.graph.flow.run_count,
+        flow=child.graph.flow,
+        authority=child.graph.authority,
+        graph=child.graph.graph,
+        subtask=child.subtask,
+        plan_bytes=plan.model_dump_json().encode("utf-8"),
+    )
+    return child, stream_routes.NativeDAGRouteStore(session, db, proof)
+
+
+async def open_stream_dag_source(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    request: s.StreamDAGSourceOpenRequest,
+    execution: physical.StreamSubtaskCredentials,
+) -> storage.SourceAdmission:
+    child, store = await authorize_dag_child_routing(
+        session, db, request.context, execution
+    )
+    return await store.claim_source(child.grant.holder_id)
+
+
