+async def append_stream_dag_source(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    request: routed.StreamDAGSourceAppendRequest,
+    execution: stream_routes.RouteCredentials,
+) -> routed.StreamDAGRouteOutcome:
+    if not isinstance(execution, physical.StreamSubtaskCredentials):
+        return await stream_routes.require_dag_route_execution(
+            session, db, request, execution
+        )
+    _, store = await authorize_dag_child_routing(
+        session, db, request.context, execution
+    )
+    stream_routes.validate_route_context(store.authorization.plan, request)
+    return await store.append_source(request)
