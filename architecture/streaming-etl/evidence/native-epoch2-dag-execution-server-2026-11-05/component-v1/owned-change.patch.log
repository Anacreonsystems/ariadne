+async def complete_stream_dag_consumer(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    request: routed.StreamDAGConsumerCompleteRequest,
+    execution: stream_routes.RouteCredentials,
+) -> routed.StreamDAGRouteOutcome:
+    if not isinstance(execution, physical.StreamSubtaskCredentials):
+        return await stream_routes.require_dag_route_execution(
+            session, db, request, execution
+        )
+    _, store = await authorize_dag_child_routing(
+        session, db, request.context, execution
+    )
+    stream_routes.validate_route_context(store.authorization.plan, request)
+    return await store.complete_consumer(request)
+
+
+async def own_stream_status(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    subtask_id: UUID,
+    execution: physical.StreamSubtaskCredentials,
+    *,
+    input_stream: bool,
+) -> storage.StreamInfo:
+    child = await lock_dag_child(
+        session, db, execution, subtask_id=subtask_id, ready=True, active=True
+    )
+    stream_id = (
+        child.subtask.input_stream_id
+        if input_stream
+        else child.subtask.output_stream_id
+    )
+    if stream_id is None:
+        raise NativeStreamError("SUBTASK_SCOPE_DENIED", "A SOURCE has no input stream")
+    row = await session.scalar(
+        sa.select(db.StreamPartition)
+        .where(db.StreamPartition.id == stream_id)
+        .with_for_update(read=True)
+        .execution_options(populate_existing=True)
+    )
+    if row is None or row.flow_run_id != child.graph.flow.id:
+        raise NativeStreamError("IDENTITY_CONFLICT", "Own DAG stream identity differs")
+    return storage.StreamInfo.model_validate(row, from_attributes=True)
+
+
+async def read_stream_dag_input_status(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    subtask_id: UUID,
+    execution: physical.StreamSubtaskCredentials,
+) -> storage.StreamInfo:
+    return await own_stream_status(
+        session, db, subtask_id, execution, input_stream=True
+    )
+
+
+async def read_stream_dag_output_status(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    subtask_id: UUID,
+    execution: physical.StreamSubtaskCredentials,
+) -> storage.StreamInfo:
+    return await own_stream_status(
+        session, db, subtask_id, execution, input_stream=False
+    )
+
+
+async def finish_dag_producer(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    request: s.StreamDAGSourceFinishRequest | s.StreamDAGConsumerFinishRequest,
+    execution: physical.StreamSubtaskCredentials,
+) -> s.StreamDAGProducerFinishReceipt:
+    child, store = await authorize_dag_child_routing(
+        session, db, request.context, execution
+    )
+    source = isinstance(request, s.StreamDAGSourceFinishRequest)
+    action = "source" if source else "consumer"
+    if request.operation_id != uuid5(
+        child.subtask.id, f"prefect-stream-dag-{action}-finish-v1"
+    ):
+        raise NativeStreamError("IDENTITY_CONFLICT", "DAG finish operation differs")
+    task = await store.lock_current_task(allow_final=True)
+    plan = store.authorization.plan
+    outgoing = [
+        edge
+        for edge in plan.edges
+        if edge.producer_operator_uid == request.context.operator_uid
+    ]
+    ids = [
+        row.output_stream_id
+        for row in plan.subtasks
+        if row.operator_uid == request.context.operator_uid
+    ]
+    ids.extend(part.stream_id for edge in outgoing for part in edge.partitions)
+    if child.subtask.input_stream_id is not None:
+        ids.append(child.subtask.input_stream_id)
+    partitions = await store.lock_partitions(ids)
+    output = partitions[child.subtask.output_stream_id]
+    input_sequence: int | None = None
+    source_position: int | None = None
+    if isinstance(request, s.StreamDAGSourceFinishRequest):
+        if child.subtask.input_stream_id is not None:
+            raise NativeStreamError(
+                "SUBTASK_SCOPE_DENIED", "Only a source can finish source production"
+            )
+        store.require_source_owner(task, output, request.binding)
+        if output.producer_position != request.expected_position:
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT",
+                "Source EOF position differs from its accepted prefix",
+            )
+        source_position = request.expected_position
+    else:
+        if child.subtask.input_stream_id is None:
+            raise NativeStreamError(
+                "SUBTASK_SCOPE_DENIED", "A source has no consumer EOF"
+            )
+        consumer = await session.scalar(
+            sa.select(db.StreamConsumer)
+            .where(db.StreamConsumer.id == request.binding.consumer_id)
+            .with_for_update()
+            .execution_options(populate_existing=True)
+        )
+        if consumer is None:
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT", "DAG stable subscriber is missing"
+            )
+        store.require_consumer_owner(task, output, consumer, request.binding)
+        upstream = partitions[child.subtask.input_stream_id]
+        if (
+            consumer.inflight_sequence is not None
+            or upstream.state != "COMPLETED"
+            or consumer.completed_through != upstream.last_sequence
+        ):
+            raise NativeStreamError(
+                "TERMINAL_CONFLICT",
+                "Consumer EOF requires its complete acknowledged input",
+            )
+        input_sequence = consumer.completed_through
+    semantic = {
+        "graph_revision_id": str(child.graph.graph.id),
+        "graph_digest": child.graph.graph.graph_digest,
+        "routing_digest": request.context.routing_digest,
+        "producer_subtask_id": str(child.subtask.id),
+        "producer_stream_id": str(output.id),
+        "kind": "SOURCE_EOF" if source else "CONSUMER_EOF",
+        "accepted_source_position": source_position,
+        "accepted_input_sequence": input_sequence,
+        "tail_sequence": output.last_sequence,
+    }
+    digest = dag_digest(semantic)
+    existing = await session.get(db.StreamDAGLifecycleOperation, request.operation_id)
+    if existing is not None:
+        if (
+            existing.graph_revision_id != child.graph.graph.id
+            or existing.subject_subtask_id != child.subtask.id
+            or existing.kind != ("SOURCE_FINISH" if source else "CONSUMER_FINISH")
+            or existing.request_digest != digest
+        ):
+            raise NativeStreamError("IDENTITY_CONFLICT", "DAG finish replay differs")
+        receipt = s.StreamDAGProducerFinishReceipt.model_validate(
+            existing.accepted_receipt
+        )
+        if (
+            receipt.semantic_digest != digest
+            or receipt.outcome_digest
+            != dag_digest(receipt.model_dump(mode="json", exclude={"outcome_digest"}))
+            or output.state != "COMPLETED"
+            or output.tail_sequence != receipt.tail_sequence
+        ):
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT", "Stored EOF receipt or producer differs"
+            )
+        return receipt
+    async with session.begin_nested():
+        await store.finish_producer()
+        receipt = make_dag_receipt(
+            s.StreamDAGProducerFinishReceipt,
+            {
+                "operation_id": str(request.operation_id),
+                "graph_revision_id": str(child.graph.graph.id),
+                "producer_subtask_id": str(child.subtask.id),
+                "producer_stream_id": str(output.id),
+                "kind": semantic["kind"],
+                "tail_sequence": output.last_sequence,
+                "accepted_source_position": source_position,
+                "accepted_input_sequence": input_sequence,
+                "semantic_digest": digest,
+            },
+        )
+        session.add(
+            db.StreamDAGLifecycleOperation(
+                id=request.operation_id,
+                operation_id=request.operation_id,
+                graph_revision_id=child.graph.graph.id,
+                flow_run_id=child.graph.flow.id,
+                kind="SOURCE_FINISH" if source else "CONSUMER_FINISH",
+                flow_generation=child.graph.authority.generation,
+                flow_holder_id=child.graph.authority.holder_id,
+                flow_run_run_count=child.graph.flow.run_count,
+                request_digest=digest,
+                accepted_receipt=receipt.model_dump(mode="json"),
+                outcome_digest=receipt.outcome_digest,
+                state="COMPLETED",
+                subject_subtask_id=child.subtask.id,
+                completed_at=now("UTC"),
+            )
+        )
+        await session.flush()
+    return receipt
+
+
+async def finish_stream_dag_source(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    request: s.StreamDAGSourceFinishRequest,
+    execution: physical.StreamSubtaskCredentials,
+) -> s.StreamDAGProducerFinishReceipt:
+    return await finish_dag_producer(session, db, request, execution)
+
+
+async def finish_stream_dag_consumer(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    request: s.StreamDAGConsumerFinishRequest,
+    execution: physical.StreamSubtaskCredentials,
+) -> s.StreamDAGProducerFinishReceipt:
+    return await finish_dag_producer(session, db, request, execution)
+
+
+async def terminate_controlled_task(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    scope: DAGGraphScope,
+    control: orm_models.StreamDAGLifecycleOperation,
+    task: orm_models.TaskRun,
+) -> None:
+    """A verified stopped target reaches terminal state through normal policy."""
+    if task.state_type in {
+        StateType.COMPLETED,
+        StateType.FAILED,
+        StateType.CRASHED,
+        StateType.CANCELLED,
+    }:
+        return
+    proposed = (
+        states.Cancelled(message="Streaming DAG cancellation completed")
+        if control.effective_control_kind == "CANCEL"
+        else states.Failed(
+            message="Streaming DAG execution was stopped",
+            state_details=states.StateDetails(retriable=False),
+        )
+    )
+    with dag_lifecycle_control(session, scope.graph, control.id, task_run_id=task.id):
+        await guard_task_lifecycle(session, db, task.id, None, proposed, force=False)
+        result = await task_run_models.set_task_run_state(
+            session=session,
+            task_run_id=task.id,
+            state=proposed,
+            force=False,
+            task_policy=CoreTaskPolicy,
+        )
+    if (
+        result.status != SetStateStatus.ACCEPT
+        or result.state is None
+        or not result.state.is_final()
+    ):
+        raise NativeStreamError(
+            "TERMINAL_CONFLICT", "DAG target terminal state was refused"
+        )
+
+
+async def finalize_stopped_dag_control(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    scope: DAGGraphScope,
+    control: orm_models.StreamDAGLifecycleOperation,
+) -> None:
+    """The last exact STOP owns graph/data cleanup and terminal Flow authority."""
+    scope.validate(session, update=True)
+    graph = scope.graph
+    targets = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamDAGControlTarget)
+                .where(db.StreamDAGControlTarget.control_operation_id == control.id)
+                .order_by(db.StreamDAGControlTarget.subtask_id)
+                .with_for_update()
+            )
+        ).all()
+    )
+    plan = await stream_dags.dag_admission_topology_witness(session, db, graph)
+    if {row.subtask_id for row in targets} != {row.id for row in plan.subtasks}:
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "DAG control target set is incomplete"
+        )
+    if any(row.state != "STOPPED" for row in targets):
+        return
+    slots = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamPhysicalSlotAllocation)
+                .where(db.StreamPhysicalSlotAllocation.graph_revision_id == graph.id)
+                .order_by(db.StreamPhysicalSlotAllocation.subtask_id)
+                .with_for_update()
+            )
+        ).all()
+    )
+    if {row.subtask_id for row in slots} != {row.id for row in plan.subtasks} or any(
+        not row.released for row in slots
+    ):
+        raise NativeStreamError(
+            "PHYSICAL_STOP_REQUIRED", "DAG physical reservations remain held"
+        )
+    stream_ids = {row.output_stream_id for row in plan.subtasks} | {
+        part.stream_id for edge in plan.edges for part in edge.partitions
+    }
+    partitions = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamPartition)
+                .where(db.StreamPartition.flow_run_id == scope.flow.id)
+                .order_by(db.StreamPartition.id)
+                .with_for_update()
+                .execution_options(populate_existing=True)
+            )
+        ).all()
+    )
+    if {row.id for row in partitions} != stream_ids:
+        raise NativeStreamError("IDENTITY_CONFLICT", "DAG cleanup stream set differs")
+    task_ids = {row.manifest.task_run_id for row in plan.subtasks}
+    tasks = list(
+        (
+            await session.scalars(
+                sa.select(db.TaskRun)
+                .where(db.TaskRun.flow_run_id == scope.flow.id)
+                .order_by(db.TaskRun.id)
+                .with_for_update()
+                .execution_options(populate_existing=True)
+            )
+        ).all()
+    )
+    if {row.id for row in tasks} != task_ids or any(
+        row.state_type
+        not in {
+            StateType.COMPLETED,
+            StateType.FAILED,
+            StateType.CRASHED,
+            StateType.CANCELLED,
+        }
+        for row in tasks
+    ):
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "DAG cleanup requires the exact terminal TaskRun set"
+        )
+    summary = {
+        "graph_revision_id": str(graph.id),
+        "control_operation_id": str(control.id),
+        "terminal_state": "CANCELLED"
+        if control.effective_control_kind == "CANCEL"
+        else "FAILED",
+        "total": len(targets),
+        "stopped": len(targets),
+        "record_count": sum(row.record_count for row in partitions),
+        "byte_count": sum(row.byte_count for row in partitions),
+        "all_targets_stopped_digest": dag_digest(
+            [
+                {
+                    "subtask_id": str(row.subtask_id),
+                    "all_attempts_closed_digest": row.all_attempts_closed_digest,
+                }
+                for row in targets
+            ]
+        ),
+    }
+    for partition in partitions:
+        if partition.state == "OPEN":
+            finish_stream_partition(partition, "Streaming DAG execution was stopped")
+    # Only the input-REFERENCE receipt FK is deferred. Keep all immediate
+    # PAYLOAD/receipt pins intact until their dependants have been removed.
+    await session.execute(
+        sa.delete(db.StreamRecord).where(
+            db.StreamRecord.stream_id.in_(stream_ids),
+            db.StreamRecord.record_kind == "REFERENCE",
+        )
+    )
+    consumer_ids = sa.select(db.StreamConsumer.id).where(
+        db.StreamConsumer.graph_revision_id == graph.id
+    )
+    await session.execute(
+        sa.delete(db.StreamCompletion).where(
+            db.StreamCompletion.consumer_id.in_(consumer_ids)
+        )
+    )
+    await session.execute(
+        sa.delete(db.StreamRouteReceipt).where(
+            db.StreamRouteReceipt.graph_revision_id == graph.id
+        )
+    )
+    await session.execute(
+        sa.delete(db.StreamConsumer).where(
+            db.StreamConsumer.graph_revision_id == graph.id
+        )
+    )
+    await session.execute(
+        sa.delete(db.StreamRecord).where(db.StreamRecord.stream_id.in_(stream_ids))
+    )
+    await release_allocations(session, db, [row.id for row in plan.subtasks])
+    released_at = cast(DateTime, now("UTC"))
+    for partition in partitions:
+        partition.released = True
+        partition.record_count = 0
+        partition.byte_count = 0
+    manifests = (
+        await session.scalars(
+            sa.select(db.StreamSubmission).where(
+                db.StreamSubmission.graph_revision_id == graph.id
+            )
+        )
+    ).all()
+    for manifest in manifests:
+        manifest.state = "RELEASED"
+        manifest.released_at = released_at
+    if graph.startup_completed_at is None:
+        graph.abort_operation_id = control.id
+        graph.abort_request_digest = control.request_digest
+        graph.abort_error = "Streaming DAG execution was stopped"
+    graph.state = "RELEASED"
+    terminal_id = uuid5(graph.id, "prefect-stream-dag-finalize-v1")
+    terminal = db.StreamDAGLifecycleOperation(
+        id=terminal_id,
+        operation_id=terminal_id,
+        graph_revision_id=graph.id,
+        flow_run_id=scope.flow.id,
+        kind="FINALIZE",
+        flow_generation=scope.authority.generation,
+        flow_holder_id=scope.authority.holder_id,
+        flow_run_run_count=scope.flow.run_count,
+        request_digest=dag_digest(summary),
+        accepted_receipt=summary,
+        outcome_digest=dag_digest(summary),
+        state="COMPLETED",
+        effective_control_kind=control.effective_control_kind,
+        control_operation_id=control.id,
+        terminal_state=summary["terminal_state"],
+        terminal_outcome=summary,
+        completed_at=released_at,
+    )
+    session.add(terminal)
+    await session.flush()
+
+    graph.terminal_operation_id = terminal.id
+    control.state = "COMPLETED"
+    control.completed_at = released_at
+    proposed = (
+        states.Cancelled(message="Streaming DAG cancellation completed")
+        if control.effective_control_kind == "CANCEL"
+        else states.Failed(
+            message="Streaming DAG execution failed",
+            state_details=states.StateDetails(retriable=False),
+        )
+    )
+    with dag_lifecycle_control(session, graph, control.id):
+        authority = await guard_flow_lifecycle(
+            session, db, scope.flow.id, None, proposed, force=False
+        )
+        result = await flow_run_models.set_flow_run_state(
+            session=session,
+            flow_run_id=scope.flow.id,
+            state=proposed,
+            force=False,
+            flow_policy=CoreFlowPolicy,
+        )
+        if (
+            result.status != SetStateStatus.ACCEPT
+            or result.state is None
+            or not result.state.is_final()
+        ):
+            raise NativeStreamError(
+                "TERMINAL_CONFLICT", "Final DAG Flow state was refused"
+            )
+        await apply_flow_lifecycle_result(session, db, authority, result.state)
+    scope.authority.state = "RELEASED"
+    snapshot = await session.scalar(
+        sa.select(db.NativeStreamDeploymentSnapshot).where(
+            db.NativeStreamDeploymentSnapshot.flow_run_id == scope.flow.id
+        )
+    )
+    if snapshot is not None:
+        snapshot.state = "RELEASED"
+    await session.flush()
+
+
+async def finalize_completed_dag(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    scope: DAGGraphScope,
+) -> None:
+    """Normal graph completion preserves the Running parent for plain Python."""
+    scope.validate(session, update=True)
+    graph = scope.graph
+    if graph.current_control_operation_id is not None:
+        raise NativeStreamError(
+            "CONTROL_CONFLICT", "A graph control owns terminal cleanup"
+        )
+    if graph.terminal_operation_id is not None:
+        return
+    if graph.startup_completed_at is None:
+        raise NativeStreamError(
+            "ACTIVATION_NOT_READY", "Unactivated DAG cannot complete normally"
+        )
+    plan = await stream_dags.dag_admission_topology_witness(session, db, graph)
+    slots = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamPhysicalSlotAllocation)
+                .where(db.StreamPhysicalSlotAllocation.graph_revision_id == graph.id)
+                .order_by(db.StreamPhysicalSlotAllocation.subtask_id)
+                .with_for_update()
+            )
+        ).all()
+    )
+    if {row.subtask_id for row in slots} != {row.id for row in plan.subtasks}:
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "Normal DAG completion reservation set differs"
+        )
+    if any(not row.released for row in slots):
+        return
+    tasks = list(
+        (
+            await session.scalars(
+                sa.select(db.TaskRun)
+                .where(db.TaskRun.flow_run_id == scope.flow.id)
+                .order_by(db.TaskRun.id)
+                .with_for_update()
+                .execution_options(populate_existing=True)
+            )
+        ).all()
+    )
+    if {row.id for row in tasks} != {
+        row.manifest.task_run_id for row in plan.subtasks
+    } or any(row.state_type != StateType.COMPLETED for row in tasks):
+        raise NativeStreamError(
+            "TERMINAL_CONFLICT",
+            "Normal graph completion needs every exact Completed TaskRun",
+        )
+    subtask_rows = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamPhysicalSubtask).where(
+                    db.StreamPhysicalSubtask.graph_revision_id == graph.id
+                )
+            )
+        ).all()
+    )
+    retired = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamSubtaskReplacement).where(
+                    db.StreamSubtaskReplacement.subtask_id.in_(
+                        [row.id for row in subtask_rows]
+                    ),
+                    db.StreamSubtaskReplacement.state == "RETIRED",
+                )
+            )
+        ).all()
+    )
+    retirement_by_subtask = {row.subtask_id: row for row in retired}
+    by_slot = {row.subtask_id: row for row in slots}
+    closed_targets: list[dict[str, Any]] = []
+    for subtask in sorted(subtask_rows, key=lambda row: row.id):
+        operation = retirement_by_subtask.get(subtask.id)
+        envelope = operation.retirement_outcome if operation else None
+        if (
+            envelope is None
+            or operation is None
+            or envelope.get("all_attempts_closed_digest") is None
+        ):
+            raise NativeStreamError(
+                "PHYSICAL_STOP_REQUIRED",
+                "Normal completion lacks a durable complete launch closure",
+            )
+        receipt = physical.StreamSubtaskVerifiedRetirement.model_validate(
+            envelope.get("receipt")
+        )
+        if (
+            receipt.task_state != "COMPLETED"
+            or receipt.grant_id != subtask.current_grant_id
+            or receipt.physical_epoch != subtask.physical_epoch
+            or receipt.task_run_id != subtask.task_run_id
+            or by_slot[subtask.id].release_operation_id != operation.operation_id
+        ):
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT",
+                "Normal retirement scope differs from its physical reservation",
+            )
+        closed_targets.append(
+            {
+                "subtask_id": str(subtask.id),
+                "all_attempts_closed_digest": envelope["all_attempts_closed_digest"],
+            }
+        )
+    stream_ids = {row.output_stream_id for row in plan.subtasks} | {
+        part.stream_id for edge in plan.edges for part in edge.partitions
+    }
+    partitions = list(
+        (
+            await session.scalars(
+                sa.select(db.StreamPartition)
+                .where(db.StreamPartition.flow_run_id == scope.flow.id)
+                .order_by(db.StreamPartition.id)
+                .with_for_update()
+                .execution_options(populate_existing=True)
+            )
+        ).all()
+    )
+    if {row.id for row in partitions} != stream_ids or any(
+        row.state != "COMPLETED" for row in partitions
+    ):
+        raise NativeStreamError(
+            "TERMINAL_CONFLICT",
+            "Normal completion requires all producer and input EOFs",
+        )
+    summary = {
+        "graph_revision_id": str(graph.id),
+        "terminal_state": "COMPLETED",
+        "total": len(tasks),
+        "stopped": len(tasks),
+        "record_count": sum(row.record_count for row in partitions),
+        "byte_count": sum(row.byte_count for row in partitions),
+        "all_targets_stopped_digest": dag_digest(closed_targets),
+    }
+    await session.execute(
+        sa.delete(db.StreamRecord).where(
+            db.StreamRecord.stream_id.in_(stream_ids),
+            db.StreamRecord.record_kind == "REFERENCE",
+        )
+    )
+    consumer_ids = sa.select(db.StreamConsumer.id).where(
+        db.StreamConsumer.graph_revision_id == graph.id
+    )
+    await session.execute(
+        sa.delete(db.StreamCompletion).where(
+            db.StreamCompletion.consumer_id.in_(consumer_ids)
+        )
+    )
+    await session.execute(
+        sa.delete(db.StreamRouteReceipt).where(
+            db.StreamRouteReceipt.graph_revision_id == graph.id
+        )
+    )
+    await session.execute(
+        sa.delete(db.StreamConsumer).where(
+            db.StreamConsumer.graph_revision_id == graph.id
+        )
+    )
+    await session.execute(
+        sa.delete(db.StreamRecord).where(db.StreamRecord.stream_id.in_(stream_ids))
+    )
+    await release_allocations(session, db, [row.id for row in plan.subtasks])
+    completed_at = cast(DateTime, now("UTC"))
+    for row in partitions:
+        row.released = True
+        row.record_count = 0
+        row.byte_count = 0
+    for manifest in (
+        await session.scalars(
+            sa.select(db.StreamSubmission).where(
+                db.StreamSubmission.graph_revision_id == graph.id
+            )
+        )
+    ).all():
+        manifest.state = "RELEASED"
+        manifest.released_at = completed_at
+    terminal_id = uuid5(graph.id, "prefect-stream-dag-finalize-v1")
+    session.add(
+        db.StreamDAGLifecycleOperation(
+            id=terminal_id,
+            operation_id=terminal_id,
+            graph_revision_id=graph.id,
+            flow_run_id=scope.flow.id,
+            kind="FINALIZE",
+            flow_generation=scope.authority.generation,
+            flow_holder_id=scope.authority.holder_id,
+            flow_run_run_count=scope.flow.run_count,
+            request_digest=dag_digest(summary),
+            accepted_receipt=summary,
+            outcome_digest=dag_digest(summary),
+            state="COMPLETED",
+            terminal_state="COMPLETED",
+            terminal_outcome=summary,
+            completed_at=completed_at,
+        )
+    )
+    await session.flush()
+    graph.terminal_operation_id = terminal_id
+    graph.state = "RELEASED"
+    await session.flush()
+
+
+async def record_dag_failed_task_event(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph: orm_models.StreamGraphRevision,
+    subtask: orm_models.StreamPhysicalSubtask,
+    event_id: UUID,
+) -> None:
+    """A validated signed final Task failure closes output and joins control."""
+    task = await session.get(db.TaskRun, subtask.task_run_id, populate_existing=True)
+    flow = await session.get(db.FlowRun, graph.flow_run_id)
+    authority = await session.scalar(
+        sa.select(db.StreamExecutionAuthority).where(
+            db.StreamExecutionAuthority.flow_run_id == graph.flow_run_id
+        )
+    )
+    if (
+        task is None
+        or flow is None
+        or authority is None
+        or task.state_id != event_id
+        or task.state_type is None
+        or task.state_type not in {StateType.FAILED, StateType.CRASHED}
+    ):
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "Signed final Task failure scope differs"
+        )
+    if task.run_count < (task.empirical_policy.retries or 0) + 1 and (
+        task.state is None or task.state.state_details.retriable is not False
+    ):
+        raise NativeStreamError(
+            "TERMINAL_CONFLICT", "A retriable Task failure cannot stop the DAG"
+        )
+    scope = DAGGraphScope(
+        session, session.get_transaction(), flow, authority, graph, True
+    )
+    existing_control = (
+        await session.get(
+            db.StreamDAGLifecycleOperation, graph.current_control_operation_id
+        )
+        if graph.current_control_operation_id
+        else None
+    )
+    control = (
+        existing_control
+        if existing_control is not None
+        and existing_control.effective_control_kind == "CANCEL"
+        else await begin_dag_control(
+            session,
+            db,
+            scope,
+            "FAIL",
+            {
+                "kind": "SIGNED_TASK_FAILURE",
+                "subtask_id": str(subtask.id),
+                "task_run_id": str(task.id),
+                "event_id": str(event_id),
+            },
+        )
+    )
+    operation_id = uuid5(
+        graph.id, "prefect-stream-dag-task-failure-v1/" + str(event_id)
+    )
+    material = {
+        "event_id": str(event_id),
+        "subtask_id": str(subtask.id),
+        "task_run_id": str(task.id),
+        "run_count": task.run_count,
+        "state_type": task.state_type.value,
+        "control_operation_id": str(control.id),
+    }
+    digest = dag_digest(material)
+    previous = await session.get(db.StreamDAGLifecycleOperation, operation_id)
+    if previous is not None:
+        if previous.request_digest != digest or previous.source_event_id != event_id:
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT", "Signed failure journal replay differs"
+            )
+        return
+    plan = await stream_dags.dag_admission_topology_witness(session, db, graph)
+    own = next(row for row in plan.subtasks if row.id == subtask.id)
+    contributors = [
+        row for row in plan.subtasks if row.operator_uid == own.operator_uid
+    ]
+    outgoing = [
+        edge for edge in plan.edges if edge.producer_operator_uid == own.operator_uid
+    ]
+    ids = {row.output_stream_id for row in contributors} | {
+        part.stream_id for edge in outgoing for part in edge.partitions
+    }
+    partitions = {
+        row.id: row
+        for row in (
+            await session.scalars(
+                sa.select(db.StreamPartition)
+                .where(db.StreamPartition.id.in_(ids))
+                .order_by(db.StreamPartition.id)
+                .with_for_update()
+                .execution_options(populate_existing=True)
+            )
+        ).all()
+    }
+    if set(partitions) != ids:
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "Signed failure producer/edge set differs"
+        )
+    output = partitions[subtask.output_stream_id]
+    if output.state == "OPEN":
+        finish_stream_partition(
+            output, "A signed TaskRun failure stopped this producer"
+        )
+    elif output.state != "FAILED":
+        raise NativeStreamError(
+            "TERMINAL_CONFLICT", "Completed producer cannot report a failed TaskRun"
+        )
+    for edge in outgoing:
+        for part in edge.partitions:
+            required = [
+                row
+                for row in contributors
+                if edge.exchange != "forward"
+                or row.subtask_index == part.partition_index
+            ]
+            current = [partitions[row.output_stream_id].state for row in required]
+            if required and all(state in {"COMPLETED", "FAILED"} for state in current):
+                target = partitions[part.stream_id]
+                if target.state == "OPEN":
+                    finish_stream_partition(
+                        target,
+                        "A sealed upstream producer failed"
+                        if "FAILED" in current
+                        else None,
+                    )
+    session.add(
+        db.StreamDAGLifecycleOperation(
+            id=operation_id,
+            operation_id=operation_id,
+            graph_revision_id=graph.id,
+            flow_run_id=flow.id,
+            kind="TASK_FAILURE",
+            flow_generation=authority.generation,
+            flow_holder_id=authority.holder_id,
+            flow_run_run_count=flow.run_count,
+            request_digest=digest,
+            accepted_receipt=material,
+            outcome_digest=digest,
+            state="ACCEPTED",
+            effective_control_kind=control.effective_control_kind,
+            control_operation_id=control.id,
+            subject_subtask_id=subtask.id,
+            source_event_id=event_id,
+            source_task_state_id=task.state_id,
+        )
+    )
+    await session.flush()
+
+
+async def request_dag_flow_cancellation(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph_id: UUID,
+    proposed_state: states.State,
+) -> orm_models.StreamExecutionAuthority:
+    """Trusted generic Flow cancellation commits DAG control before kill.
+
+    This is called only by the existing platform Flow lifecycle guard. An
+    admitted region first exposes CANCELLING; only the last verified STOP may
+    commit Cancelled. No child or runtime signal can manufacture this authority.
+    """
+    scope = await lock_dag_graph(session, db, graph_id, None, update=True, worker=True)
+    graph = scope.graph
+    if graph.terminal_operation_id is not None:
+        terminal = await session.get(
+            db.StreamDAGLifecycleOperation, graph.terminal_operation_id
+        )
+        if (
+            terminal is None
+            or terminal.kind != "FINALIZE"
+            or terminal.terminal_state != "COMPLETED"
+            or graph.current_control_operation_id is not None
+        ):
+            raise NativeStreamError(
+                "TERMINAL_CONFLICT", "DAG lifetime already has its terminal control"
+            )
+        # The completed DAG is clean; ordinary parent Python remains cancellable.
+        return scope.authority
+    if graph.admission_operation_id is None:
+        control = await begin_dag_control(
+            session, db, scope, "PREVIEW_ABORT", {"kind": "PLATFORM_CANCEL"}
+        )
+        await finalize_preview(session, db, scope, control)
+        proposed_state.type = StateType.CANCELLED
+        proposed_state.name = "Cancelled"
+        return scope.authority
+    await begin_dag_control(session, db, scope, "CANCEL", {"kind": "PLATFORM_CANCEL"})
+    proposed_state.type = StateType.CANCELLING
+    proposed_state.name = "Cancelling"
+    await session.flush()
+    return scope.authority
