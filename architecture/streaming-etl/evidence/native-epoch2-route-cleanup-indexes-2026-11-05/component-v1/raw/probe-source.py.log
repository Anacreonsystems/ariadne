"""Temporary isolated experiment; not a product acceptance test."""

import asyncio
import hashlib
import json
import time
from pathlib import Path
from uuid import uuid4

import pytest
import sqlalchemy as sa

from tests.server.database.test_stream_route_migrations import ddl_chain

pytestmark = [pytest.mark.clear_db, pytest.mark.service("database")]
OUT = Path("/tmp/native-5000-fk-index-proof-v1")
INDEXES = {
    "ix_stream_record__payload_record_id": ("stream_record", "payload_record_id"),
    "ix_stream_record__route_receipt_id": ("stream_record", "route_receipt_id"),
    "ix_stream_route_receipt__input_payload_record_id": ("stream_route_receipt", "input_payload_record_id"),
    "ix_stream_route_receipt__input_reference_record_id": ("stream_route_receipt", "input_reference_record_id"),
}


async def test_seeded_5000_cleanup_causality_postgres(db, flow_run):
    OUT.mkdir(exist_ok=True)
    chain = await ddl_chain(db, flow_run.id)
    models = [db.StreamRecord, db.StreamRouteReceipt, db.StreamCompletion]
    async with db.session_context(begin_transaction=True) as session:
        templates = {
            model.__tablename__: [dict(row) for row in (await session.execute(sa.select(model.__table__))).mappings()]
            for model in models
        }
        payloads, refs, receipts, completions = [], [], [], []
        for position in range(2, 5001):
            remap = {row["id"]: uuid4() for rows in templates.values() for row in rows}

            def translate(value):
                if isinstance(value, dict):
                    return {key: position if key in {"sequence", "producer_position", "producer_sequence", "input_sequence"} and item is not None else translate(item) for key, item in value.items()}
                if isinstance(value, list):
                    return [translate(item) for item in value]
                if isinstance(value, str):
                    return next((str(new) for old, new in remap.items() if str(old) == value), value)
                return value

            semantic = {}
            for row in templates["stream_route_receipt"]:
                semantic[row["id"]] = hashlib.sha256(f"{row['semantic_digest']}:{position}".encode()).hexdigest()
            for row in templates["stream_record"]:
                copy = {key: remap.get(value, value) if key in {"id", "payload_record_id", "route_receipt_id"} else value for key, value in row.items()}
                copy.update(sequence=position, producer_position=position)
                (payloads if row["record_kind"] == "PAYLOAD" else refs).append(copy)
            for row in templates["stream_route_receipt"]:
                copy = {key: remap.get(value, value) if key in {"id", "payload_record_id", "input_reference_record_id", "input_payload_record_id"} else value for key, value in row.items()}
                copy.update(producer_position=position, producer_sequence=position, input_sequence=position if row["consumer_id"] else None, semantic_digest=semantic[row["id"]])
                copy["outcome"] = translate(row["outcome"])
                copy["outcome"]["semantic_digest"] = copy["semantic_digest"]
                material = {key: value for key, value in copy["outcome"].items() if key != "outcome_digest"}
                copy["outcome_digest"] = hashlib.sha256(json.dumps(material, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()).hexdigest()
                copy["outcome"]["outcome_digest"] = copy["outcome_digest"]
                copy["outcome_size"] = len(json.dumps(copy["outcome"], sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode())
                receipts.append(copy)
            for row in templates["stream_completion"]:
                copy = dict(row)
                copy.update(id=remap[row["id"]], route_receipt_id=remap[row["route_receipt_id"]], delivery_id=uuid4(), input_sequence=position, output_sequence=position, intent_digest=semantic[row["route_receipt_id"]])
                completions.append(copy)
        for model, rows in [(db.StreamRecord, payloads), (db.StreamRouteReceipt, receipts), (db.StreamRecord, refs), (db.StreamCompletion, completions)]:
            for start in range(0, len(rows), 500):
                await session.execute(sa.insert(model.__table__), rows[start:start+500])
        await session.execute(sa.update(db.StreamConsumer).values(completed_through=5000))
        await session.execute(sa.text("UPDATE stream_partition p SET last_sequence=5000, producer_position=5000, record_count=5000, byte_count=(SELECT SUM(size_bytes) FROM stream_record r WHERE r.stream_id=p.id)"))
    async with db.session_context() as session:
        counts = {model.__tablename__: await session.scalar(sa.select(sa.func.count()).select_from(model)) for model in models}
        assert counts == {"stream_record": 35000, "stream_route_receipt": 20000, "stream_completion": 15000}
        await session.execute(sa.text("ANALYZE stream_record"))
        await session.execute(sa.text("ANALYZE stream_route_receipt"))
        await session.execute(sa.text("ANALYZE stream_completion"))
    report = {"counts": counts, "shape": "four-stage DDL-valid three-hop chain, 5000 per producer; no route service/runtime claim", "indexes": INDEXES}
    stream_ids = {row.output_stream_id for row in chain.plan.subtasks} | {part.stream_id for edge in chain.plan.edges for part in edge.partitions}
    deletes = [
        sa.delete(db.StreamRecord).where(db.StreamRecord.stream_id.in_(stream_ids), db.StreamRecord.record_kind == "REFERENCE"),
        sa.delete(db.StreamCompletion).where(db.StreamCompletion.consumer_id.in_(sa.select(db.StreamConsumer.id).where(db.StreamConsumer.graph_revision_id == chain.plan.id))),
        sa.delete(db.StreamRouteReceipt).where(db.StreamRouteReceipt.graph_revision_id == chain.plan.id),
        sa.delete(db.StreamConsumer).where(db.StreamConsumer.graph_revision_id == chain.plan.id),
        sa.delete(db.StreamRecord).where(db.StreamRecord.stream_id.in_(stream_ids)),
    ]

    async def measure(label, commit):
        async with db.session_context() as session:
            await session.begin()
            await session.execute(sa.select(db.FlowRun.id).where(db.FlowRun.id == flow_run.id).with_for_update())
            await session.execute(sa.select(db.StreamGraphRevision.id).where(db.StreamGraphRevision.id == chain.plan.id).with_for_update())
            result = {"statement_seconds": [], "sql": []}
            start = time.monotonic()
            try:
                for statement in deletes:
                    sql = str(statement.compile(dialect=db.dialect(), compile_kwargs={"literal_binds": True}))
                    result["sql"].append(sql)
                    tick = time.monotonic()
                    plan = (await session.execute(sa.text("EXPLAIN (ANALYZE, BUFFERS, FORMAT JSON) " + sql))).scalar_one()
                    result["statement_seconds"].append(time.monotonic() - tick)
                    (OUT/f"{label}-statement-{len(result['sql'])}.json").write_text(json.dumps(plan, indent=2, default=str))
                tick = time.monotonic()
                if commit:
                    await session.commit()
                else:
                    await session.rollback()
                result["commit_or_rollback_seconds"] = time.monotonic() - tick
                result["status"] = "PASS"
            except Exception as exc:
                result["status"] = "ERROR"
                result["exception"] = type(exc).__name__
                result["exception_text"] = str(exc)
                await session.rollback()
            result["total_seconds"] = time.monotonic() - start
            report[label] = result
            (OUT/"report.json").write_text(json.dumps(report, indent=2, default=str))

    await measure("baseline", False)
    async with db.session_context(begin_transaction=True) as session:
        for name, (table, column) in INDEXES.items():
            await session.execute(sa.text(f"CREATE INDEX {name} ON {table} ({column})"))
    await measure("indexed_rollback", False)
    await measure("indexed_commit", True)
    assert report["indexed_commit"]["status"] == "PASS", report
    assert report["indexed_commit"]["total_seconds"] < 10, report
    print(json.dumps(report, indent=2, default=str))
