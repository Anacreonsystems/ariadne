+                        producer_position=1,
+                        value=None,
+                        value_digest=hashlib.sha256(b"null").hexdigest(),
+                        size_bytes=4,
+                    )
+                )
+    baseline = await data_snapshot(db)
+    async with _isolated_postgres_schema_changes(db, database_engine):
+        await database_engine.dispose()
