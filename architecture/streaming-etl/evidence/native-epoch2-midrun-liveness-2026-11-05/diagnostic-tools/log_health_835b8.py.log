   if '/streams/v1/deployments/replacements/candidates' in line:discovery.update(http.findall(line))
  files.append({'path':str(p.relative_to(t)),'captured_prefix_bytes':len(raw),'captured_prefix_sha256':hashlib.sha256(raw).hexdigest(),'http_statuses':dict(sorted(statuses.items())),'http_5xx_lines':sum(n for code,n in statuses.items() if code.startswith('5')),'recovery_discovery_statuses':dict(sorted(discovery.items())),'recovery_deferred_warning_messages':normalized.count('Native recovery discovery is temporarily unavailable'),'recovery_run_exception_messages':normalized.count('Native recovery could not complete for flow run'),'traceback_headers':text.count('Traceback (most recent call last)'),'exception_group_traceback_headers':text.count('Exception Group Traceback'),'timeout_error_mentions':text.count('TimeoutError'),'deadlock_detected_mentions':text.lower().count('deadlock detected'),'error_level_lines':len(re.findall(r'^.*\bERROR\b.*$',text,re.M))})
 p=t/'db-observations.jsonl';last=None
 if p.exists():
  with p.open('rb') as f:f.seek(max(0,p.stat().st_size-131072));raw=f.read()
  for line in raw.splitlines()[-4:]:
   try:last=json.loads(line)
   except (ValueError,UnicodeDecodeError):pass
 tasks=[]
 if last:
  tasks=[{k:x[k] for k in ['operator_uid','subtask_index','task_run_id','run_count','physical_epoch','state_type']} for x in last['snapshot']['subtasks']]
 rows.append({'trial':t.name,'files':files,'task_run_counts':tasks,'qualification':'Counts per log prefix are not deduplicated incident counts; raw private contents never printed. Logs may keep growing after this snapshot.'})
r={'schema':'ariadne-native-log-health-observation-v1','utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'head':subprocess.check_output(['git','rev-parse','HEAD'],cwd='/workspace/ariadne',text=True).strip(),'lease_sha256':hashlib.sha256((BASE/'lease.json').read_bytes()).hexdigest(),'cases':rows,'scope':'Actual own API/worker logs and read-only task metadata; verification observation, not a final gate. No source/product/timeout mutations.'}
p=BASE/('log-health-'+str(time.monotonic_ns())+'.json');p.write_text(json.dumps(r,indent=2,sort_keys=True)+'\n');p.chmod(0o600)
