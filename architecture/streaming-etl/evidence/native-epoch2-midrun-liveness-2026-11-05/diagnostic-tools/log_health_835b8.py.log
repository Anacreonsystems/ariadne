for row in rows:
 summary.append({'trial':row['trial'],'logs':len(row['files']),'http5xx':sum(x['http_5xx_lines'] for x in row['files']),'worker_deferred_5xx':sum(x['recovery_deferred_warning_messages'] for x in row['files']),'recovery_exception_messages':sum(x['recovery_run_exception_messages'] for x in row['files']),'tracebacks':sum(x['traceback_headers']+x['exception_group_traceback_headers'] for x in row['files']),'timeouts':sum(x['timeout_error_mentions'] for x in row['files']),'deadlocks':sum(x['deadlock_detected_mentions'] for x in row['files']),'error_lines':sum(x['error_level_lines'] for x in row['files']),'task_run_counts':row['task_run_counts']})
print(json.dumps({'receipt':str(p),'sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'summary':summary},sort_keys=True))
