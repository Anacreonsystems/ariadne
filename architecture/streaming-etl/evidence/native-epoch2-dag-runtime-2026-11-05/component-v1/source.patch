+        operator_uid=uid,
+        partitions=(StreamPartitionCall(parameters={}),) * count,
+        input=StreamInput(
+            port=StreamPort(input_uid),
+            upstream=upstream.output("out"),
+            edge_uid=edge_uid or f"A-{uid}",
+            subscriber_uid=subscriber_uid or f"subscriber-{uid}",
