+                    "role": operator["role"],
+                    "parallelism": operator["parallelism"],
+                    "task_name": task["task_name"],
+                    "task_key": task["task_key"],
+                    "task_version": task["task_version"],
+                    "artifact_digest": task["artifact_digest"],
+                    "entrypoint": task["entrypoint"],
