+        for edge in plan.edges
+        if edge.producer_operator_uid == operator.operator_uid
+    )
+    if (
+        operator.operator_uid != context.operator_uid
+        or operator.output_port.uid != context.output_port_uid
+        or subtask.subtask_index != context.subtask_index
+        or keyed != context.has_keyed_outgoing
+    ):
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "Route operator, port, index or key witness differs"
+        )
+    if isinstance(request, s.StreamDAGSourceAppendRequest):
+        if (
+            operator.role != "SOURCE"
+            or subtask.manifest.task_run_id != request.binding.task_run_id
+            or subtask.output_stream_id != request.binding.stream_id
+        ):
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT", "Source binding is outside its exact DAG subtask"
+            )
+    else:
+        edge_partition = next(
+            (
+                part
+                for edge in plan.edges
+                for part in edge.partitions
+                if part.target_subtask_id == subtask.id
+            ),
+            None,
+        )
+        if (
+            operator.role != "OPERATOR"
+            or edge_partition is None
+            or edge_partition.subscriber_id != request.binding.consumer_id
+            or subtask.input_stream_id != request.binding.input_stream_id
+            or subtask.output_stream_id != request.binding.output_stream_id
+        ):
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT",
+                "Consumer binding is outside its stable DAG subscriber",
+            )
+    return subtask
+
+
+async def require_dag_route_execution(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    request: RouteRequest,
+    execution: RouteCredentials,
+) -> NoReturn:
+    """Authenticate current callers before the common NI2-012 execution fence."""
+    if isinstance(execution, StreamSubtaskCredentials):
+        await require_subtask(
+            session,
+            db,
+            execution,
+            subtask_id=request.context.producer_subtask_id,
+            flow_run_id=request.binding.flow_run_id,
+        )
+    else:
+        plan = await stream_dags.read_dag_plan(
+            session, db, request.context.graph_revision_id, execution
+        )
+        validate_route_context(plan, request)
+    raise NativeStreamError(
+        "EXECUTION_PROFILE_NOT_READY",
+        "DAG routed execution is unavailable until NI2-012",
+    )
+
+
+@dataclass(frozen=True)
+class DAGRouteAuthorization:
+    """Internal transaction-local proof, never accepted by an HTTP handler."""
+
+    session: AsyncSession = field(repr=False)
+    transaction: object = field(repr=False)
+    context: s.StreamDAGRouteContext
+    flow_run_id: UUID
+    task_run_id: UUID
+    generation: int
+    holder_id: UUID
+    flow_run_run_count: int
+    flow: orm_models.FlowRun = field(repr=False)
+    authority: orm_models.StreamExecutionAuthority = field(repr=False)
+    graph: orm_models.StreamGraphRevision = field(repr=False)
+    subtask: orm_models.StreamPhysicalSubtask = field(repr=False)
+    plan_bytes: bytes = field(repr=False)
+
+    def __reduce__(self) -> NoReturn:
+        raise TypeError(
+            "Internal routing authority cannot cross process or wire boundaries"
+        )
+
+    @property
+    def plan(self) -> topology.StreamDAGPlan:
+        return topology.StreamDAGPlan.model_validate_json(self.plan_bytes)
+
+    def validate(
+        self, session: AsyncSession, context: s.StreamDAGRouteContext | None = None
+    ) -> None:
+        if (
+            self.session is not session
+            or self.transaction is not session.get_transaction()
+            or (context is not None and context != self.context)
+            or self.graph.id != self.context.graph_revision_id
+            or self.graph.flow_run_id != self.flow_run_id
+            or self.graph.graph_digest != self.context.graph_digest
+            or self.subtask.id != self.context.producer_subtask_id
+            or self.subtask.graph_revision_id != self.graph.id
+            or self.subtask.task_run_id != self.task_run_id
+            or self.authority.flow_run_id != self.flow_run_id
+            or self.authority.generation != self.generation
+            or self.authority.holder_id != self.holder_id
+            or self.flow.run_count != self.flow_run_run_count
+            or self.authority.flow_run_run_count != self.flow_run_run_count
+        ):
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT",
+                "Routing authority belongs to another session, transaction or resource",
+            )
+        if self.authority.state == "RELEASED":
+            raise NativeStreamError(
+                "ROUTE_HORIZON_EXPIRED", "The routed execution horizon was released"
+            )
+        if (
+            self.authority.state != "ACTIVE"
+            or self.authority.cancel_requested
+            or self.graph.state != "ADMITTED"
+            or self.graph.abort_operation_id is not None
+        ):
+            raise NativeStreamError(
+                "RECOVERY_NOT_READY", "Routing authority is no longer active"
+            )
+
+
+def context_for_subtask(
+    plan: topology.StreamDAGPlan, subtask_id: UUID
+) -> s.StreamDAGRouteContext:
+    subtask = next((row for row in plan.subtasks if row.id == subtask_id), None)
+    if subtask is None:
+        raise NativeStreamError("IDENTITY_CONFLICT", "Subtask is not part of this DAG")
+    operator = next(row for row in plan.operators if row.id == subtask.operator_run_id)
+    return s.StreamDAGRouteContext(
+        graph_revision_id=plan.id,
+        graph_digest=plan.graph_digest,
+        routing_digest=graph_routing_digest(plan.graph_digest),
+        producer_subtask_id=subtask.id,
+        operator_uid=operator.operator_uid,
+        output_port_uid=operator.output_port.uid,
+        subtask_index=subtask.subtask_index,
+        has_keyed_outgoing=any(
+            edge.exchange == "keyed"
+            for edge in plan.edges
+            if edge.producer_operator_uid == operator.operator_uid
+        ),
+    )
+
+
+async def authorize_dag_routing_discovery(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    context: s.StreamDAGRouteContext,
+    execution: StreamExecutionCredentials,
+) -> DAGRouteAuthorization:
+    """Trusted model-test/service seam; public handlers cannot request this proof."""
+    await require_physical_backend(session, db)
+    locator = await session.get(db.StreamGraphRevision, context.graph_revision_id)
+    if locator is None:
+        raise NativeStreamError("NOT_FOUND", "Unknown DAG revision")
+    flow = await session.scalar(
+        sa.select(db.FlowRun)
+        .where(db.FlowRun.id == locator.flow_run_id)
+        .with_for_update(read=True)
+        .execution_options(populate_existing=True)
+    )
+    if flow is None:
+        raise NativeStreamError("NOT_FOUND", "Unknown FlowRun")
+    # Refresh under the ordered authority lock before the shared existing
+    # credential validator uses the identity map. No graph lock is held yet.
+    await session.scalar(
+        sa.select(db.StreamExecutionAuthority)
+        .where(db.StreamExecutionAuthority.flow_run_id == flow.id)
+        .with_for_update(read=True)
+        .execution_options(populate_existing=True)
+    )
+    authority = await require_execution(
+        session, db, flow.id, execution, allowed_states=("ACTIVE",)
+    )
+    if authority is None:
+        raise NativeStreamError(
+            "EXECUTION_BINDING_REQUIRED", "Current Flow execution authority is required"
+        )
+    graph = await session.scalar(
+        sa.select(db.StreamGraphRevision)
+        .where(db.StreamGraphRevision.id == context.graph_revision_id)
+        .with_for_update(read=True)
+        .execution_options(populate_existing=True)
+    )
+    if (
+        graph is None
+        or graph.profile != "partitioned-dag-v1"
+        or graph.state != "ADMITTED"
+    ):
+        raise NativeStreamError(
+            "RECOVERY_NOT_READY", "Internal routed transactions require an admitted DAG"
+        )
+    plan = await stream_dags.dag_plan(session, db, graph)
+    expected_context = context_for_subtask(plan, context.producer_subtask_id)
+    if context != expected_context:
+        raise NativeStreamError(
+            "IDENTITY_CONFLICT", "Routing context differs from the immutable DAG"
+        )
+    subtask = await session.scalar(
+        sa.select(db.StreamPhysicalSubtask)
+        .where(db.StreamPhysicalSubtask.id == context.producer_subtask_id)
+        .with_for_update(read=True)
+        .execution_options(populate_existing=True)
+    )
+    assert subtask is not None
+    proof = DAGRouteAuthorization(
+        session=session,
+        transaction=session.get_transaction(),
+        context=context,
+        flow_run_id=flow.id,
+        task_run_id=subtask.task_run_id,
+        generation=authority.generation,
+        holder_id=authority.holder_id,
+        flow_run_run_count=authority.flow_run_run_count,
+        flow=flow,
+        authority=authority,
+        graph=graph,
+        subtask=subtask,
+        plan_bytes=plan.model_dump_json().encode("utf-8"),
+    )
+    proof.validate(session)
+    return proof
+
+
+class _ReferenceEnvelope(BaseModel):
+    model_config = ConfigDict(
+        extra="forbid", frozen=True, strict=True, hide_input_in_errors=True
+    )
+    format: str = Field(alias="schema")
+    graph_revision_id: str
+    route_receipt_id: str
+    edge_partition_id: str
+    payload_record_id: str
+    payload_stream_id: str
+    payload_sequence: int = Field(ge=1, strict=True)
+    payload_value_digest: str
+
+
+@dataclass(frozen=True)
+class ResolvedDAGValue:
+    value: JsonValue
+    payload_record_id: UUID
+    payload_stream_id: UUID
+    payload_sequence: int
+    payload_value_digest: str
+    payload_size_bytes: int
+    reference_record_id: UUID
+    edge_partition_id: UUID
