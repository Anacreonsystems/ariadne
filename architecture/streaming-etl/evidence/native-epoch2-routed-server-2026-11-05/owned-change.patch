+            request.model_dump(mode="json") | {"output_key": {"kind": "N"}}
+        )
+    yielded = request.model_dump(mode="json") | {
+        "kind": "YIELD",
+        "output_key": {"kind": "N"},
+    }
+    assert s.StreamDAGConsumerCompleteRequest.model_validate(yielded).value is None
