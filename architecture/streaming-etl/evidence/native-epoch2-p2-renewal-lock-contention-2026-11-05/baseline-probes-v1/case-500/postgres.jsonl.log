ailable_slots\n    FROM\n        work_pool wp\n        JOIN work_queue wq ON wq.work_pool_id = wp.id\n        LEFT JOIN flow_run fr ON wq.id = fr.work_queue_id\n            AND fr.state_type IN ('RUNNING', 'PENDING')\n    WHERE\n        wp.is_paused IS FALSE\n        AND wq.is_paused IS FALSE\n        AND wp.concurrency_limit IS NOT NULL\n    GROUP BY\n        wp.id\n),\n\n-- compute available slots under worker pool queue concurrency limits\nqueue_slots AS (\n    SELECT\n        wq.id,\n        GREATEST (0, wq.concurrency_limit - COUNT(fr.id)) AS available_slots\n    FROM\n        work_queue wq\n        LEFT JOIN flow_run fr ON wq.id = fr.work_queue_id\n            AND fr.state_type IN ('RUNNING', 'PENDING')\n    WHERE\n        wq.is_paused IS FALSE\n        AND wq.concurrency_limit IS NOT NULL\n    GROUP BY\n        wq.id\n)\n\n-- get all flow runs that match crite"}, {"observed_at": "2026-11-05 10:47:04.000708+00:00", "pid": 25103, "application_name": "", "client_addr": "172.17.0.1/32", "client_port": 43256, "backend_start": "2026-11-05 10:46:35.757259+00:00", "xact_start": null, "query_start": "2026-11-05 10:47:02.785993+00:00", "state_change": "2026-11-05 10:47:02.786633+00:00", "state": "idle", "wait_event_type": "Client", "wait_event": "ClientRead", "backend_xid": null, "backend_xmin": null, "xact_age_seconds": null, "query_age_seconds": 1.214715, "blockers": [], "query": "COMMIT;"}, {"observed_at": "2026-11-05 10:47:04.000710+00:00", "pid": 25107, "application_name": "", "client_addr": "172.17.0.1/32", "client_port": 43294, "backend_start": "2026-11-05 10:46:37.045646+00:00", "xact_start": null, "query_start": "2026-11-05 10:47:03.993282+00:00", "state_change": "2026-11-05 10:47:03.994502+00:00", "state": "idle", "wait_event_type": "Client", "wait_event": "ClientRead", "backend_xid": null, "backend_xmin": null, "xact_age_seconds": null, "query_age_seconds": 0.007428, "blockers": [], "query": "COMMIT;"}], "locks": [{"locktype": "relation", "database": 837287,