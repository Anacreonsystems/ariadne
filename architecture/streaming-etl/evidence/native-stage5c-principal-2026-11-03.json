  "closed_findings": [
    "Hash-seed-dependent pickled code identity was replaced by a canonical structural witness while ordinary Task keys remain unchanged.",
    "Unsealed takeover refuses before Flow policy or generation CAS and leaves Flow, holder, attempt and DATA state unchanged.",
    "Abort requests require 1..128 manifest witnesses; an empty request mutates no receipt, TaskRun or stream.",
    "Terminal unsealed abort writes the stream tail and immutable exact-replay receipt atomically.",
    "Shared Task exception retry metadata no longer suppresses ordinary sync/async Flow exception retries.",
    "The zero-test flow-policy selector was rejected and replaced by a captured adapter selecting the unchanged TestFlowRetryingRule class."
  ],
  "scope": {
    "accepted": [
      "one finite source and linear operators",
      "explicit semantic submission keys and versioned top-level functions",
      "ordinary sync/async Prefect Flow and Task engines",
      "trusted confirmed-dead child replacement",
      "same deployment/runtime and bounded JSON/reference payloads",
      "same TaskRun/channel identities with no TaskRun per record"
    ],
    "not_claimed": [
      "automatic enrollment or replacement in every production worker",
      "branch, join, fan-out, mapping or dynamic graph reconstruction",
      "closures or local task functions",
      "unbounded-source online retention or GC",
      "production HA, throughput or capacity SLO",
      "exactly-once external side effects; clients own idempotency"
    ]
  },
  "qualifications": [
    "The replacement launch receives FlowRun/generation holder authority but not retained TaskRun or channel IDs.",
    "The five 500-document cuts use URI/hash references and client-idempotent file effects; they do not measure high load.",
    "The legacy contract profile remains prototype-adapter backed and is regression evidence only; native proof comes from core HTTP/PostgreSQL/process profiles.",
    "Only exact declared ordinary skip/xfail markers were accepted; native profiles have no skipped cases.",
    "The kernel log retains 18 resource_tracker text occurrences; this known multiprocessing diagnostic prevents a clean-teardown claim but does not alter the zero-error test result.",
    "The earlier 17/17 functional gate remains rejected because five source paths changed during the required safety correction.",
    "The first flow-policy invocation remains rejected because an invalid class selector collected zero tests; successor2 ran all seven real policy tests on the same 69 bytes."
  ],
