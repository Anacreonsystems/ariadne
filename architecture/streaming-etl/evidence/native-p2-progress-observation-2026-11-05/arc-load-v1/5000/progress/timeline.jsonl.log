ALSE\n        AND wp.concurrency_limit IS NOT NULL\n    GROUP BY\n        wp.id\n),\n\n-- compute available slots under worker pool queue concurrency limits\nqueue_slots AS (\n    SELECT\n        wq.id,\n        GREATEST (0, wq.concurrency_limit - COUNT(fr.id)) AS available_slots\n    FROM\n        work_queue wq\n        LEFT JOIN flow_run fr ON wq.id = fr.work_queue_id\n            AND fr.state_type IN ('RUNNING', 'PENDING')\n    WHERE\n        wq.is_paused IS FALSE\n        AND wq.concurrency_limit IS NOT NULL\n    GROUP BY\n        wq.id\n)\n\n-- get all flow runs that match crite"}, {"pid": 1135, "client_port": 48948, "state": "idle in transaction", "wait_event_type": "Client", "wait_event": "ClientRead", "xact_start": "2026-11-05 13:25:55.573710+00:00", "query_start": "2026-11-05 13:25:56.219293+00:00", "xact_age_seconds": 0.709899, "query_age_seconds": 0.064317, "blockers": [], "query": "SELECT task_run_state.id AS task_run_state_id, task_run_state.task_run_id AS task_run_state_task_run_id, task_run_state.type AS task_run_state_type, task_run_state.timestamp AS task_run_state_timestamp, task_run_state.name AS task_run_state_name, task_run_state.message AS task_run_state_message, task_run_state.state_details AS task_run_state_state_details, task_run_state.data AS task_run_state_data, task_run_state.result_artifact_id AS task_run_state_result_artifact_id, task_run_state.created AS task_run_state_created, task_run_state.updated AS task_run_state_updated \nFROM task_run_state \nWHERE task_run_state.id IN ($1::UUID)"}, {"pid": 1137, "client_port": 48966, "state": "idle in transaction", "wait_event_type": "Client", "wait_event": "ClientRead", "xact_start": "2026-11-05 13:25:56.279382+00:00", "query_start": "2026-11-05 13:25:56.279382+00:00", "xact_age_seconds": 0.004244, "query_age_seconds": 0.004246, "blockers": [], "query": "BEGIN;"}, {"pid": 1140, "client_port": 49006, "state": "idle", "wait_event_type": "Client", "wait_event": "ClientRead", "xact_start": null, "