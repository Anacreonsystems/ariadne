import asyncio,json,time
from datetime import datetime,timezone
from pathlib import Path
import asyncpg
async def main():
 c=await asyncpg.connect('postgresql://native_recovery:native_recovery@127.0.0.1:55436/postgres')
 base=Path('/tmp/native-p2-renewal-injected-candidate-v1');until=time.monotonic()+300;last_summary=0
 try:
  with (base/'pg-lock-observations-v2.jsonl').open('w') as out:
   while time.monotonic()<until and not (base/'tests.xml').exists():
    rows=await c.fetch("""SELECT pid,application_name,state,wait_event_type,wait_event,pg_blocking_pids(pid) AS blockers,EXTRACT(epoch from now()-xact_start)::float AS xact_seconds,EXTRACT(epoch from now()-query_start)::float AS query_seconds,left(query,1500) AS query FROM pg_stat_activity WHERE datname=$1 AND backend_type='client backend'""",'native_p2_renew_candidate_20261105_tests_master')
    blocking_ids={p for r in rows for p in r['blockers']}
    relevant=[dict(r) for r in rows if r['pid']in blocking_ids or r['blockers'] or r['wait_event_type']=='Lock' or (r['xact_seconds']or 0)>3]
    if relevant or time.monotonic()-last_summary>=5:
     locks=[]
     if relevant:
      locks=[dict(r) for r in await c.fetch("""SELECT pid,locktype,relation::text AS relation_oid, database::text AS database_oid,mode,granted,transactionid::text AS transactionid,virtualxid::text AS virtualxid FROM pg_locks WHERE pid=ANY($1::int[]) AND (NOT granted OR locktype='transactionid' OR locktype='tuple' OR mode IN ('RowShareLock','RowExclusiveLock'))""",[r['pid']for r in relevant])]
     out.write(json.dumps({'at':datetime.now(timezone.utc).isoformat(),'connections':len(rows),'relevant':relevant,'locks':locks})+'\n');out.flush()
     if not relevant:last_summary=time.monotonic()
    await asyncio.sleep(.5)
 finally:await c.close()
asyncio.run(main())
