"""Stdlib file-only comparison of two CLOSED synchronous normal DAG volumes."""
import hashlib
import json
import subprocess
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path
import xml.etree.ElementTree as ET

BASE = Path(__file__).resolve().parent
CI = Path('/tmp/native-ni013-18124-ci-sync500-metadata-20261106')
TRIAL = Path('/tmp/native-n2-2-sync5000-verification-18124-v1/sync5000-02edb1c0')
FIXTURE = TRIAL / 'pytest/test_public_dag_bounded_volume0'
SOURCE = Path('/tmp/ariadne-native-5000-diagnosis-v1')
HEAD = '18124603882fe9196a6eec6063a4619e7087f48f'


def load(path):
    return json.loads(path.read_text())


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def bind(path):
    return {'path': str(path), 'sha256': sha(path), 'bytes': path.stat().st_size}


index = CI / 'verify-index.json'
assert sha(index) == '9059c58d52581ebbe5979a57b1b45b799e5abc6054616aa8f5cc7b8e3a0343ab'
ci_index = load(index)
assert ci_index['closed'] and ci_index['head_sha'] == HEAD
for ref in ci_index['public_allowlist']:
    assert sha(CI / ref['name']) == ref['sha256']
receipt_path = TRIAL / 'native5000-receipt-v2.json'
assert sha(receipt_path) == 'acf2bcb79dfe79023df8636c91b82a4cc6372433fb92577360ab6db7d049763e'
receipt = load(receipt_path)
assert receipt['status'] == 'NATIVE_DAG5000_PASS_DB_RETAINED' and receipt['runtime_STOPPED']
assert receipt['head'] == HEAD and receipt['phase'] == 'sync5000' and receipt['pytest_exit'] == 0
assert receipt['body_wider_health']['status'] == 'BODY_AND_WIDER_HEALTH_PASS'
assert not receipt['source_drift'] and not receipt['import_audit']['mismatches']
before = load(TRIAL / 'source-before.json')
assert before == load(TRIAL / 'source-after.json')
source_bindings = []
for name, ref in ci_index['source_bindings'].items():
    path = SOURCE / name
    blob = subprocess.check_output(['git', 'show', HEAD+':'+name], cwd=SOURCE)
    assert hashlib.sha256(blob).hexdigest() == sha(path) == ref['sha256'] == before[name]['sha256']
    assert subprocess.check_output(['git', 'rev-parse', HEAD+':'+name], cwd=SOURCE, text=True).strip() == ref['git_blob']
    source_bindings.append(bind(path))

ci_observation = load(CI / 'observations.json')
author_observation = load(FIXTURE / 'observations.json')
ci_accepted = load(CI / 'accepted-cursors.json')
ci_final = load(CI / 'final-progress.json')
author_accepted = load(FIXTURE / 'accepted-cursors.json')
author_final = load(FIXTURE / 'final-progress.json')
derived = load(CI / 'derived-observables.json')
for count, observation, accepted, final in [
    (500, ci_observation, ci_accepted, ci_final),
    (5000, author_observation, author_accepted, author_final),
]:
    assert observation['asynchronous'] is False and observation['count'] == count
    assert observation['mode'] == 'normal' and observation['c_exchange'] == 'broadcast'
    assert observation['flow_state'] == 'COMPLETED' and final['graph_state'] == 'RELEASED'
    assert accepted['graph_revision_id'] == final['graph_revision_id'] == observation['graph_revision_id']
    assert len(accepted['consumers']) == 3
    assert all(row['completed_through'] == count and row['inflight_sequence'] is None for row in accepted['consumers'])
    for family, key in [('subtasks', 'subtask_id'), ('channels', 'id'), ('grants', 'id'), ('launches', 'id')]:
        assert {row[key] for row in accepted[family]} == {row[key] for row in final[family]}
    assert {row['task_run_id'] for row in accepted['subtasks']} == {row['task_run_id'] for row in final['subtasks']}
    assert all(row['state'] == 'RETIRED' for row in final['grants'])
    assert all(row['state'] == 'CLOSED' for row in final['launches'])
    assert all(row['state_type'] == 'COMPLETED' and row['physical_slot_released'] for row in final['subtasks'])
    assert all(row['run_count'] == row['physical_epoch'] == 1 for row in final['subtasks'])
    assert all(row['state'] == 'COMPLETED' and row['last_sequence'] == row['tail_sequence'] == count for row in final['channels'])

marker_paths = [FIXTURE / (role+'.pid.json') for role in ['A-0', 'B-0', 'C-0', 'C-1']]
markers = [load(path) for path in marker_paths]
assert len({row['pid'] for row in markers}) == 4
assert {row['task_run_id'] for row in markers} == {row['task_run_id'] for row in author_final['subtasks']}
assert all(row['attempt'] == 1 for row in markers)


def normalize(observation, accepted, final, marker_count, pid_count):
    return {
        'task_run_rows': final['task_run_count'],
        'subtask_rows': len(final['subtasks']),
        'physical_grant_rows': len(final['grants']),
        'physical_launch_rows': len(final['launches']),
        'channel_rows': len(final['channels']),
        'accepted_consumer_rows': len(accepted['consumers']),
        'task_process_birth_markers': marker_count,
        'distinct_task_birth_pids': pid_count,
        'operator_parallelism': dict(sorted(Counter(row['operator_uid'] for row in final['subtasks']).items())),
        'physical_epoch_values': sorted({row['physical_epoch'] for row in final['subtasks']}),
        'task_run_count_values': sorted({row['run_count'] for row in final['subtasks']}),
        'released_physical_slot_flags': sum(row['physical_slot_released'] for row in final['subtasks']),
        'registered_worker_ids': observation['worker_id_count'],
    }


assert derived['birth_markers'] == 4 and len(derived['unique_birth_pids']) == 4
ci_map = normalize(ci_observation, ci_accepted, ci_final, derived['birth_markers'], len(derived['unique_birth_pids']))
author_map = normalize(author_observation, author_accepted, author_final, len(markers), len({row['pid'] for row in markers}))
assert ci_map == author_map
assert ci_map == {'task_run_rows': 4, 'subtask_rows': 4, 'physical_grant_rows': 4,
                  'physical_launch_rows': 4, 'channel_rows': 7, 'accepted_consumer_rows': 3,
                  'task_process_birth_markers': 4, 'distinct_task_birth_pids': 4,
                  'operator_parallelism': {'A': 1, 'B': 1, 'C': 2}, 'physical_epoch_values': [1],
                  'task_run_count_values': [1], 'released_physical_slot_flags': 4, 'registered_worker_ids': 2}

history = []
for line in (FIXTURE / 'progress.jsonl').read_text().splitlines():
    row = json.loads(line)
    history.append(row.get('snapshot', row.get('progress', row)))
stability = {}
for family, key, expected in [('subtasks','subtask_id',4), ('channels','id',7), ('grants','id',4), ('launches','id',4)]:
    observed = [row for row in history if len(row.get(family, [])) == expected]
    reference = {row[key] for row in observed[0][family]}
    assert all({row[key] for row in row[family]} == reference for row in observed)
    assert all(len(row.get(family, [])) <= expected for row in history)
    stability[family] = {'full_count_observations': len(observed), 'expected_count': expected, 'same_ids_at_full_count': True}
task_sets = [{row['task_run_id'] for row in x.get('subtasks',[])} for x in history if x.get('task_run_count') == 4]
assert all(ids == task_sets[0] for ids in task_sets)
assert all(x.get('task_run_count', 0) <= 4 for x in history)

cases = ET.parse(CI / 'native-runtime-case.xml').findall('.//testcase')
assert len(cases) == 1 and cases[0].get('name') == 'test_public_dag_bounded_volume_postgres[False-500]'
assert not any(cases[0].find(tag) is not None for tag in ['failure','error','skipped'])
assert derived['source_accepted']['exact_1_through_500']
assert all(row['records'] == 500 and row['unique_sequences'] == 500 for row in derived['branch_call_metadata'].values())
assert all(x['calls'] == x['documents'] == 5000 for x in receipt['body_wider_health']['business'].values())
assert derived['api']['observed_api_5xx'] == 0 and derived['worker_health']['errors'] == derived['worker_health']['rejected'] == 0
assert not any(receipt['body_wider_health']['wider_health'].values())

local_paths = [receipt_path, TRIAL/'command.json', TRIAL/'source-before.json', TRIAL/'source-after.json',
               FIXTURE/'observations.json', FIXTURE/'accepted-cursors.json', FIXTURE/'final-progress.json',
               FIXTURE/'progress.jsonl', FIXTURE/'coordinator-retirement.json', FIXTURE/'worker-health.json'] + marker_paths
audit_path = Path('/tmp/native-sync5000-metadata-observer-18124-v1/principal-closed-sync5000-metadata-audit-v1.json')
assert sha(audit_path) == '09d9856caf6e28bdfc1faad9f671545eab98b7ff9a56e0d41c339a7172ce1229'
local_paths += [audit_path, Path(__file__)]
result = {
    'schema': 'principal-current-sync500-vs5000-observable-counts-v1',
    'recorded_at': datetime.now(timezone.utc).isoformat(),
    'status': 'PASS_SCOPED_SAME_PROFILE_FIXED_OBSERVABLE_COUNTS_500_VS5000',
    'head': HEAD, 'profile': 'partitioned-dag-v1 normal synchronous broadcast A1 B1 C2',
    'role': 'Independent Principal FILE-ONLY reconciliation; both SDK cases author/CI-attributed, not Principal SDK execution',
    'new_test_bodies': 0, 'new_DB_connections': 0, 'project_imports': 0, 'repository_changes': 0,
    'ci_case': {'count':500, 'run_id':ci_index['run_id'], 'job_id':ci_index['job_id'], 'artifact_id':ci_index['artifact_id'], 'junit':cases[0].attrib},
    'local_author_case': {'count':5000, 'trial':str(TRIAL), 'receipt':bind(receipt_path)},
    'normalized_observable_counts_500': ci_map, 'normalized_observable_counts_5000': author_map,
    'equal_observable_comparisons': len(ci_map),
    'within_run_UUIDs_equal_accepted_to_final': True,
    'UUID_equality_across_runs_required': False,
    'author_full_progress_observations': len(history), 'author_full_progress_stability':stability,
    'author_taskrun_ID_sets_same_at_full_count':True,
    'source_helper_and_launcher_git_blob_and_SHA_bindings': source_bindings,
    'ci_index':bind(index),
    'ci_public_metadata_bindings':[bind(CI/ref['name']) for ref in ci_index['public_allowlist']],
    'local_closed_input_bindings':[bind(path) for path in local_paths],
    'api_status_500_observation':derived['api'],
    'historical_review_erratum':load(CI/'review-attempts.json'),
    'limitations':[
        'Supports scoped A43-04 observed metadata-cardinality evidence only; no fullNI2-014/four-heavy/global/ADR43 acceptance or readiness increase.',
        'CI accepted/final safe metadata allow within-case identity comparison. Full CI progress history, raw call/source/birth-marker files and logs are not public-retained; CI birth/PID/source/call numbers use hash-bound derived aggregates, not a new independent reconstruction from raw CI files.',
        'Author raw progress history checked for stable UUID sets at full count; initial preactivation partial sets are not retroactively labelled full-count activation snapshots.',
        'Two runs require stable identities within each run; different UUID values across runs are expected.',
        'CI has no operator-run, assignment, actual PhysicalSlotAllocation/TagAllocation SQL counts; own closed authorSQL observations do not invent those missing CI metrics.',
        'No external KV backend or actual HTTP retry counter captured/inferred. API5xx0 is an aggregate over7547 retained API status lines, not a full network trace.',
        'Historical generic grant RELEASED assumption was a failed artifact-review assertion, preserved separately; literal native grant state is RETIRED. No CI workload RED or artifact repair claimed.',
        'Progress/accepted/final fixture snapshots are author direct-PG ordinary multi-SELECT observations, not API responses or independent atomic19-family snapshots.',
        'No throughput/SLO/performance/CI-cause/5000forecast claim; no all-current-union or Principal personal SDK5k credit.',
        'All grill-me/spec-first variants excluded; conflict scan known incomplete.',
    ],
}
path = BASE / 'principal-current-sync500-vs5000-counts-receipt-v1.json'
with path.open('x') as stream:
    json.dump(result, stream, indent=2, sort_keys=True)
    stream.write('\n')
print(json.dumps({'path':str(path),'sha256':sha(path),'status':result['status'],
                  'observable_comparisons':len(ci_map),'author_history_records':len(history)}))
