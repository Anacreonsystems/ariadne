"""One separate Root-authorized postterminal SELECT capture, never automatic."""
import asyncio
import json
from observer_common import arguments, capture


if __name__ == '__main__':
    args = arguments()
    result = asyncio.run(capture(args.scope, 'final'))
    print(json.dumps(result), flush=True)
    raise SystemExit(0 if result['status'] == 'ACTUAL_READONLY_MVCC_CAPTURE' and result['connection_closed'] else 1)
