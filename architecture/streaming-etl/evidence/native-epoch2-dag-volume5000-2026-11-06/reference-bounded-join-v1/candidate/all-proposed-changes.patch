+async def test_postgres_reference_resolution_distinguishes_missing_input_from_bad_envelope(
+    db: PrefectDBInterface, flow_run: orm_models.FlowRun
+):
+    region = await routing_region(db, flow_run)
+    source = await claim_source(db, region)
+    outcome = await append(
+        db, region, source_request(region, source, 1, {"kept": True})
+    )
+    reference = outcome.references[0]
+    target = next(
+        row
+        for row in region.plan.subtasks
+        if row.input_stream_id == reference.stream_id
+    )
+    binding = await open_input(db, region, target.operator_uid, target.subtask_index)
+    before = await contents(db, region)
+    async with route_store(db, region, target.operator_uid, target.subtask_index) as (
+        session,
+        store,
+        _,
+    ):
+        with pytest.raises(NativeStreamError) as missing:
+            await store.resolve_reference(reference.stream_id, reference.sequence + 1)
+        assert missing.value.code == "ROUTE_HORIZON_EXPIRED"
+        async with session.begin_nested() as savepoint:
+            await session.execute(
+                sa.update(db.StreamRecord)
+                .where(db.StreamRecord.id == reference.record_id)
+                .values(value={"malformed": True})
+                .execution_options(synchronize_session=False)
+            )
+            await session.execute(
+                sa.update(db.StreamRouteReceipt)
+                .where(db.StreamRouteReceipt.id == outcome.receipt_id)
+                .values(outcome={"also_malformed": True})
+                .execution_options(synchronize_session=False)
+            )
+            with pytest.raises(
+                NativeStreamError, match="Reference envelope is invalid"
+            ) as refused:
+                await store.read_consumer(binding)
+            assert refused.value.code == "REFERENCE_IDENTITY_CONFLICT"
+            await _assert_reference_refusal_left_data_unchanged(
+                session,
+                db,
+                region,
+                binding,
+                {row.id for row in before["records"]},
+                set(before["receipts"]),
+            )
+            await savepoint.rollback()
+    assert await contents(db, region) == before
+
