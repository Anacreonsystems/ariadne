+@pytest.mark.parametrize("poison", ["reference", "receipt", "payload"])
+async def test_postgres_reference_resolution_refreshes_cached_record_material(
+    db: PrefectDBInterface, flow_run: orm_models.FlowRun, poison: str
+):
+    region = await routing_region(db, flow_run)
+    source = await claim_source(db, region)
+    outcome = await append(
+        db, region, source_request(region, source, 1, {"kept": True})
+    )
+    reference = outcome.references[0]
+    target = next(
+        row
+        for row in region.plan.subtasks
+        if row.input_stream_id == reference.stream_id
+    )
+    binding = await open_input(db, region, target.operator_uid, target.subtask_index)
+    before = await contents(db, region)
+    async with route_store(db, region, target.operator_uid, target.subtask_index) as (
+        session,
+        store,
+        _,
+    ):
+        cached_reference = await session.get(db.StreamRecord, reference.record_id)
+        cached_payload = await session.get(db.StreamRecord, outcome.payload_record_id)
+        cached_receipt = await session.get(db.StreamRouteReceipt, outcome.receipt_id)
+        assert (
+            cached_reference is not None
+            and cached_payload is not None
+            and cached_receipt is not None
+        )
+        assert (
+            await store.resolve_reference(reference.stream_id, reference.sequence)
+        ).value == {"kept": True}
+        async with session.begin_nested() as savepoint:
+            if poison == "reference":
+                original = cached_reference.value
+                corrupted = {**original, "graph_revision_id": str(uuid4())}
+                _, encoded, digest = stream_routes.canonical_stream_payload(corrupted)
+                update = (
+                    sa.update(db.StreamRecord)
+                    .where(db.StreamRecord.id == cached_reference.id)
+                    .values(
+                        value=corrupted, value_digest=digest, size_bytes=len(encoded)
+                    )
+                )
+            elif poison == "receipt":
+                original = cached_receipt.outcome
+                corrupted = {
+                    **original,
+                    "references": [dict(item) for item in original["references"]],
+                }
+                corrupted["references"][0]["edge_id"] = str(uuid4())
+                corrupted["references"].sort(
+                    key=lambda item: (
+                        UUID(item["edge_id"]).bytes,
+                        UUID(item["edge_partition_id"]).bytes,
+                        UUID(item["record_id"]).bytes,
+                    )
+                )
+                corrupted["outcome_digest"] = route_outcome_digest(corrupted)
+                wire.StreamDAGRouteOutcome.model_validate(corrupted)
+                update = (
+                    sa.update(db.StreamRouteReceipt)
+                    .where(db.StreamRouteReceipt.id == cached_receipt.id)
+                    .values(
+                        outcome=corrupted,
+                        outcome_digest=corrupted["outcome_digest"],
+                        outcome_size=len(canonical_route_json(corrupted)),
+                    )
+                )
+            else:
+                original = cached_payload.value
+                update = (
+                    sa.update(db.StreamRecord)
+                    .where(db.StreamRecord.id == cached_payload.id)
+                    .values(value={"changed_without_digest": True})
+                )
+            await session.execute(update.execution_options(synchronize_session=False))
+            assert (
+                cached_reference.value
+                if poison == "reference"
+                else cached_receipt.outcome
+                if poison == "receipt"
+                else cached_payload.value
+            ) == original
+            with pytest.raises(NativeStreamError) as refused:
+                await store.read_consumer(binding)
+            assert refused.value.code == "REFERENCE_IDENTITY_CONFLICT"
+            await _assert_reference_refusal_left_data_unchanged(
+                session,
+                db,
+                region,
+                binding,
+                {row.id for row in before["records"]},
+                set(before["receipts"]),
+            )
+            await savepoint.rollback()
+    assert await contents(db, region) == before
+
