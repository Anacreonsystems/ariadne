+async def _assert_reference_refusal_left_data_unchanged(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    region: RoutingRegion,
+    binding: ConsumerBinding,
+    record_ids: set[UUID],
+    receipt_ids: set[UUID],
+) -> None:
+    cursor = (
+        await session.execute(
+            sa.select(
+                db.StreamConsumer.completed_through,
+                db.StreamConsumer.inflight_sequence,
+                db.StreamConsumer.delivery_id,
+                db.StreamConsumer.managed_state,
+            ).where(db.StreamConsumer.id == binding.consumer_id)
+        )
+    ).one()
+    assert tuple(cursor) == (0, None, None, {})
+    output = (
+        await session.execute(
+            sa.select(
+                db.StreamPartition.last_sequence,
+                db.StreamPartition.producer_position,
+                db.StreamPartition.record_count,
+                db.StreamPartition.byte_count,
+            ).where(db.StreamPartition.id == binding.output_stream_id)
+        )
+    ).one()
+    assert tuple(output) == (0, 0, 0, 0)
+    assert (
+        set(
+            (
+                await session.scalars(
+                    sa.select(db.StreamRecord.id).where(
+                        db.StreamRecord.graph_revision_id == region.plan.id
+                    )
+                )
+            ).all()
+        )
+        == record_ids
+    )
+    assert (
+        set(
+            (
+                await session.scalars(
+                    sa.select(db.StreamRouteReceipt.id).where(
+                        db.StreamRouteReceipt.graph_revision_id == region.plan.id
+                    )
+                )
+            ).all()
+        )
+        == receipt_ids
+    )
+
