"""Run ONE unchanged native DAG5000 node only under a new explicit Root hold."""

import asyncio
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import urlsplit, urlunsplit
from uuid import uuid4

import asyncpg

from audit_native_5000_v1 import inspect
from native_5000_support_v1 import ROOT, create_database, proc_ticks, source_snapshot

BASE = Path(__file__).resolve().parent
SELECTOR = Path("/tmp/native-ni012-runtime-test-env.json")
ASSETS = ("native_5000_runner_v1.py", "native_5000_support_v1.py", "audit_native_5000_v1.py", "observe_native_5000_v1.py", "startup-template.py.txt")
NODES = {
    "async5000": "tests/test_native_stream_dag_execution_http.py::test_public_dag_bounded_volume_postgres[True-5000]",
    "sync5000": "tests/test_native_stream_dag_execution_http.py::test_public_dag_bounded_volume_postgres[False-5000]",
}


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write(path, value):
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")


def sanitize(value):
    return re.sub(r"(?i)(postgres(?:ql)?(?:\+asyncpg)?://)[^\s\'\"<>]+", r"\1[redacted-owned-test-dsn]", value)


def disk_snapshot():
    return {name: dict(zip(("total", "used", "free"), shutil.disk_usage(name))) for name in ("/tmp", "/workspace")}


async def close_owned(config, name, drop):
    connection = await asyncpg.connect(config["admin_dsn"], timeout=3)
    try:
        names = [name, name + "_tests_master"]
        assert all(re.fullmatch("[a-z][a-z0-9_]{1,62}", item) for item in names)
        sessions = [dict(row) for row in await connection.fetch("SELECT datname,pid,state FROM pg_stat_activity WHERE datname=ANY($1::text[])", names)]
        dropped = []
        # A live/unknown owner or failed validation never permits FORCE/drop.
        if drop and not sessions:
            for item in names:
                await connection.execute('DROP DATABASE IF EXISTS "' + item + '"')
                dropped.append(item)
        remaining = [row["datname"] for row in await connection.fetch("SELECT datname FROM pg_database WHERE datname=ANY($1::text[])", names)]
        return {"owned_databases": names, "sessions_before_drop": sessions, "dropped": dropped, "remaining": remaining, "force_used": False, "drop_requested": drop, "old_soak_or_forensic_touched": False, "qualification": "Only validated successful fresh databases drop after zero sessions; failure/inconclusive databases are retained for diagnosis. This is operational cleanup, not platform terminal/release proof."}
    finally:
        await connection.close()


def main():
    os.umask(0o077)
    if len(sys.argv) != 3 or sys.argv[2] not in NODES:
        raise SystemExit("usage: native_5000_runner_v1.py /ABS/ROOT_NATIVE5000_HOLD.json async5000|sync5000")
    hold_path = Path(sys.argv[1]); phase = sys.argv[2]
    assert hold_path.is_absolute()
    hold = json.loads(hold_path.read_text())
    assert hold["status"] == "ROOT_AUTHORIZED_NATIVE_5000_SOURCE_HOLD"
    assert hold["runtime_authorized_by"] == "/root" and hold["publication_hooks_status"] == "STOPPED_PASS"
    assert phase in hold["authorized_phases"] and hold["nodes"][phase] == NODES[phase]
    assert hold["source_root"] == str(ROOT) and hold["budgets"] == {"wait": 3960, "observe": 4080, "pytest": 4200}
    head = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
    assert hold["head"] == head
    before = source_snapshot(); assert before == hold["files"]
    assets = {name: sha(BASE / name) for name in ASSETS}; assert assets == hold["assets"]
    if phase == "sync5000":
        previous_path = Path(hold["previous_async_stop"]["path"])
        assert previous_path.is_absolute() and sha(previous_path) == hold["previous_async_stop"]["sha256"]
        previous = json.loads(previous_path.read_text())
        assert previous["phase"] == "async5000" and previous["runtime_STOPPED"] is True
        assert previous["remaining_same_identity_live"] == previous["remaining_same_identity_zombies"] == []
        assert hold["sync_separate_root_go"] is True
    trial = BASE / (phase + "-" + uuid4().hex[:8]); trial.mkdir(mode=0o700)
    for name in ("audit", "startup", "temp"): (trial / name).mkdir(mode=0o700)
    write(trial / "source-before.json", before); write(trial / "external-assets.json", assets)
    write(trial / "disk-before.json", disk_snapshot())
    site = (BASE / "startup-template.py.txt").read_text().replace("SOURCE_ROOT", repr(str(ROOT / "src/prefect") + "/")).replace("AUDIT_DIRECTORY", repr(str(trial / "audit")))
    (trial / "startup/sitecustomize.py").write_text(site)
    config = json.loads(SELECTOR.read_text())
    name = config["database_prefix"] + "_v5_" + uuid4().hex[:8]
    asyncio.run(create_database(config, name))
    parsed = urlsplit(config["admin_dsn"]); environment = os.environ.copy()
    environment.pop("PREFECT_API_DATABASE_CONNECTION_URL", None)
    environment["PREFECT_SERVER_DATABASE_CONNECTION_URL"] = urlunsplit((config["sqlalchemy_scheme"], parsed.netloc, "/" + name, parsed.query, ""))
    environment["PATH"] = "/workspace/ariadne/.venv/bin" + os.pathsep + environment.get("PATH", "")
    environment["UV_NO_SYNC"] = "1"; environment["UV_PROJECT_ENVIRONMENT"] = "/workspace/ariadne/.venv"
    environment["PYTHONPYCACHEPREFIX"] = str(trial / "pycache")
    environment["PYTHONPATH"] = os.pathsep.join((str(trial / "startup"), str(ROOT / "src"), str(ROOT)))
    environment["TMPDIR"] = str(trial / "temp")
    environment["PREFECT_LOGGING_LEVEL"] = "INFO"; environment["PREFECT_LOGGING_INTERNAL_LEVEL"] = "WARNING"
    command = ["uv", "run", "--no-sync", "python", "-m", "pytest", NODES[phase], "-q", "-o", "addopts=", "--junitxml=" + str(trial / "pytest.private.xml"), "--basetemp=" + str(trial / "pytest")]
    write(trial / "command.json", {"command": command, "nodeid": NODES[phase], "cwd": str(ROOT), "phase": phase, "head": head, "database": name, "config_selector": str(SELECTOR), "hold_sha256": sha(hold_path), "assets": assets, "generated_startup_sha256": hashlib.sha256(site.encode()).hexdigest(), "budgets": hold["budgets"], "count": 5000, "mode": "normal", "asynchronous": phase == "async5000", "profiling": False})
    fd = os.open(trial / "pytest.private.log", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as output:
        process = subprocess.Popen(command, cwd=ROOT, env=environment, stdout=output, stderr=subprocess.STDOUT, start_new_session=True)
        identity = {"pytest_pid": process.pid, "pytest_start_ticks": proc_ticks(process.pid), "pgid": os.getpgid(process.pid)}
        write(trial / "process.json", identity)
        print(json.dumps({"status": "ONE_EXACT_NATIVE5000_RUNNING", "phase": phase, "trial": str(trial), **identity}), flush=True)
        # This only observes disk; it does not alter test/worker/API deadlines.
        with (trial / "disk-observations.jsonl").open("w") as disk:
            while process.poll() is None:
                disk.write(json.dumps({"monotonic_ns": time.monotonic_ns(), "disks": disk_snapshot()}) + "\n"); disk.flush()
                time.sleep(10)
        result = process.wait()
    (trial / "exit").write_text(str(result) + "\n")
    after = source_snapshot(); write(trial / "source-after.json", after)
    drift = [key for key in before.keys() | after.keys() if before.get(key) != after.get(key)]
    if subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip() != head: drift.append("GIT_HEAD")
    if assets != {name: sha(BASE / name) for name in ASSETS}: drift.append("EXTERNAL_ASSETS")
    if (trial / "startup/sitecustomize.py").read_text() != site: drift.append("GENERATED_STARTUP")
    write(trial / "drift.json", drift)
    mismatches = []; identities = {process.pid: identity["pytest_start_ticks"]}; audit_rows = 0
    for path in (trial / "audit").glob("*.jsonl"):
        for line in path.read_text().splitlines():
            row = json.loads(line); audit_rows += 1; identities[row["pid"]] = str(row["start_ticks"])
            try: relative = str(Path(row["path"]).relative_to(ROOT))
            except ValueError: mismatches.append({"reason": "foreign Prefect import", "path": row["path"]}); continue
            if relative not in before or before[relative]["sha256"] != row["source_sha256"]: mismatches.append({"reason": "import bytes differ", "path": relative})
    if not audit_rows: mismatches.append({"reason": "no Prefect byte observations"})
    live = []; zombies = []
    for pid, ticks in identities.items():
        try: fields = Path("/proc", str(pid), "stat").read_text().rsplit(")", 1)[1].split()
        except FileNotFoundError: continue
        if fields[19] == str(ticks): (zombies if fields[0] == "Z" else live).append(pid)
    write(trial / "process-closure.json", {"observed_pid_start_pairs": identities, "remaining_same_identity_live": live, "remaining_same_identity_zombies": zombies, "audit_rows": audit_rows})
    write(trial / "import-mismatches.json", mismatches)
    body = inspect(trial, phase); write(trial / "body-wider-health-audit.json", body)
    precleanup_pass = result == 0 and not drift and not mismatches and not live and not zombies and body["status"] == "BODY_AND_WIDER_HEALTH_PASS"
    closed = asyncio.run(close_owned(config, name, precleanup_pass)); write(trial / "cleanup.json", closed)
    for private, public in (("pytest.private.log", "pytest.log"), ("pytest.private.xml", "pytest.public.xml")):
        path = trial / private
        if path.exists(): os.chmod(path, 0o600); (trial / public).write_text(sanitize(path.read_text(errors="replace")))
    runtime_closed = not live and not zombies and not closed["sessions_before_drop"]
    passed = precleanup_pass and runtime_closed and not closed["remaining"]
    write(trial / "native5000-receipt-v1.json", {"status": "NATIVE_DAG5000_PASS" if passed else "NATIVE_OR_HEALTH_OR_HARNESS_RED", "runtime_STOPPED": runtime_closed, "phase": phase, "nodeid": NODES[phase], "head": head, "pytest_exit": result, "source_files": len(before), "source_drift": drift, "import_mismatches": mismatches, "remaining_same_identity_live": live, "remaining_same_identity_zombies": zombies, "body_wider_health": body, "cleanup": closed, "budgets": hold["budgets"], "assets": assets, "hold_sha256": sha(hold_path), "profiling": False, "qualification": "One unchanged native SDK/TCP/PG17/OS DAG5000 case. No automatic next phase/retry/source correction, no throughput or causal claim, no readiness credit from this implementer receipt."})
    print(json.dumps({"status": ("STOPPED_PASS" if passed else "STOPPED_RED") if runtime_closed else "RUNTIME_CLOSURE_INCOMPLETE", "phase": phase, "trial": str(trial), "pytest_exit": result, "source_drift": drift, "failed_checks": body["failed_checks"][:12], "remaining_sessions": closed["sessions_before_drop"], "dropped_databases": len(closed["dropped"])}), flush=True)
    raise SystemExit(0 if passed else (result or 90))


if __name__ == "__main__":
    import fcntl
    lock = os.open(BASE / "one-native5000-runtime.lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        main()
    finally:
        os.close(lock)
