+    def test_outgoing_edges_are_exact_immutable_and_have_one_producer_parallelism(self):
+        for invalid in ([edge()], TupleSubclass((edge(),)), (object(),)):
+            with self.assertRaises(RoutePlanningError):
+                select(invalid)
+        with self.assertRaises(RoutePlanningError):
+            select((edge(), edge()))
+        with self.assertRaises(RoutePlanningError):
+            select((edge(), edge(2, "broadcast", 2, 1)))
