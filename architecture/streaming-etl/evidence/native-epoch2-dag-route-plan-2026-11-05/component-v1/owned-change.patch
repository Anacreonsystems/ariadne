+class TestRouteDigestMaterial(unittest.TestCase):
+    def test_canonical_json_keeps_utf8_and_sorted_names(self):
+        value = {"z": [None, True, 3, 1.5], "é": "e\u0301", "a": {"y": 2, "x": 1}}
+        self.assertEqual(
+            canonical_route_json(value),
+            b'{"a":{"x":1,"y":2},"z":[null,true,3,1.5],"\xc3\xa9":"e\xcc\x81"}',
+        )
+        shared: list[object] = [1]
+        self.assertEqual(canonical_route_json([shared, shared]), b"[[1],[1]]")
+
+    def test_canonical_json_refuses_coercions_and_subclasses(self):
+        invalid = (
+            {1: "a"},
+            {True: "a"},
+            {None: "a"},
+            {StringSubclass("a"): 1},
+            (1, 2),
+            {1, 2},
+            b"x",
+            object(),
+            StringSubclass("a"),
+            IntegerSubclass(1),
+            IntegerEnum.ONE,
+            ListSubclass([1]),
+            DictSubclass({"a": 1}),
+            MappingProxyType({"a": 1}),
+            float("nan"),
+            float("inf"),
+            -float("inf"),
+            "\ud800",
+            {"nested": ["\udfff"]},
+            {"\ud800": "bad-key"},
+        )
+        for value in invalid:
+            with self.subTest(kind=type(value).__name__):
+                with self.assertRaises(RoutePlanningError):
+                    canonical_route_json(value)
+
+    def test_cycles_are_refused_but_repeated_acyclic_values_are_allowed(self):
+        items: list[object] = []
+        items.append(items)
+        mapping: dict[str, object] = {}
+        mapping["self"] = mapping
+        for value in (items, mapping, {"nested": [mapping]}):
+            with self.assertRaises(RoutePlanningError):
+                canonical_route_json(value)
+            with self.assertRaises(RoutePlanningError):
+                route_semantic_digest({"nested": value})
+            with self.assertRaises(RoutePlanningError):
+                route_outcome_digest({"nested": value})
+
+    def test_digest_entry_points_refuse_mapping_callbacks(self):
+        mapping = CallbackMapping()
+        for value in (
+            mapping,
+            MappingProxyType({"stable": 1}),
+            DictSubclass({"stable": 1}),
+        ):
+            for function in (route_semantic_digest, route_outcome_digest):
+                with self.subTest(
+                    function=function.__name__, kind=type(value).__name__
+                ):
+                    with self.assertRaises(RoutePlanningError):
+                        function(value)
+        self.assertEqual(mapping.callbacks, [])
+        with self.assertRaises(RoutePlanningError):
+            canonical_route_json(mapping)
