+    def test_outcome_digest_excludes_only_its_own_top_level_field(self):
+        outcome = {
+            "status": "ACCEPTED",
+            "references": [{"stream_id": "s1", "sequence": 1}],
+            "worker_id": "w1",
+        }
+        expected = route_outcome_digest(outcome)
