+    def test_targets_cannot_alias_across_edges(self):
+        first, second = edge(), edge(2)
+        for field in ("edge_partition_id", "stream_id"):
+            aliased = replace(
+                second.targets[0], **{field: getattr(first.targets[0], field)}
+            )
+            with self.assertRaises(RoutePlanningError):
+                select((first, replace(second, targets=(aliased,))))
