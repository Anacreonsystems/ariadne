+"""Pure sealed-route contracts with hostile raw inputs; no database or runtime."""
+
+import json
+import os
+import subprocess
+import sys
+import unittest
+from collections.abc import Iterator, Mapping
+from dataclasses import FrozenInstanceError, replace
+from enum import IntEnum, StrEnum
+from types import MappingProxyType
+from typing import Any, Literal, cast
+from uuid import UUID
+
+from prefect._internal.stream_route_plan import (
+    RouteEdge,
+    RoutePlanningError,
+    RouteTarget,
+    canonical_route_json,
+    graph_routing_digest,
+    plan_route_targets,
+    route_outcome_digest,
+    route_semantic_digest,
+)
+
+Exchange = Literal["forward", "rebalance", "broadcast", "keyed"]
+
+
+class IntegerSubclass(int):
+    pass
+
+
+class StringSubclass(str):
+    pass
+
+
+class IntegerEnum(IntEnum):
+    ONE = 1
+
+
+class ExchangeEnum(StrEnum):
+    FORWARD = "forward"
+
+
+class UUIDSubclass(UUID):
+    pass
+
+
+class TargetSubclass(RouteTarget):
+    pass
+
+
+class EdgeSubclass(RouteEdge):
+    pass
+
+
+class ListSubclass(list[object]):
+    pass
+
+
+class DictSubclass(dict[str, object]):
+    pass
+
+
+class TupleSubclass(tuple[object, ...]):
+    pass
+
+
+class CallbackMapping(Mapping[str, object]):
+    def __init__(self) -> None:
+        self.callbacks: list[str] = []
+
+    def __getitem__(self, key: str) -> object:
+        self.callbacks.append("getitem")
+        raise AssertionError("A refused mapping must never be read")
+
+    def __iter__(self) -> Iterator[str]:
+        self.callbacks.append("iter")
+        return iter(())
+
+    def __len__(self) -> int:
+        self.callbacks.append("len")
+        return 0
+
+
+def edge(
+    number: int = 1,
+    exchange: Exchange = "forward",
+    producer_parallelism: int = 1,
+    target_parallelism: int = 1,
+    key_group_count: int | None = None,
+) -> RouteEdge:
+    identity = UUID(int=number)
+    return RouteEdge(
+        edge_id=identity,
+        exchange=exchange,
+        producer_parallelism=producer_parallelism,
+        target_parallelism=target_parallelism,
+        targets=tuple(
+            RouteTarget(
+                identity,
+                UUID(int=10_000 + number * 100 + index),
+                UUID(int=1_000_000 + number * 100 + index),
+                index,
+            )
+            for index in range(target_parallelism)
+        ),
+        key_group_count=key_group_count,
+    )
+
+
+def select(
+    edges: Any,
+    producer_index: Any = 0,
+    producer_sequence: Any = 1,
+    *,
+    physical_subtask_count: Any = 128,
+    key_present: Any = False,
+    key: Any = None,
+) -> tuple[RouteTarget, ...]:
+    """Pass raw hostile inputs through the production validation boundary."""
+    return plan_route_targets(
+        edges,
+        producer_index,
+        producer_sequence,
+        physical_subtask_count=physical_subtask_count,
+        key_present=key_present,
+        key=key,
+    )
+
+
+class TestSealedRouteManifests(unittest.TestCase):
+    def test_targets_and_edges_are_frozen(self):
+        manifest = edge()
+        with self.assertRaises(FrozenInstanceError):
+            setattr(manifest.targets[0], "partition_index", 1)
+        with self.assertRaises(FrozenInstanceError):
+            setattr(manifest, "target_parallelism", 2)
+
+    def test_target_identities_require_exact_uuid_values(self):
+        target = edge().targets[0]
+        for field in ("edge_id", "edge_partition_id", "stream_id"):
+            for invalid in (
+                str(target.edge_id),
+                target.edge_id.int,
+                UUIDSubclass(int=1),
+                None,
+            ):
+                with self.subTest(field=field, kind=type(invalid).__name__):
+                    with self.assertRaises(RoutePlanningError):
+                        replace(target, **{field: invalid})
+
+    def test_target_index_requires_exact_bounded_integer(self):
+        for invalid in (
+            -1,
+            16,
+            True,
+            False,
+            1.0,
+            "0",
+            IntegerSubclass(0),
+            IntegerEnum.ONE,
+        ):
+            with self.subTest(kind=type(invalid).__name__):
+                with self.assertRaises(RoutePlanningError):
+                    replace(edge().targets[0], partition_index=invalid)
+        self.assertEqual(
+            edge(target_parallelism=16, exchange="broadcast")
+            .targets[-1]
+            .partition_index,
+            15,
+        )
+
+    def test_parallelism_is_validated_before_range_or_index_callbacks(self):
+        callbacks: list[str] = []
+
+        class IndexCallback:
+            def __index__(self) -> int:
+                callbacks.append("index")
+                return 1
+
+        for name in ("producer_parallelism", "target_parallelism"):
+            for invalid in (
+                None,
+                True,
+                1.0,
+                "1",
+                -1,
+                0,
+                17,
+                10**100,
+                IntegerSubclass(1),
+                IntegerEnum.ONE,
+                IndexCallback(),
+            ):
+                with self.subTest(field=name, kind=type(invalid).__name__):
+                    with self.assertRaises(RoutePlanningError):
+                        replace(edge(), **{name: invalid})
+        self.assertEqual(callbacks, [])
+
+    def test_exchange_requires_exact_supported_string(self):
+        invalid_values: tuple[Any, ...] = (
+            None,
+            [],
+            {},
+            1,
+            "unknown",
+            "FORWARD",
+            StringSubclass("forward"),
+            ExchangeEnum.FORWARD,
+        )
+        for invalid in invalid_values:
+            with self.subTest(kind=type(invalid).__name__):
+                with self.assertRaises(RoutePlanningError):
+                    replace(edge(), exchange=invalid)
+
+    def test_routing_version_is_exact_one(self):
+        for invalid in (True, 1.0, "1", 0, 2, IntegerSubclass(1), IntegerEnum.ONE):
+            with self.subTest(kind=type(invalid).__name__):
+                with self.assertRaises(RoutePlanningError):
+                    replace(edge(), routing_version=invalid)
+
+    def test_manifest_uuid_targets_and_order_cannot_be_coerced(self):
+        original = edge(exchange="broadcast", target_parallelism=2)
+        invalid_targets = (
+            list(original.targets),
+            TupleSubclass(original.targets),
+            original.targets[:1],
+            original.targets[::-1],
+            (original.targets[0], original.targets[0]),
+            (original.targets[0], object()),
+            (original.targets[0], replace(original.targets[1], edge_id=UUID(int=90))),
+            (
+                original.targets[0],
+                replace(
+                    original.targets[1],
+                    edge_partition_id=original.targets[0].edge_partition_id,
+                ),
+            ),
+            (
+                original.targets[0],
+                replace(original.targets[1], stream_id=original.targets[0].stream_id),
+            ),
+        )
+        for targets in invalid_targets:
+            with self.subTest(kind=type(targets).__name__):
+                with self.assertRaises(RoutePlanningError):
+                    replace(original, targets=targets)
+        for identity in (str(original.edge_id), UUIDSubclass(int=1), 1):
+            with self.assertRaises(RoutePlanningError):
+                replace(original, edge_id=identity)
+
+    def test_sealed_shapes_refuse_subclasses(self):
+        target = edge().targets[0]
+        with self.assertRaises(RoutePlanningError):
+            TargetSubclass(
+                target.edge_id, target.edge_partition_id, target.stream_id, 0
+            )
+        manifest = edge()
+        with self.assertRaises(RoutePlanningError):
+            EdgeSubclass(manifest.edge_id, "forward", 1, 1, manifest.targets)
+
+    def test_forward_requires_equal_parallelism(self):
+        with self.assertRaises(RoutePlanningError):
+            edge(producer_parallelism=2, target_parallelism=3)
+
+    def test_key_group_count_is_exact_bounded_and_covers_targets(self):
+        manifest = edge(exchange="keyed", target_parallelism=3, key_group_count=16)
+        for invalid in (
+            None,
+            False,
+            True,
+            1.0,
+            "16",
+            0,
+            -1,
+            2,
+            2**31,
+            IntegerSubclass(16),
+            IntegerEnum.ONE,
+        ):
+            with self.subTest(kind=type(invalid).__name__):
+                with self.assertRaises(RoutePlanningError):
+                    replace(manifest, key_group_count=invalid)
+        self.assertEqual(
+            replace(manifest, key_group_count=2**31 - 1).key_group_count, 2**31 - 1
+        )
+        for kind in ("forward", "broadcast", "rebalance"):
+            with self.assertRaises(RoutePlanningError):
+                edge(exchange=kind, key_group_count=16)
+
+
+class TestRouteSelection(unittest.TestCase):
+    def test_forward_preserves_each_producer_index(self):
+        manifest = edge(producer_parallelism=4, target_parallelism=4)
+        for index in range(4):
+            for sequence in (1, 2, 101, 10**100):
+                self.assertEqual(
+                    select((manifest,), index, sequence), (manifest.targets[index],)
+                )
+
+    def test_rebalance_uses_original_producer_coordinate(self):
+        manifest = edge(
+            exchange="rebalance", producer_parallelism=2, target_parallelism=3
+        )
+        expected = ((0, 1, 2, 0, 1, 2), (1, 2, 0, 1, 2, 0))
+        for producer in range(2):
+            for sequence, target in enumerate(expected[producer], 1):
+                self.assertEqual(
+                    select((manifest,), producer, sequence), (manifest.targets[target],)
+                )
+        select((manifest,), 0, 200)
+        select((manifest,), 1, 6)
+        self.assertEqual(select((manifest,), 1, 5), (manifest.targets[2],))
+
+    def test_broadcast_emits_every_target_once_and_accepts_different_parallelism(self):
+        manifest = edge(
+            exchange="broadcast", producer_parallelism=2, target_parallelism=3
+        )
+        for producer in range(2):
+            self.assertEqual(select((manifest,), producer), manifest.targets)
+
+    def test_selection_is_sorted_by_uuid_bytes_not_argument_or_partition_order(self):
