+    def test_routing_and_digests_do_not_depend_on_python_hash_seed(self):
+        program = """import json
+from uuid import UUID
+from prefect._internal.stream_route_plan import RouteEdge,RouteTarget,plan_route_targets,graph_routing_digest,route_semantic_digest
+edge=UUID(int=1)
+targets=tuple(RouteTarget(edge,UUID(int=10+i),UUID(int=100+i),i) for i in range(3))
+manifest=RouteEdge(edge,"keyed",2,3,targets,key_group_count=31)
+selected=plan_route_targets((manifest,),1,200,physical_subtask_count=5,key_present=True,key="é")
+print(json.dumps([selected[0].partition_index,graph_routing_digest("0"*64),route_semantic_digest({"stable":[200,"é"]})]))
+"""
+        results: list[object] = []
+        for seed in ("1", "987654321"):
+            result = subprocess.run(
+                [sys.executable, "-c", program],
+                check=True,
+                capture_output=True,
+                text=True,
+                timeout=20,
+                env={**os.environ, "PYTHONHASHSEED": seed},
+            )
+            results.append(json.loads(result.stdout))
+        self.assertEqual(results[0], results[1])
