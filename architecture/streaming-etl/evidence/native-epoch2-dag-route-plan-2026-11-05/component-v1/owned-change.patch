+    def test_127_references_are_legal_at_n128_and_128_targets_are_refused(self):
+        outgoing = tuple(
+            edge(n, "broadcast", 1, 16 if n < 8 else 15) for n in range(1, 9)
+        )
+        selected = select(outgoing, physical_subtask_count=128)
+        self.assertEqual(len(selected), 127)
+        self.assertEqual(len({t.stream_id for t in selected}), 127)
+        with self.assertRaises(RoutePlanningError):
+            select(outgoing, physical_subtask_count=127)
+        overflowing = (*outgoing[:-1], edge(8, "broadcast", 1, 16))
+        with self.assertRaises(RoutePlanningError):
+            select(overflowing, physical_subtask_count=128)
+        with self.assertRaises(RoutePlanningError):
+            select(overflowing, physical_subtask_count=129)
