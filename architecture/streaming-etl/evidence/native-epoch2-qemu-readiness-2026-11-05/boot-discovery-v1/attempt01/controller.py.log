   if line=='\n':
    if d.get('Package') in wanted:found[d['Package']]=d
    d={}
   elif not line.startswith(' '):
    k,_,v=line.partition(': ');d[k]=v.rstrip()
 for name,r in wanted.items():
  for k in ['Version','Filename','Size','SHA256']:assert found[name][k]==r[k],(name,k)
 assert len(wanted)==20
 (ROOT/'verified-package-closure.json').write_text(json.dumps(desired,indent=2)+'\n')
 for r in desired:fetch(Path(r['Filename']).name,'https://deb.debian.org/debian/'+r['Filename'],int(r['Size']),r['SHA256'])
 expected='bc9237bfdfa42b5f9a4404b6c6cab595d3e57599c6498f6664ad00e6192f9595'
 assert expected+' *ubuntu-24.04-minimal-cloudimg-amd64.img' in (META/'ubuntu-dated-SHA256SUMS').read_text()
 image=fetch('ubuntu-minimal-20261103.img','https://cloud-images.ubuntu.com/minimal/releases/noble/release-20261103/ubuntu-24.04-minimal-cloudimg-amd64.img',260112384,expected);image.chmod(0o400)
 admission('before-extraction');prefix=ROOT/'prefix';prefix.mkdir()
 env=dict(os.environ);env['TMPDIR']=str(ROOT/'tmp');Path(env['TMPDIR']).mkdir()
