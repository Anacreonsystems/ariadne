    if guest in seen_hashes:assert seen_hashes[guest]==data
    else:seen_hashes[guest]=data;record('FIRST_GUEST_HTTP',guest=guest,qemu_pid=c['pid'],identity=data,artifact_sha256=roundtrip['artifact_sha256'])
    OBS[guest].append(time.monotonic())
   except (OSError,ValueError):all_current=False
  if len(seen_hashes)==2:
   assert seen_hashes[0]['boot_id_hash']!=seen_hashes[1]['boot_id_hash']
   assert seen_hashes[0]['machine_id_hash']!=seen_hashes[1]['machine_id_hash']
  if all_current and len(seen_hashes)==2:
   if overlap_start is None:overlap_start=time.monotonic();record('BOTH_GUEST_HTTP_OVERLAP_BEGIN')
   if time.monotonic()-overlap_start>=30:break
  else:overlap_start=None
  time.sleep(1)
 record('BOTH_GUEST_HTTP_OVERLAP_PROVEN',seconds=time.monotonic()-overlap_start,observations={str(k):len(v) for k,v in OBS.items()})
 stop_child(VMS[0],'deliberate-provider-stop-while-peer-live')
 assert VMS[1]['process'].poll() is None
 with opener.open(f"http://127.0.0.1:{VMS[1]['port']}/identity",timeout=3) as resp:assert json.loads(resp.read(4096))==seen_hashes[1]
 record('SURVIVING_GUEST_HTTP_AFTER_PEER_EXACT_STOP',guest=1)
 stop_child(VMS[1],'final-owned-cleanup')
 return {'guest_identities':seen_hashes,'http_overlap_seconds':time.monotonic()-overlap_start,'http_observation_counts':{str(k):len(v) for k,v in OBS.items()},'body_hashes_verified':21,'status':'PASS_BOOT_ONLY_DISCOVERY'}

result={'status':'UNPROVEN'}
try:result=main()
except BaseException as e:
 record('ATTEMPT_ERROR',error_type=type(e).__name__,error=str(e));result={'status':'UNPROVEN','error_type':type(e).__name__,'error':str(e)}
finally:
