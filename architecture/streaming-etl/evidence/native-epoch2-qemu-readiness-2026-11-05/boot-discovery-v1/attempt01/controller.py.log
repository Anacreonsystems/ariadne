 entry=next(l.split() for l in section.splitlines() if l.endswith(' main/binary-amd64/Packages.xz'))
 assert entry[:2]==[hashlib.sha256((META/'Packages.xz').read_bytes()).hexdigest(),str((META/'Packages.xz').stat().st_size)]
 desired=json.loads((META/'uefi-missing-package-closure.json').read_text())['packages'];wanted={r['Package']:r for r in desired};found={}
