import contextlib, hashlib, http.server, json, lzma, os, re, resource, select, shutil, signal, socket, subprocess, sys, threading, time, urllib.request
from pathlib import Path
ROOT=Path('/tmp/ariadne-qemu-boot-discovery-2026-11-05-v1')
META=Path('/workspace/ariadne/architecture/streaming-etl/evidence/native-epoch2-qemu-readiness-2026-11-05/metadata-v1')
MiB=1024**2; GiB=1024**3; CAP=GiB; MEM_STOP=14*GiB
INIT=json.loads((ROOT/'initial-cleanup.json').read_text()); DEADLINE=INIT['attempt_deadline_monotonic']
STOP=threading.Event(); LOCK=threading.RLock(); CHILDREN=[]; VMS=[]; SERVERS=[]; THREADS=[]; EVENTS=[]
START_EVENTS={k:int(v) for k,v in (line.split() for line in Path('/sys/fs/cgroup/memory.events').read_text().splitlines())}
SALT=os.urandom(32).hex(); OBS={0:[],1:[]}; MAX_ALLOC=0; MAX_MEM=0; GUARD_FAILURE=None

def record(kind,**data):
 row={'kind':kind,'monotonic':time.monotonic(),'utc':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),**data}
 with LOCK:
  EVENTS.append(row)
  with (ROOT/'events.jsonl').open('a') as f:f.write(json.dumps(row,sort_keys=True)+'\n')
 return row

def allocated():
 seen=set();total=0
 for directory,dirs,names in os.walk(ROOT):
  for name in names:
   try:s=os.lstat(Path(directory)/name)
   except FileNotFoundError:continue
   key=(s.st_dev,s.st_ino)
   if key not in seen:seen.add(key);total+=s.st_blocks*512
 return total

def identity(pid):
 try:
  s=Path(f'/proc/{pid}/stat').read_text();fields=s[s.rfind(')')+2:].split()
  return {'pid':pid,'start_ticks':int(fields[19]),'ppid':int(fields[1]),'state':fields[0]}
 except (FileNotFoundError,ProcessLookupError):return None

def vm_committed():
 total=0
 for c in VMS:
  if c['process'].poll() is not None:continue
  try:
   line=next(l for l in Path(f"/proc/{c['pid']}/smaps_rollup").read_text().splitlines() if l.startswith('Private_Dirty:'))
   total+=min(int(line.split()[1])*1024,512*MiB)
  except (FileNotFoundError,StopIteration,PermissionError):pass
 return total

def snapshot():
 mem=int(Path('/sys/fs/cgroup/memory.current').read_text());limit=int(Path('/sys/fs/cgroup/memory.max').read_text())
 ev={k:int(v) for k,v in (l.split() for l in Path('/sys/fs/cgroup/memory.events').read_text().splitlines())}
 alloc=allocated();free=os.statvfs(ROOT).f_bavail*os.statvfs(ROOT).f_frsize
 return {'memory_current':mem,'memory_limit':limit,'reserve_bytes':limit-mem,'owned_allocated_bytes':alloc,'tmp_free_bytes':free,'oom':ev['oom'],'oom_kill':ev['oom_kill'],'monotonic_remaining':DEADLINE-time.monotonic(),'vm_private_committed_credit':vm_committed()}

def signal_exact(c,sig):
 current=identity(c['pid'])
 if current is not None and current['start_ticks']==c['start_ticks']:
  signal.pidfd_send_signal(c['pidfd'],sig)

def guard():
 global MAX_ALLOC,MAX_MEM,GUARD_FAILURE
 count=0
 while not STOP.wait(.2):
  try:
   s=snapshot();MAX_ALLOC=max(MAX_ALLOC,s['owned_allocated_bytes']);MAX_MEM=max(MAX_MEM,s['memory_current'])
   reasons=[]
   if s['memory_current']>=MEM_STOP:reasons.append('MEMORY_14GIB')
   if s['reserve_bytes']<2*GiB:reasons.append('RESERVE_BELOW_2GIB')
   if s['owned_allocated_bytes']>=CAP:reasons.append('OWNED_TMP_1GIB')
   if s['oom']>START_EVENTS['oom'] or s['oom_kill']>START_EVENTS['oom_kill']:reasons.append('OOM_DELTA')
   if s['monotonic_remaining']<=0:reasons.append('TOTAL_30MIN')
   if reasons:
    GUARD_FAILURE={'reasons':reasons,'snapshot':s};record('GUARD_BREACH',**GUARD_FAILURE);STOP.set()
    for c in list(CHILDREN):
     with contextlib.suppress(ProcessLookupError):signal_exact(c,signal.SIGKILL)
    return
   count+=1
   if count%25==0:record('RESOURCE_SAMPLE',**s)
  except Exception as e:
   GUARD_FAILURE={'reasons':['WATCHER_ERROR'],'error':type(e).__name__};record('GUARD_BREACH',**GUARD_FAILURE);STOP.set();return

def check():
 if STOP.is_set():raise RuntimeError('RESOURCE_GUARD_STOPPED')
 if time.monotonic()>=DEADLINE:raise RuntimeError('TOTAL_DEADLINE')

def admission(stage):
 check();s=snapshot()
 worst=s['memory_current']+max(0,CAP-s['owned_allocated_bytes'])+GiB+512*MiB-s['vm_private_committed_credit']
 ok=worst<MEM_STOP and s['tmp_free_bytes']>CAP-s['owned_allocated_bytes']+128*MiB
 record('RESOURCE_ADMISSION',stage=stage,conservative_memory_envelope=worst,admitted=ok,**s)
 if not ok:raise RuntimeError('RESOURCE_ADMISSION_REFUSED_'+stage)

def spawn(name,args,env=None,vm=False):
 check();record('COMMAND',name=name,argv=[str(a) for a in args],new_process_group=True)
 p=subprocess.Popen([str(a) for a in args],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,env=env,start_new_session=True)
 c={'name':name,'process':p,'pid':p.pid,'start_ticks':None,'pidfd':None,'vm':vm,'reaped':False}
 CHILDREN.append(c)
 try:
  i=identity(p.pid);assert i is not None;c['start_ticks']=i['start_ticks'];c['pidfd']=os.pidfd_open(p.pid)
  assert identity(p.pid)['start_ticks']==c['start_ticks']
  record('PROCESS_OWNED',name=name,pid=p.pid,start_ticks=c['start_ticks'],pidfd_open=True)
  if vm:VMS.append(c)
  return c
 except BaseException:
  if c['pidfd'] is not None:signal_exact(c,signal.SIGKILL)
  else:p.kill()
  p.wait(timeout=5);c['reaped']=True;raise

def run(name,args,env=None):
 c=spawn(name,args,env);p=c['process'];output=b''
 while True:
  try:output,_=p.communicate(timeout=.2);break
  except subprocess.TimeoutExpired:check()
 c['reaped']=True;record('COMMAND_RESULT',name=name,pid=p.pid,returncode=p.returncode)
 (ROOT/(name+'.log')).write_bytes(output[:MiB])
 if p.returncode:raise RuntimeError('COMMAND_FAILED_'+name)
 return output

def stop_child(c,reason):
 p=c['process']
 if c['reaped']:return
 if p.poll() is None:
  signal_exact(c,signal.SIGTERM)
  try:p.wait(timeout=3)
  except subprocess.TimeoutExpired:signal_exact(c,signal.SIGKILL);p.wait(timeout=5)
 else:p.wait()
 c['reaped']=True
 current=identity(p.pid);gone=current is None or current['start_ticks']!=c['start_ticks']
 record('EXACT_STOP_WAIT',name=c['name'],pid=p.pid,start_ticks=c['start_ticks'],returncode=p.returncode,identity_gone=gone,wait_reaped=True,reason=reason)
 if not gone:raise RuntimeError('STOP_IDENTITY_NOT_GONE')

def fetch(name,url,expected_size,expected_sha):
 check();target=ROOT/name;h=hashlib.sha256();n=0
 record('DOWNLOAD_BEGIN',name=name,url=url,expected_size=expected_size,expected_sha256=expected_sha)
 with urllib.request.urlopen(url,timeout=15) as response,target.open('xb') as out:
  if response.headers.get('Content-Length'):assert int(response.headers['Content-Length'])==expected_size
  while True:
   check();chunk=response.read(256*1024)
   if not chunk:break
   n+=len(chunk);assert n<=expected_size;h.update(chunk);out.write(chunk)
 assert n==expected_size and h.hexdigest()==expected_sha
 record('DOWNLOAD_HASH_VERIFIED',name=name,bytes=n,sha256=h.hexdigest())
 return target

def serial_reader(c):
 out=ROOT/(c['name']+'.serial.log');written=0
 with out.open('xb') as f:
  while True:
   data=c['process'].stdout.readline(8192)
   if not data:break
   text=data.decode('utf-8','replace')
   text=re.sub(r'\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b','[redacted-uuid]',text)
   text=re.sub(r'\b[0-9a-fA-F]{32}\b','[redacted-identity]',text)
   data=text.encode();written+=len(data)
   if written>16*MiB:STOP.set();record('LOG_CAP_BREACH',name=c['name']);return
   f.write(data);f.flush()

def free_port():
 with socket.socket() as s:s.bind(('127.0.0.1',0));return s.getsockname()[1]

GUEST_SCRIPT='''import hashlib,http.server,json,pathlib\nSALT=bytes.fromhex({salt!r})\nGUEST={guest}\ndef digest(label,path):\n return hashlib.sha256(b"local-qemu-tcg-v1\\0"+label.encode()+b"\\0"+SALT+b"\\0"+pathlib.Path(path).read_bytes().strip()).hexdigest()\nIDENT={{"guest":GUEST,"boot_id_hash":digest("boot-id","/proc/sys/kernel/random/boot_id"),"machine_id_hash":digest("machine-id","/etc/machine-id"),"hash_protocol":"local-qemu-tcg-v1-domain-separated-common-attempt-salt"}}\nclass H(http.server.BaseHTTPRequestHandler):\n def log_message(self,*a):pass\n def do_GET(self):\n  if self.path!="/identity":self.send_error(404);return\n  data=json.dumps(IDENT).encode();self.send_response(200);self.send_header("Content-Length",str(len(data)));self.end_headers();self.wfile.write(data)\n def do_POST(self):\n  n=int(self.headers.get("Content-Length","0"))\n  if self.path!="/roundtrip" or n>4096:self.send_error(400);return\n  data=self.rfile.read(n);out=json.dumps({{**IDENT,"artifact_sha256":hashlib.sha256(data).hexdigest(),"artifact_bytes":len(data)}}).encode();self.send_response(200);self.send_header("Content-Length",str(len(out)));self.end_headers();self.wfile.write(out)\nhttp.server.ThreadingHTTPServer(("0.0.0.0",8080),H).serve_forever()\n'''

def seed_server(guest):
 script=GUEST_SCRIPT.format(salt=SALT,guest=guest)
 user='#cloud-config\npackage_update: false\npackage_upgrade: false\nmanage_etc_hosts: true\nruncmd:\n  - [python3, -c, '+json.dumps(script)+']\n'
 files={'/seed/meta-data':f'instance-id: boot-discovery-{guest}-{SALT[:12]}\nlocal-hostname: guest-{guest}\n'.encode(),'/seed/user-data':user.encode(),'/seed/vendor-data':b'', '/seed/network-config':b'version: 2\nethernets:\n  eth0:\n    match:\n      name: "en*"\n    dhcp4: true\n'}
 class Handler(http.server.BaseHTTPRequestHandler):
  def log_message(self,*a):pass
  def do_GET(self):
   data=files.get(self.path)
   if data is None:self.send_error(404);return
   record('SEED_HTTP_GET',guest=guest,path=self.path,bytes=len(data));self.send_response(200);self.send_header('Content-Length',str(len(data)));self.end_headers();self.wfile.write(data)
 server=http.server.ThreadingHTTPServer(('127.0.0.1',0),Handler);SERVERS.append(server)
 t=threading.Thread(target=server.serve_forever,daemon=True);t.start();THREADS.append(t)
 return server.server_address[1]

def quiet_heavy_check():
 active=[]
 for proc in Path('/proc').iterdir():
  if not proc.name.isdigit():continue
  try:
   comm=(proc/'comm').read_text().strip();i=identity(int(proc.name))
   if i and i['state']!='Z' and any(x in comm.lower() for x in ['pytest','node','npm','vitest','pnpm']):active.append({'pid':int(proc.name),'comm':comm})
  except (FileNotFoundError,PermissionError):continue
 record('LOCAL_HEAVY_CHECK',active=active)
 if active:raise RuntimeError('HEAVY_LOCAL_WORK_ACTIVE')

def main():
 record('BOOT_DISCOVERY_STARTED',scope='kernel_http_exact_stop_only',guest_memory_each=512*MiB,vcpus_each=1,same_physical_host=True,initial_oom=START_EVENTS)
 threading.Thread(target=guard,daemon=True).start();admission('before-download')
 run('verify-debian-signature',['/usr/bin/sqv','--keyring','/usr/share/keyrings/debian-archive-keyring.gpg','--cleartext','--output',ROOT/'Release.authenticated',META/'InRelease'])
 run('verify-ubuntu-signature',['/usr/bin/sqv','--keyring',META/'ubuntu-cloud-pubkey.asc',META/'ubuntu-dated-SHA256SUMS.gpg',META/'ubuntu-dated-SHA256SUMS'])
