 env['LD_LIBRARY_PATH']=str(prefix/'usr/lib/x86_64-linux-gnu')+':'+str(prefix/'usr/lib');env['QEMU_MODULE_DIR']=str(prefix/'usr/lib/x86_64-linux-gnu/qemu')
 qemu=prefix/'usr/bin/qemu-system-x86_64';img=prefix/'usr/bin/qemu-img'
 run('qemu-version',[qemu,'--version'],env);run('qemu-img-version',[img,'--version'],env)
 firmware=prefix/'usr/share/OVMF/OVMF_CODE_4M.fd';variables=prefix/'usr/share/OVMF/OVMF_VARS_4M.fd';assert firmware.exists() and variables.exists()
 (ROOT/'bridge.py').write_text('import os,select,socket,sys,time\ns=socket.create_connection(("127.0.0.1",int(sys.argv[1])),timeout=10);s.settimeout(None)\nend=time.monotonic()+30\nwhile time.monotonic()<end:\n r,_,_=select.select([0,s],[],[],1)\n for f in r:\n  b=os.read(0,65536) if f==0 else s.recv(65536)\n  if not b:sys.exit(0)\n  s.sendall(b) if f==0 else os.write(1,b)\n')
 ports=[]
 for guest in range(2):
  quiet_heavy_check();admission('before-guest-'+str(guest));seed=seed_server(guest);port=free_port();ports.append(port)
  overlay=ROOT/f'guest{guest}.qcow2';run('create-overlay-'+str(guest),[img,'create','-f','qcow2','-F','qcow2','-b',image,overlay,'8G'],env)
  var=ROOT/f'guest{guest}-vars.fd';shutil.copyfile(variables,var)
  net=f'user,id=n0,restrict=on,hostfwd=tcp:127.0.0.1:{port}-:8080,guestfwd=tcp:10.0.2.100:80-cmd:{sys.executable} {ROOT}/bridge.py {seed}'
  args=[qemu,'-name',f'owned-boot-discovery-{guest}','-machine','q35,accel=tcg','-cpu','max','-smp','1','-m','512','-display','none','-serial','stdio','-monitor','none','-no-reboot','-L',prefix/'usr/share/qemu','-drive',f'if=pflash,format=raw,readonly=on,file={firmware}','-drive',f'if=pflash,format=raw,file={var}','-drive',f'if=virtio,format=qcow2,file={overlay}','-netdev',net,'-device','virtio-net-pci,netdev=n0','-smbios',f'type=1,serial=ds=nocloud-net;s=http://10.0.2.100/seed/']
  launcher=[sys.executable,'-c','import os,resource,sys;resource.setrlimit(resource.RLIMIT_FSIZE,(256*1024**2,256*1024**2));os.execv(sys.argv[1],sys.argv[1:])',*map(str,args)]
  c=spawn('guest'+str(guest),launcher,env,vm=True);c['guest']=guest;c['port']=port;c['seed_port']=seed
  t=threading.Thread(target=serial_reader,args=(c,),daemon=True);t.start();THREADS.append(t)
  record('GUEST_ASSOCIATION',guest=guest,qemu_pid=c['pid'],qemu_start_ticks=c['start_ticks'],hostfwd_bind='127.0.0.1',hostfwd_port=port,seed_bind='127.0.0.1',seed_port=seed,restrict_on=True,guest_network_egress='none except owned bounded seed HTTP guestfwd')
 admission('two-guest-overlap-start');overlap_start=None;seen_hashes={}
 opener=urllib.request.build_opener(urllib.request.ProxyHandler({}))
 while True:
  check();all_current=True
