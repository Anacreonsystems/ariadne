"""The worker declaration protocol remains independent in client/server wheels."""

import pytest
from pydantic import ValidationError

from prefect.client.schemas import native_deployments as client_schemas
from prefect.server.schemas import native_deployments as server_schemas


@pytest.mark.parametrize(
    "name",
    [
        "NativeStreamDeclaration",
        "NativeStreamWorkerEnrollRequest",
        "NativeStreamWorkerEnrollment",
        "NativeStreamProcessRegistrationRequest",
        "NativeStreamLaunchProjection",
        "NativeStreamDeploymentPlan",
        "NativeStreamTaskProjection",
        "NativeStreamFiniteProjection",
        "NativeStreamFlowProjection",
        "NativeStreamRecoveryCandidate",
        "NativeStreamLaunchHeartbeatRequest",
        "NativeStreamLaunchHeartbeat",
        "NativeStreamReplacementAuthorizeRequest",
        "NativeStreamReplacementAuthorization",
        "NativeStreamProcessDeathWitness",
        "NativeStreamReplacementConfirmRequest",
        "NativeStreamControlRequest",
        "NativeStreamControlResult",
        "NativeStreamUnstartedRetireRequest",
        "NativeStreamCancelFinalizeRequest",
        "NativeStreamVerifiedRetireRequest",
    ],
)
def test_native_deployment_wire_models_match(name: str):
    assert (
        getattr(client_schemas, name).model_json_schema()
        == getattr(server_schemas, name).model_json_schema()
    )


@pytest.mark.parametrize(
    "profile", ["bounded-linear-v1", "partitioned-fixed-v1", "partitioned-dag-v1"]
)
def test_declared_profiles_keep_the_same_secret_free_wire(profile: str):
    payload = {
        "profile": profile,
        "flow_version": "v1",
        "flow_code_digest": "a" * 64,
        "resource_profile": "bounded-default-v1",
        "flow_retries": 2,
    }
    client = client_schemas.NativeStreamDeclaration.model_validate(payload)
    server = server_schemas.NativeStreamDeclaration.model_validate(payload)
    assert client.model_dump(mode="json") == server.model_dump(mode="json")
    assert set(client.model_dump()) == {
        "schema_version",
        "protocol_version",
        "profile",
        "flow_version",
        "flow_code_digest",
        "resource_profile",
        "flow_retries",
        "flow_retry_delay_seconds",
    }


def test_undeclared_native_profiles_remain_refused():
    with pytest.raises(ValidationError):
        client_schemas.NativeStreamDeclaration.model_validate(
            {
                "profile": "unbounded-future-profile",
                "flow_version": "v1",
                "flow_code_digest": "a" * 64,
                "resource_profile": "bounded-default-v1",
                "flow_retries": 2,
            }
        )


def _declaration(profile: str, retries: object) -> dict[str, object]:
    return {
        "profile": profile,
        "flow_version": "v1",
        "flow_code_digest": "a" * 64,
        "resource_profile": "bounded-default-v1",
        "flow_retries": retries,
    }


@pytest.mark.parametrize("retries", [0, 1, 63])
def test_dag_declaration_accepts_exact_retry_bounds(retries: int):
    wire = _declaration("partitioned-dag-v1", retries)
    server = server_schemas.NativeStreamDeclaration.model_validate(wire)
    client = client_schemas.NativeStreamDeclaration.model_validate_json(server.model_dump_json())
    assert client.flow_retries == retries
    assert client.model_dump_json() == server.model_dump_json()


@pytest.mark.parametrize("profile", ["bounded-linear-v1", "partitioned-fixed-v1"])
def test_legacy_profiles_still_refuse_zero_flow_retries(profile: str):
    for schema in (client_schemas, server_schemas):
        with pytest.raises(ValidationError, match="Zero Flow retries"):
            schema.NativeStreamDeclaration.model_validate(_declaration(profile, 0))


@pytest.mark.parametrize("profile", ["bounded-linear-v1", "partitioned-fixed-v1", "partitioned-dag-v1"])
@pytest.mark.parametrize("retries", [-1, 64, True, False, 0.0, 1.0, "0", "1", None])
def test_all_profiles_refuse_invalid_or_coerced_retry_count(profile: str, retries: object):
    for schema in (client_schemas, server_schemas):
        with pytest.raises(ValidationError):
            schema.NativeStreamDeclaration.model_validate(_declaration(profile, retries))


@pytest.mark.parametrize("profile", ["bounded-linear-v1", "partitioned-fixed-v1"])
@pytest.mark.parametrize("delay,encoded", [(None, "null"), (0.25, "0.25")])
def test_legacy_minimum_retry_declaration_json_bytes_remain_exact(profile: str, delay: float | None, encoded: str):
    expected = (
        '{"schema_version":1,"protocol_version":1,"profile":"' + profile
        + '","flow_version":"v1","flow_code_digest":"' + "a" * 64
        + '","resource_profile":"bounded-default-v1","flow_retries":1,"flow_retry_delay_seconds":'
        + encoded + '}'
    ).encode()
    for schema in (client_schemas, server_schemas):
        declaration = schema.NativeStreamDeclaration.model_validate(_declaration(profile, 1) | {"flow_retry_delay_seconds": delay})
        assert declaration.model_dump_json().encode() == expected
