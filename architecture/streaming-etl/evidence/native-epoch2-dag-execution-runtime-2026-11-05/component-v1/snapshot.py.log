import hashlib,json,sys
from pathlib import Path
root=Path('/workspace/ariadne')
owned=[
'src/prefect/_internal/stream_dag_execution.py','src/prefect/_internal/stream_routed_storage.py','src/prefect/_internal/stream_dag.py','src/prefect/_internal/stream_engine.py','src/prefect/task_engine.py','src/prefect/flow_engine.py','src/prefect/utilities/engine/__init__.py',
 'tests/test_stream_dag_execution.py','tests/test_stream_dag_bootstrap.py','tests/test_stream_route_terminals.py','tests/test_stream_dag_dependencies.py','tests/test_stream_dag_authoring.py','tests/test_native_stream_dag_http.py','tests/test_native_stream_dag_execution_http.py']
evidence=Path('/tmp/native-ni012-runtime-component-v1')
phase=sys.argv[1]
items={}
for name in owned:
 b=(root/name).read_bytes();items[name]={'sha256':hashlib.sha256(b).hexdigest(),'bytes':len(b)}
 if phase=='before':
  target=evidence/'source'/f'{name}.log';target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(b)
all_python={str(p.relative_to(root)):hashlib.sha256(p.read_bytes()).hexdigest() for p in (root/'src/prefect').rglob('*.py') if '__pycache__' not in str(p)}
(evidence/f'source-{phase}.json').write_text(json.dumps({'owned':items,'all_prefect_python':all_python},indent=2,sort_keys=True)+'\n')
if phase=='after':
 before=json.loads((evidence/'source-before.json').read_text())
 drift={'owned':[p for p,v in items.items() if v!=before['owned'].get(p)],'all_prefect_python':[p for p,v in all_python.items() if v!=before['all_prefect_python'].get(p)]}
 (evidence/'drift.json').write_text(json.dumps(drift,indent=2)+'\n')
 print(json.dumps(drift))
