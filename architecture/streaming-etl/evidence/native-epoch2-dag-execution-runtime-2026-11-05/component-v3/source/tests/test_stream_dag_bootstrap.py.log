"""Pure own-bootstrap storage/event contracts; no public DAG execution claim."""

import copy
import inspect
from typing import Any
from uuid import uuid4

import httpx
import pytest

from prefect._internal.stream_execution import (
    DAGSubtaskExecutionContext,
    stream_subtask_execution_context,
)
from prefect._internal.stream_routed_storage import PrefectRoutedStreamStorage
from prefect._internal.stream_subtask_entrypoint import PhysicalStreamExecutionStopped
from prefect.client.schemas.stream_dag_executions import StreamDAGSubtaskBootstrap
from prefect.client.schemas.stream_subtasks import StreamSubtaskEventResult
from prefect.client.schemas.streams import ConsumerBinding, SourceBinding
from prefect.client.stream_storage import PrefectStreamStorage
from prefect.states import Running
from prefect.streams import StreamProtocolError
from prefect.utilities.engine import (
    aemit_dag_task_event,
    build_task_run_state_change_event,
    emit_dag_task_event,
)
from tests.client.test_stream_dag_executions import bootstrap as bootstrap_wire


def owned_storage(source: bool = False, keyed: bool = True):
    wire = bootstrap_wire()
    if source:
        wire["assignment"]["input_stream_id"] = None
        wire["assignment"]["manifest"].update(role="SOURCE", protocol="source-v1")
        wire["input"] = None
        wire["input_key"] = None
    wire["context"]["has_keyed_outgoing"] = keyed
    bootstrap = StreamDAGSubtaskBootstrap.model_validate(wire)
    storage = PrefectRoutedStreamStorage.from_bootstrap(
        bootstrap, api_url="http://prefect.test/api"
    )
    grant, row = bootstrap.grant, bootstrap.assignment
    execution = DAGSubtaskExecutionContext(
        flow_run_id=bootstrap.flow_run_id,
        graph_revision_id=row.graph_revision_id,
        assignment_epoch=row.assignment_epoch,
        subtask_id=row.id,
        grant_id=grant.id,
        physical_epoch=grant.physical_epoch,
        holder_id=grant.holder_id,
        scope_digest=grant.scope_digest,
        manifest_digest=row.manifest.manifest_digest,
        task_run_id=bootstrap.task_run.id,
        input_stream_id=row.input_stream_id,
        output_stream_id=row.output_stream_id,
        child_process_id=grant.child_process_id,
        process_start_ticks=grant.process_start_ticks,
        api_url=storage.api_url,
        capability="c" * 64,
        event_private_key=b"s" * 32,
    )
    binding_source = SourceBinding(
        flow_run_id=bootstrap.flow_run_id,
        stream_id=row.output_stream_id,
        task_run_id=bootstrap.task_run.id,
        owner_id=grant.holder_id,
        attempt=2,
        owner_epoch=1,
    )
    binding_consumer = ConsumerBinding(
        flow_run_id=bootstrap.flow_run_id,
        consumer_id=bootstrap.input.subscriber_id if bootstrap.input else uuid4(),
        input_stream_id=row.input_stream_id or uuid4(),
        output_stream_id=row.output_stream_id,
        owner_id=grant.holder_id,
        attempt=2,
        owner_epoch=1,
    )
    return storage, bootstrap, execution, binding_source, binding_consumer


def test_storage_inheritance_matrix_classifies_every_base_coroutine():
    base = {
        name
        for name, value in vars(PrefectStreamStorage).items()
        if inspect.iscoroutinefunction(value)
    }
    assert base == {
        "_dispatch",
        "_request",
        "create_stream",
        "reserve_output",
        "register_task_run",
        "reject_output",
        "open_consumer",
        "read",
        "complete",
        "finish_consumer",
        "fail_task_output",
        "finish",
        "open_source",
        "append_source",
        "close_source",
        "status",
        "read_prefix",
    }
    assert base <= vars(PrefectRoutedStreamStorage).keys()


def test_from_bootstrap_is_detached_metadata_and_requires_exact_current_scope():
    storage, bootstrap, execution, _, binding = owned_storage()
    original = storage.route_context
    object.__setattr__(bootstrap.context, "operator_uid", "changed")
    assert storage.route_context == original
    with pytest.raises(StreamProtocolError, match="scoped bootstrap"):
        storage._binding(binding)
    with stream_subtask_execution_context(execution):
        storage._binding(binding)
        with pytest.raises(StreamProtocolError, match="subscriber"):
            storage._binding(binding.model_copy(update={"consumer_id": uuid4()}))
    assert "capability" not in repr(storage) and "event_private_key" not in repr(
        storage
    )
    assert bootstrap.parameters not in [storage.route_context.model_dump()]


@pytest.mark.parametrize(
    "field",
    [
        "graph_revision_id",
        "grant_id",
        "holder_id",
        "task_run_id",
        "subtask_id",
        "input_stream_id",
        "output_stream_id",
        "physical_epoch",
        "manifest_digest",
        "api_url",
        "child_process_id",
        "process_start_ticks",
    ],
)
def test_storage_refuses_changed_current_grant_before_transport(field: str):
    from dataclasses import replace

    storage, _, execution, _, binding = owned_storage()
    old = getattr(execution, field)
    value = (
        old + 1
        if type(old) is int
        else (
            "d" * 64
            if field == "manifest_digest"
            else "http://other.test"
            if field == "api_url"
            else uuid4()
        )
    )
    with stream_subtask_execution_context(replace(execution, **{field: value})):
        with pytest.raises(StreamProtocolError, match="differs"):
            storage._binding(binding)


@pytest.mark.parametrize(
    "method,args",
    [
        ("create_stream", ("bad",)),
        ("reserve_output", ("bad", uuid4())),
        ("register_task_run", (None, None)),
        ("reject_output", ("bad", uuid4(), "failure")),
        ("fail_task_output", ("bad", uuid4(), 2, "failure")),
        ("finish", ("bad",)),
        ("read_prefix", ("bad", 1)),
        ("_request", ("read_task_run",)),
        ("_dispatch", ("read_task_run",)),
    ],
)
async def test_every_unowned_legacy_operation_refuses_before_transport(
    method: str, args: tuple[Any, ...]
):
    storage, _, _, _, _ = owned_storage()
    with pytest.raises(StreamProtocolError):
        await getattr(storage, method)(*args)


@pytest.mark.parametrize("asynchronous", [False, True])
@pytest.mark.parametrize("accepted", [False, True])
async def test_event_unknown_ack_reuses_exact_event_without_task_get(
    asynchronous: bool, accepted: bool
):
    _, bootstrap, execution, _, _ = owned_storage()
    state = Running()
    state.state_details.task_run_id = bootstrap.task_run.id
    state.state_details.flow_run_id = bootstrap.flow_run_id
    with stream_subtask_execution_context(execution):
        event = build_task_run_state_change_event(
            bootstrap.task_run, bootstrap.task_run.state, state
        )
    calls = []

    def send(**kwargs: Any):
        calls.append(copy.deepcopy(kwargs))
        if len(calls) == 1:
            kwargs["event"]["payload"].clear()
            raise httpx.ReadTimeout("unknown ACK")
        return StreamSubtaskEventResult(
            event_id=event.id,
            accepted=accepted,
            task_run_id=bootstrap.task_run.id,
            run_count=bootstrap.task_run.run_count,
            state_type=state.type,
        )

    class Sync:
        emit_stream_subtask_event = staticmethod(send)

    class Async:
        async def emit_stream_subtask_event(self, **kwargs: Any):
            return send(**kwargs)

    with stream_subtask_execution_context(execution):
        if accepted:
            result = (
                await aemit_dag_task_event(Async(), event)
                if asynchronous
                else emit_dag_task_event(Sync(), event)
            )
            assert result.id == event.id
        else:
            with pytest.raises(PhysicalStreamExecutionStopped):
                if asynchronous:
                    await aemit_dag_task_event(Async(), event)
                else:
                    emit_dag_task_event(Sync(), event)
    assert len(calls) == 2 and calls[0] == calls[1]


@pytest.mark.parametrize("asynchronous", [False, True])
@pytest.mark.parametrize("accepted", [False, True])
async def test_real_task_engine_selects_dag_event_transport_and_fences_refusal(
    asynchronous: bool, accepted: bool
):
    from prefect import task
    from prefect.task_engine import AsyncTaskRunEngine, SyncTaskRunEngine

    _, bootstrap, execution, _, _ = owned_storage()

    @task(persist_result=False)
    def body():
        raise AssertionError("Only the actual state-event seam is under test")

    calls = []

    def send(**kwargs: Any):
        calls.append(copy.deepcopy(kwargs))
        return StreamSubtaskEventResult(
            event_id=kwargs["event"]["id"],
            accepted=accepted,
            task_run_id=bootstrap.task_run.id,
            run_count=bootstrap.task_run.run_count,
            state_type="RUNNING",
        )

    class Sync:
        emit_stream_subtask_event = staticmethod(send)

    class Async:
        async def emit_stream_subtask_event(self, **kwargs: Any):
            return send(**kwargs)

    engine = (AsyncTaskRunEngine if asynchronous else SyncTaskRunEngine)(
        task=body, task_run=bootstrap.task_run
    )
    engine._is_started = True
    engine._client = Async() if asynchronous else Sync()
    state = Running()
    with stream_subtask_execution_context(execution):
        if accepted:
            event = (
                await engine._aemit_state_event(bootstrap.task_run.state, state)
                if asynchronous
                else engine._emit_state_event(bootstrap.task_run.state, state)
            )
            assert str(event.id) == calls[0]["event"]["id"]
        else:
            with pytest.raises(PhysicalStreamExecutionStopped):
                if asynchronous:
                    await engine._aemit_state_event(bootstrap.task_run.state, state)
                else:
                    engine._emit_state_event(bootstrap.task_run.state, state)
            assert engine._physical_transport_failed is True
    assert len(calls) == 1
    assert calls[0]["subtask_id"] == execution.subtask_id
    assert (
        calls[0]["event"]["resource"]["prefect.resource.id"]
        == f"prefect.task-run.{bootstrap.task_run.id}"
    )


@pytest.mark.parametrize("asynchronous", [False, True])
async def test_failed_task_finalizer_never_calls_legacy_failure_or_finish(
    asynchronous: bool, monkeypatch: pytest.MonkeyPatch
):
    from types import SimpleNamespace

    from prefect._internal.stream_engine import (
        _StreamRun,
        finish_stream_async,
        finish_stream_sync,
    )
    from prefect.states import Failed
    from prefect.streams import Stream

    storage, bootstrap, execution, _, _ = owned_storage()
    calls = []

    async def request(*args: Any, **kwargs: Any):
        calls.append((args, kwargs))
        raise AssertionError("Failure is owned by the already-accepted signed event")

    monkeypatch.setattr(PrefectRoutedStreamStorage, "_dispatch", request)
    run = _StreamRun(
        Stream(storage, str(bootstrap.output.stream_id)), bootstrap.task_run
    )
    engine = SimpleNamespace(
        parameters={"__prefect_stream_run__": run},
        state=Failed(),
        logger=SimpleNamespace(warning=lambda *args: calls.append("warning")),
    )
    with stream_subtask_execution_context(execution):
        if asynchronous:
            await finish_stream_async(engine)
        else:
            finish_stream_sync(engine)
    assert calls == []


@pytest.mark.parametrize("source", [False, True])
def test_child_factory_owns_exact_task_stream_and_partition_metadata(source: bool):
    from prefect._internal.stream_engine import create_dag_stream_task_run

    storage, bootstrap, _, _, _ = owned_storage(source=source)
    run = create_dag_stream_task_run(bootstrap, storage)
    assert run.task_run is bootstrap.task_run
    assert run.output.storage is storage
    assert run.output.stream_id == str(bootstrap.output.stream_id)
    assert run.output.producer_task_run_id == bootstrap.task_run.id
    assert run.registration_verified is True and run.source is source
    assert run.partition.index == bootstrap.assignment.subtask_index
    assert run.partition.count == bootstrap.operator_parallelism
    assert run.partition.operator_uid == bootstrap.assignment.operator_uid
    assert run.partition.assignment_epoch == bootstrap.assignment.assignment_epoch
