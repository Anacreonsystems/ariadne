import hashlib
import json
import os
from pathlib import Path

dag = "tests/test_native_stream_dag_execution_http.py::"
p2 = "tests/test_native_partitioned_stream_http.py::"
required = {
    dag + "test_public_dag_lifecycle_two_real_workers_postgres[" + case + "]"
    for case in ("False-normal", "True-normal", "False-preview", "False-failure", "False-cancel")
}
required.update(
    dag + "test_public_dag_preseal_failure_two_real_workers_postgres[" + case + "]"
    for case in ("False", "True")
)
required.update(
    dag + "test_public_dag_bounded_volume_postgres[" + case + "]"
    for case in ("False-500", "True-500", "False-5000", "True-5000")
)
required.update(
    dag + "test_public_dag_branch_recovery_postgres[" + case + "]"
    for case in ("False-accepted200", "False-incomplete200", "True-accepted200", "True-incomplete200")
)
required.update(
    dag + "test_public_dag_exchange_modes_postgres[" + case + "]"
    for case in ("rebalance", "keyed")
)
required.update(
    p2 + "test_actual_process_worker_runs_four_partition_tasks[" + case + "]"
    for case in ("5000-none-False", "5000-none-True")
)
collected = [
    line.strip()
    for line in Path("native-runtime-collection.log").read_text().splitlines()
    if line.startswith((dag, p2))
]
assert collected, "Native runtime collection was empty"
assert len(collected) == len(set(collected)), "Native runtime nodes were duplicated"
nodes = [node for node in collected if node.startswith(dag) or "[5000-" in node]
assert not required.difference(nodes), f"Required native runtime cases missing: {required.difference(nodes)}"
assert not any("sqlite" in node for node in nodes)
assert len(nodes) <= 64, "Review runner capacity before expanding the native runtime matrix"
nodes.sort(key=lambda node: ("5000" in node, "exchange_modes_postgres" not in node))
matrix = {
    "include": [
        {"node": node, "id": hashlib.sha256(node.encode()).hexdigest()[:12]}
        for node in nodes
    ]
}
Path("native-runtime-matrix.json").write_text(json.dumps(matrix, indent=2) + "\n")
with Path(os.environ["GITHUB_OUTPUT"]).open("a") as output:
    output.write("cases=" + json.dumps(matrix, separators=(",", ":")) + "\n")
print(f"All {len(nodes)} required native runtime cases have their own job")