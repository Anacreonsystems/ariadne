import ast
from pathlib import Path

def span(t,name):
 tree=ast.parse(t)
 f=next(x for x in tree.body if isinstance(x,ast.AsyncFunctionDef) and x.name==name)
 lines=t.splitlines(keepends=True)
 return sum(map(len,lines[:f.lineno-1])),sum(map(len,lines[:f.end_lineno]))

