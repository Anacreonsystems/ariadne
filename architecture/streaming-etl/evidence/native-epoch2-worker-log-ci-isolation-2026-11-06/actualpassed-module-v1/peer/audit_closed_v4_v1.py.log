"""Offline-only stdlib review; never imports or executes the diagnostic harness."""
import ast
import datetime
import hashlib
import json
import pathlib
import xml.etree.ElementTree as ET

OUT = pathlib.Path(__file__).parent
BASE = pathlib.Path('/tmp/worker-logging-ci-diagnosis-d906-v1/pg17-module-acceptance-v4')
TRIAL = BASE / 'trial-ae0da266'
ROOT = pathlib.Path('/workspace/ariadne')
TEST_SHA = 'b8fb7f17a015147cf4032e74065308027af3a6393cab55cc9653cff1ca02d246'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load(path):
    return json.loads(path.read_text())


def bind(path):
    return {'path': str(path), 'sha256': sha(path), 'bytes': path.stat().st_size}


def main():
    receipt_path = TRIAL / 'receipt.json'
    assert sha(receipt_path) == 'ea72182d6781b2a5dc3a3ac7764f9e8969913bbc8c0a302295d121a074c444d0'
    manifest = TRIAL / 'result-assets.sha256'
    assert sha(manifest) == 'a74bee54518247208674ab4d32d1b085ef5bb39f78fb846c8b8d9d4dde5f5b6b'
    manifest_count = 0
    for line in manifest.read_text().splitlines():
        expected, path_string = line.split('  ', 1)
        path = pathlib.Path(path_string)
        assert path.parent == TRIAL and sha(path) == expected
        manifest_count += 1
    receipt = load(receipt_path)
    assert receipt['status'] == 'WHOLE_LOGGING_MODULE151_PASS'
    assert receipt['pytest_exit'] == 0 and receipt['actual_exit_persisted_before_metadata'] is True
    assert receipt['runtime_STOPPED'] is True and receipt['harness_errors'] == []
    assert receipt['timed_out'] is False and receipt['timeout_stop_events'] == []
    assert (TRIAL / 'pytest-exit').read_text().strip() == '0'
    assert load(TRIAL / 'pytest-exit.json') == {'actual_popen_wait_returncode': 0, 'persisted_before_metadata_or_reaping': True}
    before = load(TRIAL / 'source-before.json')
    assert before == load(TRIAL / 'source-after.json') and len(before) == 1756
    for name, expected in before.items():
        assert sha(ROOT / name) == expected, name
    for name in ['src/prefect/_build_info.py', 'src/prefect/_internal/analytics/_config.py']:
        assert name in before
    assert before['tests/test_logging.py'] == sha(ROOT / 'tests/test_logging.py') == TEST_SHA
    imports = []
    for path in sorted((TRIAL / 'audit').glob('*.jsonl')):
        for line in path.read_text().splitlines():
            row = json.loads(line)
            relative = str(pathlib.Path(row['path']).relative_to(ROOT))
            assert relative in before and row['source_sha256'] == before[relative]
            imports.append(row)
    assert len(imports) == 1216 and receipt['import_audit'] == {'rows': 1216, 'mismatches': []}
    assets = load(TRIAL / 'external-assets.json')
    for name, expected in assets.items():
        assert sha(BASE / name) == expected
    collection = load(TRIAL / 'collection.json')
    nodeids = collection['nodeids']
    assert collection['count'] == len(nodeids) == len(set(nodeids)) == 151
    assert nodeids[0] == 'tests/cli/test_config.py::test_view_prefers_canonical_dot_env_value_over_alias'
    assert all(node.startswith('tests/test_logging.py::') for node in nodeids[1:])
    xml = ET.parse(TRIAL / 'pytest.xml').getroot()
    suite = xml.find('testsuite')
    assert suite is not None and [suite.get(key) for key in ['tests', 'failures', 'errors', 'skipped']] == ['151', '0', '0', '0']
    cases = suite.findall('testcase')
    assert len(cases) == 151
    for node, case in zip(nodeids, cases):
        parts = node.split('::')
        classname = parts[0][:-3].replace('/', '.') + ('.' + '.'.join(parts[1:-1]) if len(parts) > 2 else '')
        assert case.get('name') == parts[-1] and case.get('classname') == classname
        assert not any(case.find(tag) is not None for tag in ['failure', 'error', 'skipped'])
    expected_methods = {
        'test_worker_logger_sends_log_to_api_worker_when_connected_to_cloud',
        'test_worker_logger_does_not_send_logs_when_not_connected_to_cloud',
        'test_self_hosted_registered_worker_keeps_console_logs_without_shipping',
    }
    line_proof = load(TRIAL / 'debug-line-bindings.json')
    assert line_proof['source_sha256'] == TEST_SHA
    tree = ast.parse((ROOT / 'tests/test_logging.py').read_text())
    cls = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == 'TestWorkerLogging')
    actual_lines = {}
    for method in cls.body:
        if isinstance(method, ast.AsyncFunctionDef) and method.name in expected_methods:
            calls = [node for node in ast.walk(method) if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == 'debug']
            assert len(calls) == 1
            actual_lines[method.name] = calls[0].lineno
    assert actual_lines == line_proof['bindings']
    states = [json.loads(line) for line in (TRIAL / 'logger-states.jsonl').read_text().splitlines()]
    emissions = [row for row in states if row['phase'] == 'at_debug_emission']
    assert len(emissions) == 3 and {row['nodeid'].split('::')[-1] for row in emissions} == expected_methods
    for row in emissions:
        assert row['api_logging_enabled'] is True and row['sink_configured'] is False
        assert row['loggers']['prefect']['effective_level'] == row['loggers']['prefect.workers']['effective_level'] == 20
        leaf = [value for key, value in row['loggers'].items() if key not in {'prefect', 'prefect.workers'}]
        assert len(leaf) == 1 and leaf[0]['effective_level'] == leaf[0]['level'] == 10 and leaf[0]['disabled'] is False
        assert 'WorkerAPILogHandler' in row['loggers']['prefect.workers']['handler_classes']
        assert row['cloud'] is row['nodeid'].endswith('test_worker_logger_sends_log_to_api_worker_when_connected_to_cloud')
        after = [value for value in states if value['nodeid'] == row['nodeid'] and value['phase'] == 'after_call']
        assert len(after) == 1 and after[0]['loggers']['prefect']['effective_level'] == 20
    proof = load(TRIAL / 'provisioning-proof.json')
    assert proof['hook_invocations'] == 1 and proof['original_provisioning_body_calls'] == 0
    assert proof['guard_callback_stable_at_sessionfinish'] is True and proof['cached_result_uses_fixture_cache_key'] is True
    assert proof['override_asset_sha256'] == sha(BASE / 'logging_state_plugin.py')
    assert proof['fixture_source_file_sha256'] == before['tests/conftest.py']
    assert proof['precreated_fresh_pg17_allowlist_validated'] is True
    assert proof['scope'] == 'session' and proof['worker_id'] == 'master' and proof['module'] == 'tests.conftest'
    sub = load(TRIAL / 'subreaper-proof.json')
    assert sub['pr_set_child_subreaper'] == sub['pr_get_child_subreaper'] == 1 and sub['waitpid_preflight_echild'] is True
    assert sub['runner_source_sha256'] == sha(BASE / 'runner.py')
    assert sub['subreaper_support_source_sha256'] == sha(BASE / 'support.py')
    reaping = load(TRIAL / 'reaping-proof.json')
    assert reaping['direct_child_wait_first']['popen_wait_completed'] is True and reaping['direct_child_wait_first']['returncode'] == 0
    assert reaping['adopted']['waitpid_echild_success'] is True
    assert reaping['adopted']['adopted_reaped'] == [] and reaping['timeout_stop_events'] == []
    assert reaping['adopted']['proc_children_interface_used'] is False and reaping['adopted']['prior_pid1_orphan_touched'] is False
    closure = load(TRIAL / 'post-runner-closure.json')
    assert closure['actual_pytest_exit_persisted'] == closure['launcher_tool_exit'] == 0
    assert closure['all_five_new_identities_gone'] is True and closure['remaining_same_identities'] == []
    assert len(closure['pid_start_pairs_including_runner_and_parent']) == 5
    remaining = []
    for pid, ticks in closure['pid_start_pairs_including_runner_and_parent'].items():
        try:
            stat = pathlib.Path('/proc', str(pid), 'stat').read_text().rsplit(')', 1)[1].split()
            if stat[19] == str(ticks): remaining.append({'pid': pid, 'state': stat[0]})
        except FileNotFoundError:
            pass
    assert remaining == []
    database = load(TRIAL / 'database-closure.json')
    assert database['database'] == 'native_ni012_runtime_w4_a86d3381'
    assert database['sessions'] == [] and database['retained'] is True
    assert database['drop_requested'] is False and database['force_used'] is False
    public_root = ['runner.py', 'support.py', 'logging_state_plugin.py', 'startup-template.py.txt', 'README.md', 'binding.json', 'assets.sha256']
    public_trial = ['command.json', 'database-creation.json', 'database-closure.json', 'original-provisioning-binding.json', 'external-assets.json', 'source-before.json', 'source-after.json', 'process.json', 'process-closure.json', 'post-runner-closure.json', 'subreaper-proof.json', 'reaping-proof.json', 'provisioning-proof.json', 'collection.json', 'debug-line-bindings.json', 'logger-states.jsonl', 'pytest-exit', 'pytest-exit.json', 'pytest.log', 'pytest.xml', 'receipt.json', 'summary.md', 'result-assets.sha256']
    paths = [BASE / name for name in public_root] + [TRIAL / name for name in public_trial]
    paths += sorted((TRIAL / 'audit').glob('*.jsonl'))
    paths += [OUT / 'readonly-review-v1.json', pathlib.Path(__file__)]
    result = {
        'schema': 'principal-worker-logging-v4-closed-file-review-v1',
        'recorded_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'reviewer': '/root/etl_principal_recovery2',
        'verdict': 'APPROVE_TEST_ONLY_FIX_STATIC_AND_CLOSED151_RUNTIME_EVIDENCE_VALID',
        'source_head': receipt['head'], 'candidate_test_sha256': TEST_SHA,
        'actual_author_execution': {'cases': 151, 'seconds': suite.get('time'), 'failures': 0, 'errors': 0, 'skips': 0, 'pytest_exit': 0, 'tool_exit': 0, 'harness_errors': [], 'timeout_stop_events': []},
        'independent_file_checks': {'declared_result_hashes': manifest_count, 'source_hashes_including_generated_beforebound': 1756, 'import_rows': 1216, 'ordered_collection_JUnit_case_pairs': 151, 'exact_AST_bound_DEBUG_traces': 3, 'runtime_PID_start_pairs': 3, 'PID_start_pairs_including_runner_and_parent_personally_gone': 5, 'provisioning_override_calls': 1, 'original_destructive_provisioning_body_calls': 0},
        'emission_observations': emissions,
        'assertion_evidence': 'Exact b8 source plus actual151 JUnit PASS verifies unchanged Cloud one-send/worker-ID assertions and both new actual-record/zero-send negative assertions including durable native worker_id. Diagnostic plugin reads source-bound trace frames and yields actual test calls; it does not replace debug/send/assertions.',
        'restore_scope': 'Actual after_call parentPrefect INFO20; leaf/handler/disable restoration follows verified pytest caplog.at_level finally and prior16case controlled restore probe. V4 does not directly sample each leaf after its context.',
        'database_closure_observed_by_author': database,
        'static_provisioning_scope': 'Only exact session/master generate_test_database_connection_url replaced with owned PG17 URI/cache key, stable original-body guard. Real migration/API/client/DB/test fixtures otherwise execute; no claim that all DB statements were traced.',
        'artifacts': [bind(path) for path in paths],
        'limits': [
            'Independent file-only reconciliation of author actual151 execution, not personal Principal151 rerun',
            'Historical CI gw0 test order/cause remains unproven',
            'Baseline two generated paths lacked before bindings; v4 before1756 fixes v4 provenance only, never retroactively rewrites baseline',
            'V2 guard exit143/noJUnit remains INCONCLUSIVE; V3 selected7 bodyPASS with wrapper UNKNOWN/post-wait metadata failure remains separately qualified',
            'Prior dead orphan384983/start14778279 PPID1 remains separate unresolved operational artifact; not inspected, reclassified or signaled here',
            'No old orphan/PID1 signal, no new test/runtime/DB/probe/hook execution or harness import',
            'No production logging/default/Cloud policy change; exactly3existing test methods changed as staticreview e03e proved',
            'No epoch2/fullNI2-014/fullregression/hosted-gate credit from this bounded local component evidence',
        ],
        'new_project_imports': 0, 'new_runtime_bodies': 0, 'new_DB_connections': 0,
        'repository_or_original_artifact_changes': 0, 'all_own_readers': 'STOP',
    }
    destination = OUT / 'closed-v4-file-review-v1.json'
    with destination.open('x') as handle:
        json.dump(result, handle, sort_keys=True, indent=2)
        handle.write('\n')
    destination.chmod(0o600)
    print(json.dumps({'receipt': str(destination), 'sha256': sha(destination), 'verdict': result['verdict'], 'cases': 151, 'source_hashes': 1756, 'imports': 1216}))


if __name__ == '__main__':
    main()
