+async def _projection(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    subtask: orm_models.StreamPhysicalSubtask,
+) -> s.StreamSubtaskProjection:
+    operator = await session.get(db.StreamOperatorRun, subtask.operator_run_id)
+    manifest = await session.get(db.StreamSubmission, subtask.submission_id)
+    assert operator is not None and manifest is not None
+    return s.StreamSubtaskProjection(
+        id=subtask.id,
+        graph_revision_id=subtask.graph_revision_id,
+        operator_run_id=subtask.operator_run_id,
+        operator_uid=operator.operator_uid,
+        subtask_index=subtask.subtask_index,
+        assignment_epoch=subtask.assignment_epoch,
+        input_stream_id=subtask.input_stream_id,
+        manifest=NativeStreamStore._submission_response(manifest),
+        current_grant_id=subtask.current_grant_id,
+        physical_epoch=subtask.physical_epoch,
+    )
