+        session.add(limit)
+        await session.flush()
+        limit_id = limit.id
+    _, plan = await admit(db, plan, credentials)
+    subtask, _, grant, scoped = await claim_registered(db, plan, credentials)
+    await record_bulk_task_run_events(
+        [task_event(plan, subtask, grant, tags=("shared",)).receive()]
+    )
