+async def admit_region(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph_id: UUID,
+    request: s.StreamRegionAdmissionRequest,
+    execution: StreamExecutionCredentials | None,
+) -> s.StreamGraphPlan:
+    await _backend(session, db)
+    graph = await _graph(session, db, graph_id, execution, update=True)
+    _, _, request_digest = _canonical(request.model_dump(mode="json"))
+    if graph.graph_digest != request.graph_digest:
+        raise NativeStreamError("IDENTITY_CONFLICT", "Graph digest mismatch")
+    if graph.admission_operation_id is not None:
+        if (
+            graph.admission_operation_id != request.operation_id
+            or graph.admission_request_digest != request_digest
+        ):
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT", "Region admission has another operation"
+            )
+        return await graph_plan(session, db, graph)
+    subtasks = (
+        await session.scalars(
+            sa.select(db.StreamPhysicalSubtask)
+            .where(db.StreamPhysicalSubtask.graph_revision_id == graph.id)
+            .order_by(db.StreamPhysicalSubtask.id)
+        )
+    ).all()
+    tasks = {
+        task.id: task
+        for task in (
+            await session.scalars(
+                sa.select(db.TaskRun).where(
+                    db.TaskRun.id.in_([s.task_run_id for s in subtasks])
+                )
+            )
+        ).all()
+    }
+    tags = {tag for task in tasks.values() for tag in task.tags}
+    if (
+        tags
+        and await session.scalar(
+            sa.select(db.ConcurrencyLimit.id)
+            .where(db.ConcurrencyLimit.tag.in_(tags))
+            .limit(1)
+        )
+        is not None
+    ):
+        raise NativeStreamError(
+            "UNSUPPORTED_PROFILE",
+            "Legacy tag concurrency limits require explicit migration",
+        )
+    limits = (
+        await session.scalars(
+            sa.select(db.ConcurrencyLimitV2)
+            .where(db.ConcurrencyLimitV2.name.in_([f"tag:{tag}" for tag in tags]))
+            .order_by(db.ConcurrencyLimitV2.id)
+            .with_for_update()
+            .execution_options(populate_existing=True)
+        )
+    ).all()
+    active = {str(limit.name): limit for limit in limits if limit.active}
+    counts = Counter(
+        f"tag:{tag}"
+        for task in tasks.values()
+        for tag in set(task.tags)
+        if f"tag:{tag}" in active
+    )
+    for name, limit in active.items():
+        if limit.slot_decay_per_second != 0:
+            raise NativeStreamError(
+                "UNSUPPORTED_PROFILE", "Physical region cannot use decaying tag limits"
+            )
+        if limit.limit <= 0 or limit.active_slots + counts[name] > limit.limit:
+            raise NativeStreamError(
+                "REGION_CAPACITY",
+                "Runnable physical region exceeds available concurrency",
+            )
+    for name, count in counts.items():
+        active[name].active_slots += count
+    for subtask in subtasks:
+        for tag in set(tasks[subtask.task_run_id].tags):
+            limit = active.get(f"tag:{tag}")
+            if limit is not None:
+                session.add(
+                    db.StreamSubtaskAllocation(
+                        subtask_id=subtask.id,
+                        concurrency_limit_id=limit.id,
+                        released=False,
+                    )
+                )
+    graph.state = "ADMITTED"
+    graph.admission_operation_id = request.operation_id
+    graph.admission_request_digest = request_digest
+    await session.flush()
+    return await graph_plan(session, db, graph)
+
+
+async def activate_graph(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    graph_id: UUID,
+    request: s.StreamGraphActivateRequest,
+    execution: StreamExecutionCredentials | None,
+) -> s.StreamGraphPlan:
+    graph = await _graph(session, db, graph_id, execution, update=True)
+    _, _, digest = _canonical(request.model_dump(mode="json"))
+    if graph.graph_digest != request.graph_digest:
+        raise NativeStreamError("IDENTITY_CONFLICT", "Activation graph digest mismatch")
+    if graph.activation_operation_id is not None:
+        if (
+            graph.activation_operation_id != request.operation_id
+            or graph.activation_request_digest != digest
+        ):
+            raise NativeStreamError(
+                "IDENTITY_CONFLICT", "Graph activation operation drift"
+            )
+        return await graph_plan(session, db, graph)
+    plan = await graph_plan(session, db, graph)
+    if (
+        graph.state != "ADMITTED"
+        or [item.current_grant_id for item in plan.subtasks] != request.grant_ids
+    ):
+        raise NativeStreamError(
+            "METADATA_NOT_READY",
+            "Activation requires the complete current physical region",
+        )
+    grants = (
+        await session.scalars(
+            sa.select(db.StreamSubtaskGrant)
+            .where(db.StreamSubtaskGrant.id.in_(request.grant_ids))
+            .order_by(db.StreamSubtaskGrant.id)
+            .with_for_update()
+            .execution_options(populate_existing=True)
+        )
+    ).all()
+    if len(grants) != 4 or any(grant.state != "REGISTERED" for grant in grants):
+        raise NativeStreamError(
+            "METADATA_NOT_READY",
+            "Every physical process must be registered before activation",
+        )
+    graph.activation_operation_id = request.operation_id
+    graph.activation_request_digest = digest
+    graph.startup_completed_at = now("UTC")
+    await session.flush()
+    return await graph_plan(session, db, graph)
+
