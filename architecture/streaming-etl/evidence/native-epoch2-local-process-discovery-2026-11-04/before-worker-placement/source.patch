+    *,
+    run_count: int = 1,
+    state_type: str = "RUNNING",
+    name: str = "Running",
+    tags: tuple[str, ...] = (),
+    retriable: bool | None = None,
+) -> Event:
+    timestamp = now("UTC")
+    event_id = uuid4()
+    payload = {
+        "name": "documents[0]",
+        "task_key": "source-key",
+        "task_version": "task-v1",
+        "dynamic_key": subtask.manifest.dynamic_key,
+        "empirical_policy": {"retries": 2},
