@@ -0,0 +1,768 @@
+"""Trusted coordinator for the finite, same-host fixed-P2 process profile."""
+
+from __future__ import annotations
+
+# This module deliberately composes private task, storage and runner interfaces.
+# pyright: reportPrivateUsage=false
+import concurrent.futures
+import inspect
+import json
+import os
+import re
+import secrets
+import shutil
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+from contextvars import copy_context
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+from uuid import NAMESPACE_URL, UUID, uuid5
+
+from prefect._internal.stream_code import NativeTaskCodeError, native_task_code_identity
+from prefect._internal.stream_execution import get_stream_execution
+from prefect.cache_policies import NO_CACHE
+from prefect.client.orchestration._streams.client import StreamRequestError
+from prefect.client.schemas.objects import TaskRunPolicy
+from prefect.client.schemas.stream_subtasks import StreamOperatorSpec
+from prefect.client.stream_storage import PrefectStreamStorage
+from prefect.context import FlowRunContext, TagsContext, TaskRunContext
+from prefect.futures import PrefectConcurrentFuture
+from prefect.runner._native_process import NativePidfdScope, verify_native_process_death
+from prefect.runner._starter_native import NativeProcessStarter, linux_process_identity
+from prefect.streams import (
+    PartitionedStream,
+    SourceRunResult,
+    Stream,
+    StreamPartitionCall,
+    StreamProtocolError,
+    StreamRunResult,
+    StreamSourceConfig,
+    StreamTaskConfig,
+)
+from prefect.utilities.asyncutils import run_coro_as_sync
+
+
+def validate_partitioned_task(task: Any) -> None:
+    """Refuse unsupported task options before metadata or task user code."""
+    config = task.stream
+    if not isinstance(config, (StreamSourceConfig, StreamTaskConfig)):
+        raise StreamProtocolError("Partitioned submission requires a stream task")
+    config.__post_init__()
+    config.validate_function(task.fn)
+    if (
+        task.cache_policy != NO_CACHE
+        or task.cache_key_fn is not None
+        or task.persist_result is not False
+        or task.result_storage is not None
+        or task.result_storage_key is not None
+        or task.result_serializer is not None
+        or task.cache_expiration is not None
+        or task.refresh_cache is not None
+        or task.retry_condition_fn is not None
+        or task.on_commit_hooks
+        or task.on_rollback_hooks
+        or task.on_running_hooks
+        or task.on_completion_hooks
+        or task.on_failure_hooks
+        or task.asset_deps
+        or task.task_run_name is not None
+    ):
+        raise StreamProtocolError(
+            "The fixed-P2 profile does not support caching, result persistence, custom retry conditions, hooks or assets"
+        )
+
+
+def bind_partition_calls(
+    task: Any,
+    partitions: tuple[StreamPartitionCall, StreamPartitionCall],
+) -> list[dict[str, Any]]:
+    """Bind strict snapshots without invoking user code or allocating metadata."""
+    if (
+        type(partitions) is not tuple
+        or len(partitions) != 2
+        or any(type(partition) is not StreamPartitionCall for partition in partitions)
+    ):
+        raise StreamProtocolError(
+            "Exactly two explicit StreamPartitionCall values are required"
+        )
+    validate_partitioned_task(task)
+    config = task.stream
+    excluded = {config.context}
+    if isinstance(config, StreamTaskConfig):
+        excluded.add(config.input)
+    signature = inspect.signature(task.fn)
+    signature = signature.replace(
+        parameters=[
+            parameter
+            for name, parameter in signature.parameters.items()
+            if name not in excluded
+        ]
+    )
+    snapshots = []
+    for partition in partitions:
+        values = partition.parameters
+        if excluded.intersection(values):
+            raise StreamProtocolError(
+                "Injected context and stream input are not partition parameters"
+            )
+        try:
+            bound = signature.bind(**values)
+            bound.apply_defaults()
+        except TypeError as exc:
+            raise StreamProtocolError(
+                "Partition parameters do not match the task signature"
+            ) from exc
+        snapshots.append(
+            StreamPartitionCall(parameters=dict(bound.arguments)).parameters
+        )
+    if isinstance(config, StreamSourceConfig) and (
+        not all(snapshots) or snapshots[0] == snapshots[1]
+    ):
+        raise StreamProtocolError(
+            "A source requires two distinct nonempty bound split snapshots"
+        )
+    return snapshots
+
+
+def subtask_environment(home: Path, api_url: str) -> dict[str, str]:
+    """Drop inherited platform credentials and profile providers before import."""
+    environment = {
+        key: value
+        for key, value in os.environ.items()
+        if not key.startswith("PREFECT_")
+    }
+    environment.update(
+        {
+            "PREFECT_API_URL": api_url,
+            "PREFECT_HOME": str(home),
+            "PREFECT_PROFILES_PATH": str(home / "profiles.toml"),
+            "PREFECT_LOGGING_TO_API_ENABLED": "false",
+            "PREFECT_SERVER_ALLOW_EPHEMERAL_MODE": "false",
+        }
+    )
+    return environment
+
+
+@dataclass
+class _Child:
+    assignment: Any
+    grant: Any
+    capability: str
+    private_key: bytes
+    process: subprocess.Popen[bytes]
+    scope: NativePidfdScope
+    bootstrap_fd: int
+    home: Path
+    completion: concurrent.futures.Future[Any]
+
+
+class PartitionedStreamReconstruction:
+    """Own exactly four task processes and their stable server assignments."""
+
+    profile = "partitioned-fixed-v1"
+
+    def __init__(self, execution: Any, flow_run: Any, flow: Any) -> None:
+        self.execution = execution
+        self.flow_run = flow_run
+        self.flow = flow
+        self.flow_attempt = flow_run.run_count
+        self.phase = "OPEN"
+        self.admission_attempted = False
+        self.lock = threading.RLock()
+        self.ready = threading.Event()
+        self.entries: dict[str, Any] = {}
+        self.finite_entries: dict[str, Any] = {}
+        self.handles: list[PartitionedStream[Any]] = []
+        self.specifications: list[dict[str, Any]] = []
+        self.children: list[_Child] = []
+        self.plan: Any = None
+        self._monitor: threading.Thread | None = None
+        self._stopping = threading.Event()
+        self._go_read = -1
+        self._go_write = -1
+        self._activated = False
+        self.storage = PrefectStreamStorage(execution.flow_run_id, execution.api_url)
+
+    def request(self, method: str, **kwargs: Any) -> Any:
+        return run_coro_as_sync(self.storage._request(method, **kwargs))
+
+    def declare(
+        self,
+        task: Any,
+        *,
+        operator_uid: str,
+        partitions: tuple[StreamPartitionCall, StreamPartitionCall],
+        upstream: PartitionedStream[Any] | None,
+    ) -> PartitionedStream[Any]:
+        snapshots = bind_partition_calls(task, partitions)
+        if type(operator_uid) is not str or not re.fullmatch(
+            r"[A-Za-z0-9_.-]{1,64}", operator_uid
+        ):
+            raise StreamProtocolError("An explicit stable operator_uid is required")
+        if not task.version or not self.flow.version:
+            raise StreamProtocolError(
+                "Partitioned tasks and flows require explicit versions"
+            )
+        try:
+            identity = native_task_code_identity(task.fn)
+        except NativeTaskCodeError as exc:
+            raise StreamProtocolError(str(exc)) from exc
+        module = inspect.getmodule(task.fn)
+        if (
+            module is None
+            or not module.__file__
+            or vars(module).get(task.fn.__name__) is not task
+        ):
+            raise StreamProtocolError(
+                "Physical tasks require their exact module-level Task binding"
+            )
+        entrypoint = f"{Path(module.__file__).resolve()}:{task.fn.__name__}"
+        source = isinstance(task.stream, StreamSourceConfig)
+        with self.lock:
+            if self.phase != "OPEN" or len(self.specifications) >= 2:
+                raise StreamProtocolError(
+                    "The fixed graph accepts one source and one operator"
+                )
+            if operator_uid in self.entries:
+                raise StreamProtocolError("operator_uid must be unique in the graph")
+            if source:
+                if self.specifications or upstream is not None:
+                    raise StreamProtocolError("The fixed graph begins with one source")
+            elif (
+                not self.specifications
+                or upstream is not self.handles[0]
+                or len(self.specifications) != 1
+            ):
+                raise StreamProtocolError(
+                    "The operator requires this graph's source handle"
+                )
+            spec = StreamOperatorSpec(
+                operator_uid=operator_uid,
+                role="SOURCE" if source else "OPERATOR",
+                task_name=task.name,
+                task_key=identity.task_key,
+                task_version=task.version,
+                artifact_digest=identity.artifact_digest,
+                entrypoint=entrypoint,
+                parameters=snapshots,
+                input_key=None if source else task.stream.input,
+                context_key=task.stream.context,
+                upstream_operator_uid=None
+                if source
+                else self.specifications[0]["operator_uid"],
+                task_policy=TaskRunPolicy(
+                    retries=task.retries,
+                    retry_delay=task.retry_delay_seconds,
+                    retry_jitter_factor=task.retry_jitter_factor,
+                ),
+                timeout_seconds=task.timeout_seconds,
+                tags=sorted(set(task.tags) | TagsContext.get().current_tags),
+            )
+            handle: PartitionedStream[Any] = PartitionedStream(_ready=self.ready)
+            self.entries[operator_uid] = task
+            self.specifications.append(spec.model_dump(mode="json"))
+            self.handles.append(handle)
+            if not source:
+                self.seal()
+            return handle
+
+    def seal(self) -> None:
+        with self.lock:
+            if self.phase == "READY":
+                return
+            if self.phase != "OPEN" or len(self.specifications) != 2:
+                raise StreamProtocolError(
+                    "The partitioned graph requires its operator declaration"
+                )
+            try:
+                self.admission_attempted = True
+                self.plan = self.request(
+                    "seal_stream_graph",
+                    flow_run_id=self.flow_run.id,
+                    operation_id=uuid5(NAMESPACE_URL, f"fixed-p2/{self.flow_run.id}"),
+                    flow_version=self.flow.version,
+                    deployment_id=self.flow_run.deployment_id,
+                    deployment_version=self.flow_run.deployment_version,
+                    operators=self.specifications,
+                )
+                self.plan = self.request(
+                    "admit_stream_region",
+                    graph_revision_id=self.plan.id,
+                    operation_id=uuid5(self.plan.id, "admit"),
+                    graph_digest=self.plan.graph_digest,
+                )
+                self._go_read, self._go_write = os.pipe()
+                for index, spec in enumerate(self.specifications):
+                    assignments = sorted(
+                        [
+                            item
+                            for item in self.plan.subtasks
+                            if item.operator_uid == spec["operator_uid"]
+                        ],
+                        key=lambda item: item.subtask_index,
+                    )
+                    physical = []
+                    for assignment in assignments:
+                        completion: concurrent.futures.Future[Any] = (
+                            concurrent.futures.Future()
+                        )
+                        stream = Stream(
+                            self.storage,
+                            str(assignment.manifest.stream_id),
+                            producer_task_run_id=assignment.manifest.task_run_id,
+                        )
+                        stream._bind_completion(
+                            PrefectConcurrentFuture(
+                                assignment.manifest.task_run_id, completion
+                            )
+                        )
+                        child = self._spawn(assignment, completion)
+                        self.children.append(child)
+                        physical.append(stream)
+                    self.handles[index]._bind((physical[0], physical[1]))
+                # No child receives authority until every registration succeeded.
+                for child in self.children:
+                    self._release_bootstrap(child)
+                os.close(self._go_read)
+                self._go_read = -1
+                grants = {
+                    child.assignment.id: child.grant.id for child in self.children
+                }
+                self.plan = self.request(
+                    "activate_stream_graph",
+                    graph_revision_id=self.plan.id,
+                    operation_id=uuid5(self.plan.id, "activate"),
+                    graph_digest=self.plan.graph_digest,
+                    grant_ids=[grants[item.id] for item in self.plan.subtasks],
+                )
+                self._activated = True
+                # One atomic PIPE_BUF-sized release: never a partial per-child GO.
+                if os.write(self._go_write, b"GGGG") != 4:
+                    raise StreamProtocolError(
+                        "Physical startup GO was not delivered atomically"
+                    )
+                os.close(self._go_write)
+                self._go_write = -1
+                self.phase = "READY"
+                self.ready.set()
+                context = copy_context()
+                self._monitor = threading.Thread(
+                    target=context.run, args=(self._supervise,), daemon=True
+                )
+                self._monitor.start()
+            except BaseException:
+                self.abort()
+                raise
+
+    def _spawn(
+        self,
+        assignment: Any,
+        completion: concurrent.futures.Future[Any],
+        grant: Any = None,
+        credentials: tuple[UUID, str, bytes, str] | None = None,
+        go_read_fd: int | None = None,
+    ) -> _Child:
+        credentials = credentials or NativeProcessStarter._credentials()
+        holder, capability, _, public = credentials
+        host, boot, ticks = linux_process_identity(os.getpid())
+        if grant is None:
+            arguments: dict[str, Any] = {
+                "launcher_binding_kind": "FLOW_AUTHORITY_LOCAL"
+            }
+            if self.flow_run.deployment_id is not None:
+                plan = self.request(
+                    "read_native_stream_deployment_plan", flow_run_id=self.flow_run.id
+                )
+                arguments = {
+                    "launcher_binding_kind": "DEPLOYMENT",
+                    "worker_id": plan.current_launch.worker_id,
+                    "work_pool_id": plan.work_pool_id,
+                }
+            grant = self.request(
+                "claim_stream_subtask",
+                subtask_id=assignment.id,
+                operation_id=uuid5(assignment.id, "claim"),
+                graph_digest=self.plan.graph_digest,
+                holder_id=holder,
+                capability=capability,
+                event_public_key=public,
+                host_id=host,
+                boot_id=boot,
+                launcher_process_id=os.getpid(),
+                launcher_start_ticks=ticks,
+                **arguments,
+            )
+        child = self._start_blocked(
+            assignment,
+            completion,
+            credentials,
+            self._go_read if go_read_fd is None else go_read_fd,
+        )
+        child.grant = grant
+        try:
+            self._register(child)
+            return child
+        except BaseException:
+            self._discard_child(child)
+            raise
+
+    def _register(self, child: _Child) -> None:
+        _, _, start_ticks = linux_process_identity(child.process.pid)
+        child.grant = self.request(
+            "register_stream_subtask_process",
+            subtask_id=child.assignment.id,
+            operation_id=uuid5(child.grant.id, "register"),
+            grant_id=child.grant.id,
+            child_process_id=child.process.pid,
+            process_start_ticks=start_ticks,
+        )
+
+    def _start_blocked(
+        self,
+        assignment: Any,
+        completion: concurrent.futures.Future[Any],
+        credentials: tuple[UUID, str, bytes, str],
+        go_read_fd: int,
+    ) -> _Child:
+        _, capability, private, _ = credentials
+        read_fd, write_fd = os.pipe()
+        home = Path(tempfile.mkdtemp(prefix="prefect-physical-"))
+        process = None
+        scope = None
+        try:
+            process = subprocess.Popen(
+                [
+                    sys.executable,
+                    "-m",
+                    "prefect._internal.stream_subtask_entrypoint",
+                    str(read_fd),
+                    str(go_read_fd),
+                ],
+                pass_fds=(read_fd, go_read_fd),
+                env=subtask_environment(home, self.execution.api_url),
+            )
+            os.close(read_fd)
+            read_fd = -1
+            scope = NativePidfdScope(process.pid)
+            return _Child(
+                assignment,
+                None,
+                capability,
+                private,
+                process,
+                scope,
+                write_fd,
+                home,
+                completion,
+            )
+        except BaseException:
+            if process is not None:
+                process.kill()
+                process.wait()
+            if scope is not None:
+                scope.close()
+            os.close(write_fd)
+            shutil.rmtree(home)
+            raise
+        finally:
+            if read_fd >= 0:
+                os.close(read_fd)
+
+    @staticmethod
+    def _discard_child(child: _Child) -> None:
+        if child.bootstrap_fd >= 0:
+            os.close(child.bootstrap_fd)
+            child.bootstrap_fd = -1
+        child.scope.hard_kill(child.process.pid)
+        child.process.wait()
+        child.scope.close()
+        shutil.rmtree(child.home, ignore_errors=True)
+
+    def _release_bootstrap(self, child: _Child) -> None:
+        assignment, grant = child.assignment, child.grant
+        payload = {
+            "flow_run_id": str(self.flow_run.id),
+            "graph_revision_id": str(self.plan.id),
+            "assignment_epoch": 1,
+            "subtask_id": str(assignment.id),
+            "grant_id": str(grant.id),
+            "physical_epoch": grant.physical_epoch,
+            "holder_id": str(grant.holder_id),
+            "scope_digest": grant.scope_digest,
+            "manifest_digest": assignment.manifest.manifest_digest,
+            "task_run_id": str(assignment.manifest.task_run_id),
+            "input_stream_id": str(assignment.input_stream_id)
+            if assignment.input_stream_id
+            else None,
+            "output_stream_id": str(assignment.manifest.stream_id),
+            "child_process_id": grant.child_process_id,
+            "process_start_ticks": grant.process_start_ticks,
+            "api_url": self.execution.api_url,
+            "capability": child.capability,
+            "event_private_key": child.private_key.hex(),
+        }
+        with os.fdopen(child.bootstrap_fd, "wb") as pipe:
+            child.bootstrap_fd = -1
+            pipe.write(json.dumps(payload, separators=(",", ":")).encode())
+
+    def _supervise(self) -> None:
+        try:
+            renewed = time.monotonic()
+            while not self._stopping.wait(0.05):
+                pending = False
+                for index, child in enumerate(self.children):
+                    if child.completion.done():
+                        continue
+                    status = child.process.poll()
+                    if status is None:
+                        pending = True
+                        if time.monotonic() - renewed >= 15:
+                            self.request(
+                                "renew_stream_subtask",
+                                subtask_id=child.assignment.id,
+                                grant_id=child.grant.id,
+                            )
+                        continue
+                    task_run = self.request(
+                        "read_task_run",
+                        task_run_id=child.assignment.manifest.task_run_id,
+                    )
+                    if task_run.state is not None and task_run.state.is_completed():
+                        info = self.request(
+                            "read_stream", stream_id=child.assignment.manifest.stream_id
+                        )
+                        if (
+                            info.state != "COMPLETED"
+                            or info.id != child.assignment.manifest.stream_id
+                            or info.flow_run_id != self.flow_run.id
+                        ):
+                            raise StreamProtocolError(
+                                "Completed TaskRun has no matching durable EOF"
+                            )
+                        child.completion.set_result(
+                            SourceRunResult(
+                                task_run.id, str(info.id), info.producer_position
+                            )
+                            if child.assignment.manifest.role == "SOURCE"
+                            else StreamRunResult(str(task_run.id), str(info.id))
+                        )
+                        child.scope.close()
+                        shutil.rmtree(child.home)
+                    elif task_run.state is not None and task_run.state.is_final():
+                        info = self.request(
+                            "read_stream", stream_id=child.assignment.manifest.stream_id
+                        )
+                        if info.state == "OPEN":
+                            self.request(
+                                "fail_stream_source"
+                                if child.assignment.manifest.role == "SOURCE"
+                                else "fail_stream_task_output",
+                                flow_run_id=self.flow_run.id,
+                                stream_id=child.assignment.manifest.stream_id,
+                                task_run_id=task_run.id,
+                                attempt=task_run.run_count,
+                                error="Physical task reached its recorded terminal failure",
+                            )
+                        child.completion.set_exception(
+                            StreamProtocolError(
+                                f"Physical task ended in {task_run.state.name}"
+                            )
+                        )
+                        child.scope.close()
+                        shutil.rmtree(child.home)
+                    else:
+                        pending = True
+                        self.children[index] = self._replace(child)
+                if time.monotonic() - renewed >= 15:
+                    renewed = time.monotonic()
+                if not pending:
+                    return
+        except BaseException as exc:
+            for child in self.children:
+                if not child.completion.done():
+                    child.completion.set_exception(exc)
+            self.abort()
+
+    def _replace(self, child: _Child) -> _Child:
+        host, boot, _ = linux_process_identity(os.getpid())
+        challenge = secrets.token_hex(32)
+        operation = uuid5(child.grant.id, "replacement")
+        candidate = self.request(
+            "authorize_stream_subtask_replacement",
+            subtask_id=child.assignment.id,
+            operation_id=operation,
+            expected_grant_id=child.grant.id,
+            expected_physical_epoch=child.grant.physical_epoch,
+            host_id=host,
+            challenge_capability=challenge,
+        )
+        witness = verify_native_process_death(candidate, terminate=False)
+        task_run = self.request(
+            "read_task_run", task_run_id=child.assignment.manifest.task_run_id
+        )
+        info = self.request(
+            "read_stream", stream_id=child.assignment.manifest.stream_id
+        )
+        if (
+            info.state != "OPEN"
+            or task_run.run_count >= (task_run.empirical_policy.retries or 0) + 1
+            or child.grant.physical_epoch >= 64
+            or task_run.state is not None
+            and (task_run.state.is_failed() or task_run.state.is_crashed())
+            and task_run.state.state_details.retriable is False
+        ):
+            return self._retire(child, operation, challenge, witness)
+        credentials = NativeProcessStarter._credentials()
+        holder, capability, _, public = credentials
+        go_read, go_write = os.pipe()
+        replacement = None
+        try:
+            replacement = self._start_blocked(
+                child.assignment,
+                child.completion,
+                credentials,
+                go_read,
+            )
+            _, _, start_ticks = linux_process_identity(replacement.process.pid)
+            try:
+                replacement.grant = self.request(
+                    "confirm_stream_subtask_replacement",
+                    subtask_id=child.assignment.id,
+                    operation_id=operation,
+                    challenge_capability=challenge,
+                    death_witness=witness,
+                    new_holder_id=holder,
+                    new_capability=capability,
+                    new_event_public_key=public,
+                    new_child_process_id=replacement.process.pid,
+                    new_process_start_ticks=start_ticks,
+                    host_id=host,
+                    boot_id=boot,
+                )
+            except StreamRequestError as refusal:
+                if refusal.code not in {
+                    "TERMINAL_RECONCILIATION_REQUIRED",
+                    "RETRY_EXHAUSTED",
+                }:
+                    raise
+                self._discard_child(replacement)
+                replacement = None
+                return self._retire(child, operation, challenge, witness)
+            self._release_bootstrap(replacement)
+            if os.write(go_write, b"G") != 1:
+                raise StreamProtocolError("Physical replacement GO was not delivered")
+        except BaseException:
+            if replacement is not None:
+                self._discard_child(replacement)
+            raise
+        finally:
+            os.close(go_read)
+            os.close(go_write)
+        child.scope.close()
+        shutil.rmtree(child.home)
+        return replacement
+
+    def _retire(
+        self, child: _Child, operation: UUID, challenge: str, witness: dict[str, Any]
+    ) -> _Child:
+        outcome = self.request(
+            "retire_verified_stream_subtask",
+            subtask_id=child.assignment.id,
+            operation_id=operation,
+            challenge_capability=challenge,
+            death_witness=witness,
+            error="Verified physical process death reached a terminal invocation",
+        )
+        if outcome.task_state == "COMPLETED":
+            info = self.request(
+                "read_stream", stream_id=child.assignment.manifest.stream_id
+            )
+            child.completion.set_result(
+                SourceRunResult(
+                    child.assignment.manifest.task_run_id,
+                    str(info.id),
+                    info.producer_position,
+                )
+                if child.assignment.manifest.role == "SOURCE"
+                else StreamRunResult(
+                    str(child.assignment.manifest.task_run_id), str(info.id)
+                )
+            )
+        else:
+            child.completion.set_exception(
+                StreamProtocolError("Physical task exhausted its retry budget")
+            )
+        child.scope.close()
+        shutil.rmtree(child.home)
+        return child
+
+    def finish(self) -> None:
+        self.seal()
+        failures: list[Exception] = []
+        for handle in self.handles:
+            try:
+                handle.wait()
+            except Exception as exc:
+                failures.append(exc)
+        if self._monitor is not None:
+            self._monitor.join()
+        if failures:
+            raise failures[0]
+
+    def abort(self) -> None:
+        self._stopping.set()
+        self.phase = "ABORTED"
+        for name in ("_go_read", "_go_write"):
+            descriptor = getattr(self, name)
+            if descriptor >= 0:
+                os.close(descriptor)
+                setattr(self, name, -1)
+        for child in self.children:
+            if child.bootstrap_fd >= 0:
+                os.close(child.bootstrap_fd)
+                child.bootstrap_fd = -1
+            child.scope.hard_kill(child.process.pid)
+        for child in self.children:
+            child.process.wait()
+            child.scope.close()
+            shutil.rmtree(child.home, ignore_errors=True)
+        if self.plan is not None and not self._activated:
+            self.request(
+                "abort_stream_graph",
+                graph_revision_id=self.plan.id,
+                operation_id=uuid5(self.plan.id, "abort"),
+                graph_digest=self.plan.graph_digest,
+                error="Physical startup did not cross the activation barrier",
+            )
+
+
+def submit_partitioned_stream(
+    task: Any,
+    *,
+    operator_uid: str,
+    partitions: tuple[StreamPartitionCall, StreamPartitionCall],
+    upstream: PartitionedStream[Any] | None,
+) -> PartitionedStream[Any]:
+    execution = get_stream_execution()
+    context = FlowRunContext.get()
+    if (
+        execution is None
+        or context is None
+        or context.flow is None
+        or TaskRunContext.get() is not None
+    ):
+        raise StreamProtocolError(
+            "Partitioned submission requires its native Flow coordinator"
+        )
+    graph = getattr(execution, "_reconstruction", None)
+    if not isinstance(graph, PartitionedStreamReconstruction):
+        raise StreamProtocolError(
+            "submit_partitioned_stream requires partitioned-fixed-v1"
+        )
+    return graph.declare(
+        task, operator_uid=operator_uid, partitions=partitions, upstream=upstream
+    )
