+pytestmark = [pytest.mark.clear_db, pytest.mark.service("database")]
+PRIVATE = bytes(range(32))
+PUBLIC = (
+    Ed25519PrivateKey.from_private_bytes(PRIVATE)
+    .public_key()
+    .public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)
