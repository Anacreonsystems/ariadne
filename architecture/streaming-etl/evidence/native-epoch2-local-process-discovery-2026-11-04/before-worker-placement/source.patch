+    physical_epoch: int = Field(ge=1, le=64, strict=True)
+    state: Literal["RETIRED"] = "RETIRED"
+    task_state: Literal["COMPLETED", "FAILED"]
+    outcome_kind: Literal[
+        "COMPLETED_RECONCILED",
+        "FAILED_RECONCILED",
+        "RETRY_EXHAUSTED",
+        "ATTEMPT_LIMIT",
+        "NONRETRIABLE_FAILURE",
+    ]
