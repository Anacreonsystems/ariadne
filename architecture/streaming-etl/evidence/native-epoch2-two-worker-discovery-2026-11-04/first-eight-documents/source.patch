+
+
+class StreamRegionAdmissionRequest(_Wire):
+    operation_id: UUID
+    graph_digest: Digest
+
+
+class StreamGraphActivateRequest(StreamRegionAdmissionRequest):
+    grant_ids: list[UUID] = Field(min_length=4, max_length=4)
+
+
+class StreamGraphAbortRequest(StreamRegionAdmissionRequest):
+    error: str = Field(min_length=1, max_length=4096)
+
+    @field_validator("error")
+    @classmethod
+    def bounded_error(cls, value: str) -> str:
+        if len(value.encode("utf-8")) > 4096:
+            raise ValueError("abort error exceeds 4096 UTF-8 bytes")
+        return value
+
+
+class StreamSubtaskClaimRequest(_Wire):
+    operation_id: UUID
+    graph_digest: Digest
+    assignment_epoch: Literal[1] = 1
+    expected_physical_epoch: Literal[0] = 0
+    holder_id: UUID
+    capability: Capability
+    event_public_key: Digest
+    launcher_binding_kind: Literal[
+        "DEPLOYMENT", "FLOW_AUTHORITY_LOCAL", "ASSIGNED_WORKER"
+    ]
+    worker_id: UUID | None = None
+    work_pool_id: UUID | None = None
+    host_id: UUID
+    boot_id: UUID
+    launcher_process_id: int = Field(ge=1, strict=True)
+    launcher_start_ticks: int = Field(ge=1, strict=True)
+
+    @model_validator(mode="after")
+    def launcher_binding(self) -> Self:
+        if self.launcher_binding_kind in ("DEPLOYMENT", "ASSIGNED_WORKER"):
+            if self.worker_id is None or self.work_pool_id is None:
+                raise ValueError("deployed claim requires worker and work pool")
+        elif self.worker_id is not None or self.work_pool_id is not None:
+            raise ValueError("local authority claim excludes worker and work pool")
+        return self
+
+
+class StreamSubtaskGrant(_Wire):
+    credential_version: Literal["prefect-subtask-v1"] = "prefect-subtask-v1"
+    id: UUID
+    subtask_id: UUID
+    graph_revision_id: UUID
+    assignment_epoch: Literal[1]
+    physical_epoch: int = Field(ge=1, le=64)
+    holder_id: UUID
+    launcher_binding_kind: Literal[
+        "DEPLOYMENT", "FLOW_AUTHORITY_LOCAL", "ASSIGNED_WORKER"
+    ]
+    worker_id: UUID | None = None
+    work_pool_id: UUID | None = None
+    launcher_process_id: int = Field(ge=1, strict=True)
+    launcher_start_ticks: int = Field(ge=1, strict=True)
+    event_key_id: Digest
+    scope_digest: Digest
+    state: Literal["CLAIMED", "REGISTERED", "RETIRED", "RELEASED"]
+    host_id: UUID
+    boot_id: UUID
+    child_process_id: int | None = Field(ge=1)
+    process_start_ticks: int | None = Field(ge=1)
+    created_at: DateTime
+    last_renewed_at: DateTime
+
+    @model_validator(mode="after")
+    def process_identity_shape(self) -> Self:
+        if (self.child_process_id is None) != (self.process_start_ticks is None):
+            raise ValueError("child process identity must be complete")
+        if self.state == "CLAIMED" and self.child_process_id is not None:
+            raise ValueError("CLAIMED has no registered child")
+        if self.state == "REGISTERED" and self.child_process_id is None:
+            raise ValueError("REGISTERED requires exact child process identity")
+        return self
+
+
+class StreamSubtaskCredentials(_Wire):
+    model_config: ClassVar[ConfigDict] = ConfigDict(frozen=True, extra="forbid")
+    grant_id: UUID
+    capability: Capability
+
+
+class StreamSubtaskRegistrationRequest(_Wire):
+    operation_id: UUID
+    grant_id: UUID
+    child_process_id: int = Field(ge=1, strict=True)
+    process_start_ticks: int = Field(ge=1, strict=True)
+
+
+class StreamSubtaskRenewRequest(_Wire):
+    grant_id: UUID
+
+
+class StreamSubtaskBootstrap(_Wire):
+    grant: StreamSubtaskGrant
+    assignment: StreamSubtaskProjection
+    flow_run_id: UUID
+    flow_run_run_count: int = Field(ge=0, strict=True)
+    entrypoint: str
+    context_key: str
+    task_version: str
+    artifact_digest: Digest
+    timeout_seconds: float | None = Field(
+        default=None, gt=0, allow_inf_nan=False, strict=True
+    )
+    task_policy: TaskRunPolicy
+    effective_tags: list[str]
+    parameters: dict[str, JsonValue]
+    input_key: str | None
+    task_run: TaskRun
+    reserved_tag_names: list[str]
+
+    @model_validator(mode="after")
+    def frozen_task_metadata(self) -> Self:
+        if (
+            self.effective_tags != sorted(set(self.effective_tags))
+            or sorted(set(self.task_run.tags)) != self.effective_tags
+            or self.task_run.empirical_policy.model_dump(mode="json")
+            != self.task_policy.model_dump(mode="json")
+            or self.task_run.task_version != self.task_version
+            or self.reserved_tag_names != [f"tag:{tag}" for tag in self.effective_tags]
+            or self.grant.subtask_id != self.assignment.id
+            or self.grant.graph_revision_id != self.assignment.graph_revision_id
+            or self.grant.assignment_epoch != self.assignment.assignment_epoch
+            or self.grant.physical_epoch != self.assignment.physical_epoch
+            or self.grant.id != self.assignment.current_grant_id
+            or self.task_run.id != self.assignment.manifest.task_run_id
+            or self.task_run.flow_run_id != self.flow_run_id
+            or self.assignment.manifest.flow_run_id != self.flow_run_id
+            or self.task_run.flow_run_run_count != self.flow_run_run_count
+        ):
+            raise ValueError(
+                "TaskRun metadata differs from the frozen physical task configuration"
+            )
+        return self
+
+
+class StreamSubtaskReplacementAuthorizeRequest(_Wire):
+    operation_id: UUID
