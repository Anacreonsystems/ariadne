+    )
+
+
+async def record_startup_stop(
+    session: AsyncSession,
+    db: PrefectDBInterface,
+    worker_id: UUID,
+    subtask_id: UUID,
+    request: s.StreamWorkerStartupStopRequest,
+) -> s.StreamGraphStartupStopResult:
+    scope = await _authorize_worker_subtask(
+        session,
+        db,
+        worker_id,
+        subtask_id,
+        request.principal,
