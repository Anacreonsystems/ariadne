+                "operation_id": uuid5(grant.id, "assigned-worker-startup-stop-v1"),
+                "abort_operation_id": item.abort_operation_id,
+                "grant_id": grant.id,
+                "expected_physical_epoch": grant.physical_epoch,
+                "death_witness": witness,
+                "unstarted": witness is None,
+            }
