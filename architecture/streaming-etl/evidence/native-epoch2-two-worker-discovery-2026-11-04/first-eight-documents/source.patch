+def physical_event(execution: SubtaskExecutionContext):
+    initial = Pending()
+    running = Running()
+    run = TaskRun(
+        id=execution.task_run_id,
+        flow_run_id=execution.flow_run_id,
+        name="split-source[0]",
+        task_key="key",
+        dynamic_key="physical/source/0",
+        state=running,
+        run_count=1,
+    )
+    return build_task_run_state_change_event(run, initial, running)
