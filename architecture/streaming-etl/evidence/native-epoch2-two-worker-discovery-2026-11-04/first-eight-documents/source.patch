+    subtask_id: UUID,
+    request: s.StreamWorkerReplacementConfirmRequest,
+) -> s.StreamSubtaskGrant:
+    scope = await _authorize_worker_subtask(
+        session, db, worker_id, subtask_id, request.principal
+    )
+    return await core.confirm_replacement(
