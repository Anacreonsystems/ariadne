+def physical_context() -> SubtaskExecutionContext:
+    return SubtaskExecutionContext(
+        flow_run_id=uuid4(),
+        graph_revision_id=uuid4(),
+        assignment_epoch=1,
+        subtask_id=uuid4(),
+        grant_id=uuid4(),
+        physical_epoch=1,
+        holder_id=uuid4(),
