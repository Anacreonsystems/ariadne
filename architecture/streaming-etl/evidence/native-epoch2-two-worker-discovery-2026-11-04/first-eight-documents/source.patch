+async def placement_workers(
+    session: AsyncSession, db: PrefectDBInterface, flow_run_id: UUID, *, update: bool
+) -> tuple[UUID, UUID]:
+    snapshot = await session.scalar(
+        sa.select(db.NativeStreamDeploymentSnapshot).where(
+            db.NativeStreamDeploymentSnapshot.flow_run_id == flow_run_id
+        )
+    )
+    authority = await session.scalar(
+        sa.select(db.StreamExecutionAuthority).where(
+            db.StreamExecutionAuthority.flow_run_id == flow_run_id
+        )
+    )
+    launch = await session.scalar(
+        sa.select(db.NativeStreamLaunchIdentity).where(
+            db.NativeStreamLaunchIdentity.flow_run_id == flow_run_id,
+            db.NativeStreamLaunchIdentity.generation
+            == (authority.generation if authority else 0),
+            db.NativeStreamLaunchIdentity.state == "PROCESS_REGISTERED",
+        )
+    )
+    if (
+        snapshot is None
+        or snapshot.profile != "partitioned-fixed-v1"
+        or authority is None
+        or launch is None
+    ):
+        raise NativeStreamError(
+            "UNSUPPORTED_PROFILE",
+            "Physical placement requires its current native deployment and registered Flow coordinator",
+        )
+    cutoff = now("UTC") - timedelta(seconds=WORKER_CAPABILITY_FRESHNESS_SECONDS)
+    candidates = list(
+        (
+            await session.scalars(
+                sa.select(db.Worker.id)
+                .join(
+                    db.StreamWorkerCapability,
+                    db.StreamWorkerCapability.worker_id == db.Worker.id,
+                )
+                .where(
+                    db.Worker.work_pool_id == snapshot.work_pool_id,
+                    db.Worker.status == WorkerStatus.ONLINE,
+                    db.StreamWorkerCapability.work_pool_id == snapshot.work_pool_id,
+                    db.StreamWorkerCapability.protocol == "partitioned-fixed-v1",
+                    db.StreamWorkerCapability.protocol_version == 1,
+                    db.StreamWorkerCapability.last_renewed_at >= cutoff,
+                    db.StreamWorkerCapability.host_id == launch.launcher_host_id,
+                    db.StreamWorkerCapability.boot_id == launch.launcher_boot_id,
+                )
+                .order_by(db.Worker.id)
+            )
+        ).all()
+    )
+    alternatives = [
+        worker_id for worker_id in candidates if worker_id != launch.worker_id
+    ]
+    if launch.worker_id not in candidates or not alternatives:
+        raise NativeStreamError(
+            "NATIVE_WORKERS_UNAVAILABLE",
+            "Two ONLINE workers advertising the fixed partition protocol on this host are required",
+        )
+    selected = (launch.worker_id, alternatives[0])
+    workers = {
+        worker.id: worker
+        for worker in (
+            await session.scalars(
+                sa.select(db.Worker)
+                .where(db.Worker.id.in_(selected))
+                .order_by(db.Worker.id)
+                .with_for_update(read=not update)
+                .execution_options(populate_existing=True)
+            )
+        ).all()
+    }
+    capabilities = {
+        cap.worker_id: cap
+        for cap in (
+            await session.scalars(
+                sa.select(db.StreamWorkerCapability)
+                .where(db.StreamWorkerCapability.worker_id.in_(selected))
+                .order_by(db.StreamWorkerCapability.worker_id)
+                .with_for_update(read=not update)
+                .execution_options(populate_existing=True)
+            )
+        ).all()
+    }
+    for worker_id in selected:
+        worker = workers.get(worker_id)
+        cap = capabilities.get(worker_id)
+        if (
+            worker is None
+            or cap is None
+            or worker.status != WorkerStatus.ONLINE
+            or worker.work_pool_id != snapshot.work_pool_id
+            or cap.work_pool_id != snapshot.work_pool_id
+            or cap.protocol != "partitioned-fixed-v1"
+            or cap.protocol_version != 1
+            or cap.last_renewed_at < cutoff
+            or (cap.host_id, cap.boot_id)
+            != (launch.launcher_host_id, launch.launcher_boot_id)
+        ):
+            raise NativeStreamError(
+                "NATIVE_WORKERS_UNAVAILABLE",
+                "Selected physical worker capability is no longer current",
+            )
+    owner = capabilities[selected[0]]
+    if (owner.launcher_process_id, owner.launcher_start_ticks) != (
+        launch.launcher_process_id,
+        launch.launcher_start_ticks,
+    ):
+        raise NativeStreamError(
+            "WORKER_IDENTITY_IN_USE",
+            "Flow launch and worker capability identify different supervisors",
+        )
+    if update:
+        occupied = dict(
+            (
+                await session.execute(
+                    sa.select(
+                        db.StreamPhysicalSubtask.assigned_worker_id, sa.func.count()
+                    )
+                    .where(
+                        db.StreamPhysicalSubtask.assigned_worker_id.in_(selected),
+                        db.StreamPhysicalSubtask.physical_slot_released.is_(False),
+                    )
+                    .group_by(db.StreamPhysicalSubtask.assigned_worker_id)
+                )
+            ).all()
+        )
+        if any(occupied.get(worker_id, 0) + 2 > 2 for worker_id in selected):
+            raise NativeStreamError(
+                "REGION_CAPACITY",
+                "A selected worker has insufficient physical process slots",
+            )
+    return selected
+
