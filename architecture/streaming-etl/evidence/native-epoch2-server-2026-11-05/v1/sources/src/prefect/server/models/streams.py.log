"""Native durable stream transactions with bounded TaskRun registration.

This internal store owns each transaction. Submission manifests atomically
create their initial Pending TaskRun; runtime lifecycle admission is a separate
layer. Reclamation is explicitly limited to final FlowRuns.
"""

import hashlib
import json
from collections.abc import AsyncGenerator, Iterable
from contextlib import asynccontextmanager
from typing import Any, Literal, cast
from uuid import UUID, uuid4

import sqlalchemy as sa
from pydantic import JsonValue, TypeAdapter, ValidationError
from sqlalchemy.ext.asyncio import AsyncSession

from prefect._internal.uuid7 import uuid7
from prefect.server.database import PrefectDBInterface, orm_models
from prefect.server.models import task_runs as task_run_models
from prefect.server.models._stream_errors import NativeStreamError
from prefect.server.models.stream_executions import require_execution
from prefect.server.models.stream_subtask_authority import (
    release_allocations,
    release_terminal_allocation,
    require_parent_subtask,
    require_subtask,
)
from prefect.server.schemas import core
from prefect.server.schemas.states import TERMINAL_STATES, StateType
from prefect.server.schemas.stream_subtasks import StreamSubtaskCredentials
from prefect.server.schemas.streams import (
    ConsumerBinding,
    DeliveryToken,
    SourceAdmission,
    SourceBinding,
    StreamCompletionResult,
    StreamDelivery,
    StreamEnvelope,
    StreamExecutionCredentials,
    StreamInfo,
    StreamLimits,
    StreamSubmissionLookupRequest,
    StreamSubmissionManifest,
    StreamSubmissionReserveRequest,
)
from prefect.types import DateTime
from prefect.types._datetime import now

MAX_STREAMS_PER_FLOW = 128
MAX_SUBMISSIONS_PER_FLOW = 128
MAX_SUBMISSION_BYTES_PER_FLOW = 1024 * 1024
MAX_SUBMISSION_CANONICAL_BYTES = 64 * 1024
MAX_SUBMISSION_PARAMETER_BYTES = 32 * 1024
_JSON_VALUE = TypeAdapter(JsonValue)


def _canonical(value: Any, maximum: int = 65_536) -> tuple[JsonValue, bytes, str]:
    try:
        validated = _JSON_VALUE.validate_python(value, strict=True)
        encoded = json.dumps(
            validated,
            sort_keys=True,
            ensure_ascii=False,
            allow_nan=False,
            separators=(",", ":"),
        ).encode("utf-8")
    except (
        ValidationError,
        ValueError,
        TypeError,
        UnicodeError,
        RecursionError,
    ) as exc:
        raise NativeStreamError(
            "PROTOCOL_ERROR", "A finite canonical JSON value is required"
        ) from exc
    if len(encoded) > maximum:
        raise NativeStreamError(
            "PAYLOAD_TOO_LARGE", "Stream JSON exceeds its byte limit"
        )
    return json.loads(encoded), encoded, hashlib.sha256(encoded).hexdigest()


def _attempt(attempt: int) -> None:
    if type(attempt) is not int or attempt < 1:
        raise NativeStreamError(
            "PROTOCOL_ERROR", "A positive integer attempt is required"
        )


def _finish(stream: orm_models.StreamPartition, error: str | None) -> None:
    if error is not None and (not error or len(error.encode("utf-8")) > 4096):
        raise NativeStreamError(
            "PROTOCOL_ERROR", "A failure needs a bounded nonempty error"
        )
    state = "COMPLETED" if error is None else "FAILED"
    if stream.state != "OPEN":
        if stream.state != state or stream.error != error:
            raise NativeStreamError(
                "TERMINAL_CONFLICT", "The stream terminal marker is immutable"
            )
        return
    stream.state, stream.error = state, error
    stream.tail_sequence = stream.last_sequence


class NativeStreamStore:
    """PostgreSQL 17 storage authority, reconstructed from native platform tables."""

    def __init__(
        self,
        db: PrefectDBInterface,
        execution: StreamExecutionCredentials | StreamSubtaskCredentials | None = None,
        *,
        session: AsyncSession | None = None,
        graph_seal_id: UUID | None = None,
    ) -> None:
        self.db = db
        self.execution = execution
        self._outer_session = session
        self._graph_seal_id = graph_seal_id

    @asynccontextmanager
    async def _session(self) -> AsyncGenerator[AsyncSession, None]:
        if self.db.dialect.name != "postgresql":
            raise NativeStreamError(
                "UNSUPPORTED_BACKEND", "Native streams require PostgreSQL 17"
            )
        if self._outer_session is not None:
            yield self._outer_session
            return
        async with self.db.session_context(begin_transaction=True) as session:
            connection = await session.connection()
            version = connection.dialect.server_version_info
            if not version or version[0] != 17:
                raise NativeStreamError(
                    "UNSUPPORTED_BACKEND", "Native streams require PostgreSQL 17"
                )
            yield session

    async def _peek(
        self, session: AsyncSession, stream_id: UUID
    ) -> orm_models.StreamPartition:
        if isinstance(self.execution, StreamSubtaskCredentials):
            await require_subtask(session, self.db, self.execution, stream_id=stream_id)
        stream = await session.get(self.db.StreamPartition, stream_id)
        if stream is None:
            raise NativeStreamError("NOT_FOUND", "Unknown stream")
        return stream

    async def _flow(
        self,
        session: AsyncSession,
        flow_run_id: UUID,
        *,
        update: bool = False,
        allowed_execution_states: Iterable[str] = ("ACTIVE",),
        require_manifest_sealed: bool = False,
        allow_physical_cleanup: bool = False,
    ) -> orm_models.FlowRun:
        query = sa.select(self.db.FlowRun).where(self.db.FlowRun.id == flow_run_id)
        query = query.with_for_update() if update else query.with_for_update(read=True)
        query = query.execution_options(populate_existing=True)
        flow = await session.scalar(query)
        if flow is None:
            raise NativeStreamError("NOT_FOUND", "Unknown FlowRun")
        execution_states = tuple(allowed_execution_states)
        validation_states = (
            ("CLAIMED", "ACTIVE", "RECOVERING", "TERMINAL", "RELEASED")
            if require_manifest_sealed
            else execution_states
        )
        if isinstance(self.execution, StreamSubtaskCredentials):
            await require_subtask(
                session, self.db, self.execution, flow_run_id=flow_run_id
            )
            authority = await session.scalar(
                sa.select(self.db.StreamExecutionAuthority).where(
                    self.db.StreamExecutionAuthority.flow_run_id == flow_run_id
                )
            )
        else:
            authority = await require_execution(
                session,
                self.db,
                flow_run_id,
                self.execution,
                allowed_states=validation_states,
            )
            if (
                require_manifest_sealed
                and not allow_physical_cleanup
                and await session.scalar(
                    sa.select(self.db.StreamGraphRevision.id).where(
                        self.db.StreamGraphRevision.flow_run_id == flow_run_id
                    )
                )
                is not None
            ):
                raise NativeStreamError(
                    "SUBTASK_AUTH_REQUIRED",
                    "Physical data access requires an exact subtask grant",
                )
        if (
            authority is not None
            and authority.state == "RELEASED"
            and "RELEASED" not in execution_states
        ):
            raise NativeStreamError(
                "RECOVERY_HORIZON_EXPIRED", "Execution generation was released"
            )
        if (
            require_manifest_sealed
            and authority is not None
            and authority.manifest_set_digest is None
        ):
            raise NativeStreamError(
                "MANIFEST_NOT_SEALED",
                "Native execution cannot admit work before its manifest is sealed",
            )
        if (
            require_manifest_sealed
            and authority is not None
            and authority.prepared_generation != authority.generation
        ):
            raise NativeStreamError(
                "RECOVERY_NOT_READY", "Execution generation is not prepared"
            )
        if authority is not None and authority.state not in execution_states:
            raise NativeStreamError(
                "RECOVERY_NOT_READY", "Execution generation is not active"
            )
        if (
            authority is not None
            and authority.cancel_requested
            and "TERMINAL" not in execution_states
            and "RELEASED" not in execution_states
        ):
            raise NativeStreamError(
                "CANCEL_REQUESTED", "Native execution no longer accepts data writes"
            )
        return flow

    async def _streams(
        self, session: AsyncSession, stream_ids: Iterable[UUID]
    ) -> dict[UUID, orm_models.StreamPartition]:
        ids = set(stream_ids)
        if isinstance(self.execution, StreamSubtaskCredentials):
            for stream_id in ids:
                await require_subtask(
                    session, self.db, self.execution, stream_id=stream_id
                )
        rows = (
            await session.scalars(
                sa.select(self.db.StreamPartition)
                .where(self.db.StreamPartition.id.in_(ids))
                .order_by(self.db.StreamPartition.id)
                .with_for_update()
                .execution_options(populate_existing=True)
            )
        ).all()
        if len(rows) != len(ids):
            raise NativeStreamError("NOT_FOUND", "Unknown stream")
        if any(row.released for row in rows):
            raise NativeStreamError(
                "REPLAY_HORIZON_EXPIRED", "Stream payload has been released"
            )
        return {row.id: row for row in rows}

    async def _task(
        self,
        session: AsyncSession,
        task_id: UUID,
        flow_id: UUID,
        attempt: int,
        *,
        allow_failed: bool = False,
        metadata_lag: bool = False,
    ) -> orm_models.TaskRun:
        await self._flow(
            session,
            flow_id,
            require_manifest_sealed=True,
            allow_physical_cleanup=allow_failed,
        )
        if isinstance(self.execution, StreamSubtaskCredentials):
            await require_subtask(session, self.db, self.execution, task_run_id=task_id)
        task = await session.scalar(
            sa.select(self.db.TaskRun)
            .where(self.db.TaskRun.id == task_id)
            .with_for_update()
        )
        if task is None:
            if metadata_lag:
                raise NativeStreamError(
                    "METADATA_NOT_READY", "TaskRun metadata is not recorded yet"
                )
            raise NativeStreamError(
                "IDENTITY_CONFLICT", "TaskRun must exist in the stream's FlowRun"
            )
        if task.flow_run_id != flow_id:
            raise NativeStreamError(
                "IDENTITY_CONFLICT", "TaskRun must exist in the stream's FlowRun"
            )
        if self.execution is not None:
            manifest = await session.scalar(
                sa.select(self.db.StreamSubmission.id).where(
                    self.db.StreamSubmission.flow_run_id == flow_id,
                    self.db.StreamSubmission.task_run_id == task_id,
                    self.db.StreamSubmission.state == "ACTIVE",
                )
            )
            if manifest is None:
                raise NativeStreamError(
                    "IDENTITY_CONFLICT",
                    "Enrolled TaskRun is outside the sealed manifest",
                )
        if metadata_lag:
            if task.state_type in TERMINAL_STATES or task.run_count > attempt:
                raise NativeStreamError(
                    "ATTEMPT_NOT_CURRENT",
                    "Operation requires the current admitted TaskRun attempt/state",
                )
            if task.run_count < attempt or task.state_type in {
                StateType.PENDING,
                StateType.SCHEDULED,
            }:
                raise NativeStreamError(
                    "METADATA_NOT_READY",
                    "TaskRun RUNNING metadata is not recorded yet",
                )
        allowed_states = {StateType.RUNNING}
        if allow_failed:
            allowed_states |= {StateType.FAILED, StateType.CRASHED, StateType.CANCELLED}
        if task.run_count != attempt or task.state_type not in allowed_states:
            raise NativeStreamError(
                "ATTEMPT_NOT_CURRENT",
                "Operation requires the current admitted TaskRun attempt/state",
            )
        return task

    def _claim(
        self,
        stream: orm_models.StreamPartition,
        kind: str,
        task_id: UUID,
        owner_id: UUID,
        attempt: int,
    ) -> None:
        if stream.producer_kind is None:
            if stream.state != "OPEN":
                raise NativeStreamError(
                    "TERMINAL_CONFLICT", "Cannot claim a closed stream"
                )
            stream.producer_kind = kind
            stream.producer_task_run_id = task_id
        elif stream.producer_kind != kind or stream.producer_task_run_id != task_id:
            raise NativeStreamError(
                "IDENTITY_CONFLICT", "Stream producer binding is immutable"
            )
        if stream.state == "FAILED":
            raise NativeStreamError(
                "TERMINAL_CONFLICT", "Cannot reopen a failed output"
            )
        if stream.owner_id == owner_id and stream.attempt == attempt:
            return
        if attempt <= stream.attempt:
            raise NativeStreamError(
                "STALE_OWNER", "Only a newer task attempt can replace the owner"
            )
        stream.owner_id, stream.attempt = owner_id, attempt
        stream.owner_epoch += 1

    def _source_owner(
        self, stream: orm_models.StreamPartition, binding: SourceBinding
    ) -> None:
        if (
            stream.flow_run_id != binding.flow_run_id
            or stream.producer_kind != "SOURCE"
            or stream.producer_task_run_id != binding.task_run_id
        ):
            raise NativeStreamError(
                "IDENTITY_CONFLICT", "Source binding does not match"
            )
        if (stream.owner_id, stream.attempt, stream.owner_epoch) != (
            binding.owner_id,
            binding.attempt,
            binding.owner_epoch,
        ):
            raise NativeStreamError("STALE_OWNER", "Source owner is fenced")

    async def _bound(
        self,
        session: AsyncSession,
        binding: ConsumerBinding,
        *,
        allow_failed: bool = False,
    ) -> tuple[
        orm_models.StreamPartition,
        orm_models.StreamPartition,
        orm_models.StreamConsumer,
    ]:
        await self._task(
            session,
            binding.consumer_id,
            binding.flow_run_id,
            binding.attempt,
            allow_failed=allow_failed,
        )
        streams = await self._streams(
            session, [binding.input_stream_id, binding.output_stream_id]
        )
        consumer = await session.scalar(
            sa.select(self.db.StreamConsumer)
            .where(self.db.StreamConsumer.id == binding.consumer_id)
            .with_for_update()
        )
        if consumer is None:
            raise NativeStreamError("NOT_FOUND", "Unknown consumer")
        upstream, output = (
            streams[binding.input_stream_id],
            streams[binding.output_stream_id],
        )
        if (
            consumer.flow_run_id,
            consumer.input_stream_id,
            consumer.output_stream_id,
        ) != (binding.flow_run_id, binding.input_stream_id, binding.output_stream_id):
            raise NativeStreamError(
                "IDENTITY_CONFLICT", "Consumer binding is immutable"
            )
        expected = (binding.owner_id, binding.attempt, binding.owner_epoch)
        if (consumer.owner_id, consumer.attempt, consumer.owner_epoch) != expected or (
            output.owner_id,
            output.attempt,
            output.owner_epoch,
        ) != expected:
            raise NativeStreamError("STALE_OWNER", "Consumer owner is fenced")
        if (
            output.producer_kind != "CONSUMER"
            or output.producer_task_run_id != consumer.id
        ):
            raise NativeStreamError(
                "IDENTITY_CONFLICT", "Output producer does not match consumer"
            )
        return upstream, output, consumer

    def _capacity(self, stream: orm_models.StreamPartition, size: int) -> None:
        limits = StreamLimits.model_validate(stream.limits)
        if size > limits.max_record_bytes:
            raise NativeStreamError(
                "PAYLOAD_TOO_LARGE", "Record exceeds frozen stream limit"
            )
        if (
            stream.record_count + 1 > limits.max_records
            or stream.byte_count + size > limits.max_bytes
        ):
            raise NativeStreamError("CAPACITY", "Frozen stream capacity is exhausted")

    def _submission_material(
        self, request: StreamSubmissionReserveRequest
    ) -> tuple[dict[str, JsonValue], bytes, str, str, StreamLimits, list[str]]:
        parameters, _parameter_bytes, parameter_digest = _canonical(
            request.parameters, MAX_SUBMISSION_PARAMETER_BYTES
        )
        if not isinstance(parameters, dict):
            raise NativeStreamError(
                "PROTOCOL_ERROR", "Submission parameters must be a JSON object"
            )
        limits = request.limits or StreamLimits()
        tags = sorted(set(request.tags))
        material: dict[str, Any] = {
            "schema": "native-stream-submission-v1",
            "flow_run_id": str(request.flow_run_id),
            "submission_key": request.submission_key,
            "role": request.role,
            "protocol": request.protocol,
            "task_name": request.task_name,
            "task_key": request.task_key,
            "task_version": request.task_version,
            "flow_version": request.flow_version,
            "deployment_id": (
                str(request.deployment_id) if request.deployment_id else None
            ),
            "deployment_version": request.deployment_version,
            "artifact_digest": request.artifact_digest,
            "parameters": parameters,
            "upstream_stream_id": (
                str(request.upstream_stream_id) if request.upstream_stream_id else None
            ),
            "input_key": request.input_key,
            "limits": limits.model_dump(mode="json"),
            "task_policy": request.task_policy.model_dump(mode="json"),
            "tags": tags,
            "labels": request.labels,
        }
        _, encoded, request_digest = _canonical(
            material, MAX_SUBMISSION_CANONICAL_BYTES
        )
        return parameters, encoded, request_digest, parameter_digest, limits, tags

    @staticmethod
    def _submission_response(
        manifest: orm_models.StreamSubmission,
    ) -> StreamSubmissionManifest:
        return StreamSubmissionManifest(
            flow_run_id=manifest.flow_run_id,
            submission_key=manifest.submission_key,
            manifest_digest=manifest.manifest_digest,
            task_run_id=manifest.task_run_id,
            stream_id=manifest.stream_id,
            dynamic_key=manifest.dynamic_key,
            role=cast(Literal["SOURCE", "OPERATOR"], manifest.role),
            protocol=cast(Literal["source-v1", "yield-v2"], manifest.protocol),
            state=cast(Literal["ACTIVE", "RELEASED"], manifest.state),
            created_at=manifest.created,
        )

    async def reserve_submission(
        self, request: StreamSubmissionReserveRequest
    ) -> StreamSubmissionManifest:
        """Atomically create or exactly replay one semantic stream submission."""

        (
            parameters,
            canonical,
            request_digest,
            parameters_digest,
            limits,
            tags,
        ) = self._submission_material(request)
        async with self._session() as session:
            flow = await self._flow(
                session,
                request.flow_run_id,
                update=True,
                allowed_execution_states=("CLAIMED", "ACTIVE", "RECOVERING"),
            )
            if self._graph_seal_id is not None:
                graph = await session.get(
                    self.db.StreamGraphRevision, self._graph_seal_id
                )
                if (
                    graph is None
                    or graph.flow_run_id != request.flow_run_id
                    or graph.profile != "partitioned-fixed-v1"
                    or graph.state != "SEALED"
                ):
                    raise NativeStreamError(
                        "UNSUPPORTED_TOPOLOGY",
                        "Source relaxation requires this Flow's sealing fixed graph",
                    )
            if (
                flow.flow_version != request.flow_version
                or flow.deployment_id != request.deployment_id
                or flow.deployment_version != request.deployment_version
            ):
                raise NativeStreamError(
                    "IDENTITY_CONFLICT",
                    "Submission version does not match the authoritative FlowRun",
                )
            existing = await session.scalar(
                sa.select(self.db.StreamSubmission)
                .where(
                    self.db.StreamSubmission.flow_run_id == request.flow_run_id,
                    self.db.StreamSubmission.submission_key == request.submission_key,
                )
                .with_for_update()
            )
            authority = await session.scalar(
                sa.select(self.db.StreamExecutionAuthority).where(
                    self.db.StreamExecutionAuthority.flow_run_id == request.flow_run_id
                )
            )
            if existing is not None:
                if existing.request_digest != request_digest:
                    raise NativeStreamError(
                        "IDENTITY_CONFLICT",
                        "Submission key is already bound to another manifest",
                    )
                if existing.state == "RELEASED":
                    raise NativeStreamError(
                        "REPLAY_HORIZON_EXPIRED",
                        "Submission payload has been released",
                    )
                task = await session.get(self.db.TaskRun, existing.task_run_id)
                if task is None:
                    raise NativeStreamError(
                        "IDENTITY_CONFLICT", "Submission TaskRun is missing"
                    )
                if authority is None and (
                    task.state_type != StateType.PENDING or task.run_count != 0
                ):
                    raise NativeStreamError(
                        "RECOVERY_NOT_READY",
                        "Existing execution requires the N1.5 recovery fence",
                    )
                return self._submission_response(existing)

            if authority is not None and authority.manifest_set_digest is not None:
                raise NativeStreamError(
                    "MANIFEST_SEALED", "No submissions may be added after manifest seal"
                )
            if authority is not None and authority.state == "RECOVERING":
                raise NativeStreamError(
                    "MANIFEST_NOT_SEALED",
                    "An incomplete manifest cannot be extended after takeover",
                )

            if flow.state_type in TERMINAL_STATES:
                raise NativeStreamError(
                    "TERMINAL_CONFLICT",
                    "Cannot reserve a submission for a final FlowRun",
                )
            flow_retries = flow.empirical_policy.retries
            task_retries = request.task_policy.retries
            if (
                flow_retries is None
                or flow_retries < 1
                or task_retries is None
                or task_retries < 1
            ):
                raise NativeStreamError(
                    "PROTOCOL_ERROR",
                    "Recoverable submissions require FlowRun and TaskRun retries",
                )

            count, total_bytes = (
                await session.execute(
                    sa.select(
                        sa.func.count(),
                        sa.func.coalesce(
                            sa.func.sum(self.db.StreamSubmission.canonical_size), 0
                        ),
                    ).where(self.db.StreamSubmission.flow_run_id == request.flow_run_id)
                )
            ).one()
            finite_bytes = await session.scalar(
                sa.select(
                    sa.func.coalesce(
                        sa.func.sum(self.db.StreamFiniteSubmission.canonical_size), 0
                    )
                ).where(
                    self.db.StreamFiniteSubmission.flow_run_id == request.flow_run_id
                )
            )
            if count >= MAX_SUBMISSIONS_PER_FLOW:
                raise NativeStreamError(
                    "CAPACITY", "FlowRun submission capacity is exhausted"
                )
            if (
                total_bytes + (finite_bytes or 0) + len(canonical)
                > MAX_SUBMISSION_BYTES_PER_FLOW
            ):
                raise NativeStreamError(
                    "CAPACITY", "FlowRun submission metadata capacity is exhausted"
                )

            if request.role == "SOURCE" and self._graph_seal_id is None:
                source_root = await session.scalar(
                    sa.select(self.db.StreamSubmission.id).where(
                        self.db.StreamSubmission.flow_run_id == request.flow_run_id,
                        self.db.StreamSubmission.role == "SOURCE",
                    )
                )
                if source_root is not None:
                    raise NativeStreamError(
                        "UNSUPPORTED_TOPOLOGY",
                        "The first recovery profile allows one source root",
                    )

            upstream: orm_models.StreamSubmission | None = None
            if request.upstream_stream_id is not None:
                upstream = await session.scalar(
                    sa.select(self.db.StreamSubmission)
                    .where(
                        self.db.StreamSubmission.stream_id == request.upstream_stream_id
                    )
                    .with_for_update()
                )
                if upstream is None or upstream.flow_run_id != request.flow_run_id:
                    raise NativeStreamError(
                        "UNSUPPORTED_TOPOLOGY",
                        "Operator input must be an active manifest in the same FlowRun",
                    )
                if upstream.state != "ACTIVE":
                    raise NativeStreamError(
                        "REPLAY_HORIZON_EXPIRED", "Upstream manifest was released"
                    )
                downstream = await session.scalar(
                    sa.select(self.db.StreamSubmission.id).where(
                        self.db.StreamSubmission.upstream_stream_id
                        == request.upstream_stream_id
                    )
                )
                if downstream is not None:
                    raise NativeStreamError(
                        "UNSUPPORTED_TOPOLOGY",
                        "The first recovery profile does not support fan-out",
                    )

            stream_count = await session.scalar(
                sa.select(sa.func.count())
                .select_from(self.db.StreamPartition)
                .where(self.db.StreamPartition.flow_run_id == request.flow_run_id)
            )
            if stream_count is not None and stream_count >= MAX_STREAMS_PER_FLOW:
                raise NativeStreamError(
                    "CAPACITY", "FlowRun stream capacity is exhausted"
                )

            dynamic_key = (
                "stream-"
                + hashlib.sha256(request.submission_key.encode("utf-8")).hexdigest()[
                    :32
                ]
            )
            existing_task = await session.scalar(
                sa.select(self.db.TaskRun).where(
                    self.db.TaskRun.flow_run_id == request.flow_run_id,
                    self.db.TaskRun.task_key == request.task_key,
                    self.db.TaskRun.dynamic_key == dynamic_key,
                )
            )
            if existing_task is not None:
                raise NativeStreamError(
                    "IDENTITY_CONFLICT",
                    "Submission TaskRun identity exists without its manifest",
                )

            task_run_id, stream_id = uuid7(), uuid7()
            task_inputs: dict[
                str,
                list[
                    core.TaskRunResult
                    | core.FlowRunResult
                    | core.Parameter
                    | core.Constant
                ],
            ] = {}
            if upstream is not None:
                assert request.input_key is not None
                task_inputs[request.input_key] = [
                    core.TaskRunResult(id=upstream.task_run_id)
                ]
            task = core.TaskRun(
                id=task_run_id,
                name=request.task_name,
                flow_run_id=request.flow_run_id,
                task_key=request.task_key,
                dynamic_key=dynamic_key,
                task_version=request.task_version,
                empirical_policy=request.task_policy,
                tags=tags,
                labels=request.labels,
                task_inputs=task_inputs,
                flow_run_run_count=flow.run_count,
                state=core.states.Pending(),
            )
            created_task = await task_run_models.create_task_run(
                session=session, task_run=task
            )
            if created_task.id != task_run_id:
                raise NativeStreamError(
                    "IDENTITY_CONFLICT", "TaskRun identity was claimed concurrently"
                )

            producer_kind = "SOURCE" if request.role == "SOURCE" else "CONSUMER"
            stream = self.db.StreamPartition(
                id=stream_id,
                flow_run_id=request.flow_run_id,
                protocol_version=1,
                producer_kind=producer_kind,
                producer_task_run_id=task_run_id,
                limits=limits.model_dump(),
            )
            session.add(stream)
            await session.flush()
            manifest_digest = hashlib.sha256(
                b"native-stream-manifest-v1\0"
                + request_digest.encode("ascii")
                + task_run_id.bytes
                + stream_id.bytes
            ).hexdigest()
            manifest = self.db.StreamSubmission(
                flow_run_id=request.flow_run_id,
                graph_revision_id=self._graph_seal_id,
                submission_key=request.submission_key,
                request_digest=request_digest,
                manifest_digest=manifest_digest,
                canonical_size=len(canonical),
                parameters=parameters,
                parameters_digest=parameters_digest,
                role=request.role,
                protocol=request.protocol,
                input_key=request.input_key,
                upstream_stream_id=request.upstream_stream_id,
                task_run_id=task_run_id,
                stream_id=stream_id,
                task_name=request.task_name,
                task_key=request.task_key,
                task_version=request.task_version,
                flow_version=request.flow_version,
                deployment_id=request.deployment_id,
                deployment_version=request.deployment_version,
                artifact_digest=request.artifact_digest,
                dynamic_key=dynamic_key,
                limits=limits.model_dump(),
                task_policy=request.task_policy.model_dump(mode="json"),
                tags=tags,
                labels=request.labels,
            )
            session.add(manifest)
            await session.flush()
            return self._submission_response(manifest)

    async def lookup_submission(
        self, request: StreamSubmissionLookupRequest
    ) -> StreamSubmissionManifest:
        async with self._session() as session:
            manifest = await session.scalar(
                sa.select(self.db.StreamSubmission).where(
                    self.db.StreamSubmission.flow_run_id == request.flow_run_id,
                    self.db.StreamSubmission.submission_key == request.submission_key,
                )
            )
            if manifest is None:
                raise NativeStreamError("NOT_FOUND", "Unknown submission manifest")
            return self._submission_response(manifest)

    async def create(
        self,
        flow_run_id: UUID,
        stream_id: UUID,
        *,
        limits: StreamLimits | None = None,
        protocol_version: int = 1,
    ) -> StreamInfo:
        if type(protocol_version) is not int or protocol_version != 1:
            raise NativeStreamError(
                "PROTOCOL_ERROR", "Unsupported stream protocol version"
            )
        limits = limits or StreamLimits()
        async with self._session() as session:
            flow = await self._flow(
                session,
                flow_run_id,
                update=True,
                allowed_execution_states=("CLAIMED", "ACTIVE"),
            )
            if self.execution is not None:
                raise NativeStreamError(
                    "IDENTITY_CONFLICT",
                    "Enrolled executions require task-bound manifest streams",
                )
            stream = await session.get(self.db.StreamPartition, stream_id)
            if stream is not None:
                if stream.released:
                    raise NativeStreamError(
                        "REPLAY_HORIZON_EXPIRED", "Stream has been released"
                    )
                if (
                    stream.flow_run_id != flow_run_id
                    or stream.limits != limits.model_dump()
                ):
                    raise NativeStreamError(
                        "IDENTITY_CONFLICT", "Stream scope and limits are immutable"
                    )
                return StreamInfo.model_validate(stream)
            if flow.state_type in TERMINAL_STATES:
                raise NativeStreamError(
                    "TERMINAL_CONFLICT", "Cannot create a stream for a final FlowRun"
                )
            count = await session.scalar(
                sa.select(sa.func.count())
                .select_from(self.db.StreamPartition)
                .where(self.db.StreamPartition.flow_run_id == flow_run_id)
            )
            if count is not None and count >= MAX_STREAMS_PER_FLOW:
                raise NativeStreamError(
                    "CAPACITY", "FlowRun stream capacity is exhausted"
                )
            stream = self.db.StreamPartition(
                id=stream_id, flow_run_id=flow_run_id, limits=limits.model_dump()
            )
            session.add(stream)
            await session.flush()
            result = StreamInfo.model_validate(stream)
        return result

    async def _reserve_task_stream(
        self,
        flow_run_id: UUID,
        stream_id: UUID,
        task_run_id: UUID,
        *,
        producer_kind: Literal["CONSUMER", "SOURCE"],
        limits: StreamLimits | None = None,
        protocol_version: int = 1,
    ) -> StreamInfo:
        """Create an immutable, unowned stream reservation for a TaskRun."""
        if type(protocol_version) is not int or protocol_version != 1:
            raise NativeStreamError(
                "PROTOCOL_ERROR", "Unsupported stream protocol version"
            )
        limits = limits or StreamLimits()
        async with self._session() as session:
            flow = await self._flow(
                session,
                flow_run_id,
                update=True,
                allowed_execution_states=("CLAIMED", "ACTIVE"),
                require_manifest_sealed=self.execution is not None,
            )
            task = await session.scalar(
                sa.select(self.db.TaskRun)
                .where(self.db.TaskRun.id == task_run_id)
                .with_for_update()
            )
            if task is None:
                raise NativeStreamError(
                    "METADATA_NOT_READY", "TaskRun metadata is not recorded yet"
                )
            if task.flow_run_id != flow_run_id:
                raise NativeStreamError(
                    "IDENTITY_CONFLICT", "TaskRun must belong to the output FlowRun"
                )
            if self.execution is not None:
                manifest = await session.scalar(
                    sa.select(self.db.StreamSubmission).where(
                        self.db.StreamSubmission.flow_run_id == flow_run_id,
                        self.db.StreamSubmission.task_run_id == task_run_id,
                        self.db.StreamSubmission.stream_id == stream_id,
                        self.db.StreamSubmission.state == "ACTIVE",
                    )
                )
                if manifest is None or manifest.role != (
                    "SOURCE" if producer_kind == "SOURCE" else "OPERATOR"
                ):
                    raise NativeStreamError(
                        "IDENTITY_CONFLICT",
                        "Task stream is outside the sealed manifest",
                    )
            stream = await session.scalar(
                sa.select(self.db.StreamPartition)
                .where(self.db.StreamPartition.id == stream_id)
                .with_for_update()
            )
            if stream is not None:
                if stream.released:
                    raise NativeStreamError(
                        "REPLAY_HORIZON_EXPIRED", "Stream has been released"
                    )
                if (
                    stream.flow_run_id != flow_run_id
                    or stream.protocol_version != protocol_version
                    or stream.limits != limits.model_dump()
                    or stream.producer_kind != producer_kind
                    or stream.producer_task_run_id != task_run_id
                ):
                    raise NativeStreamError(
                        "IDENTITY_CONFLICT", "Task stream reservation is immutable"
                    )
                return StreamInfo.model_validate(stream)
            if task.state_type in TERMINAL_STATES:
                raise NativeStreamError(
                    "ATTEMPT_NOT_CURRENT",
                    "Cannot reserve output for a final TaskRun",
                )
            if flow.state_type in TERMINAL_STATES:
                raise NativeStreamError(
                    "TERMINAL_CONFLICT", "Cannot reserve output for a final FlowRun"
                )
            count = await session.scalar(
                sa.select(sa.func.count())
                .select_from(self.db.StreamPartition)
                .where(self.db.StreamPartition.flow_run_id == flow_run_id)
            )
            if count is not None and count >= MAX_STREAMS_PER_FLOW:
                raise NativeStreamError(
                    "CAPACITY", "FlowRun stream capacity is exhausted"
                )
            stream = self.db.StreamPartition(
                id=stream_id,
                flow_run_id=flow_run_id,
                protocol_version=protocol_version,
                producer_kind=producer_kind,
                producer_task_run_id=task_run_id,
                limits=limits.model_dump(),
            )
            session.add(stream)
            await session.flush()
            result = StreamInfo.model_validate(stream)
        return result

    async def reserve_output(
        self,
        flow_run_id: UUID,
        stream_id: UUID,
        task_run_id: UUID,
        *,
        limits: StreamLimits | None = None,
        protocol_version: int = 1,
    ) -> StreamInfo:
        """Create an immutable, unowned consumer output reservation."""
        return await self._reserve_task_stream(
            flow_run_id,
            stream_id,
            task_run_id,
            producer_kind="CONSUMER",
            limits=limits,
            protocol_version=protocol_version,
        )

    async def reserve_source(
        self,
        flow_run_id: UUID,
        stream_id: UUID,
        task_run_id: UUID,
        *,
        limits: StreamLimits | None = None,
        protocol_version: int = 1,
        source_protocol: str = "source-v1",
    ) -> StreamInfo:
        """Create an immutable, unowned native source reservation."""
        if source_protocol != "source-v1":
            raise NativeStreamError("PROTOCOL_ERROR", "Unsupported source protocol")
        return await self._reserve_task_stream(
            flow_run_id,
            stream_id,
            task_run_id,
            producer_kind="SOURCE",
            limits=limits,
            protocol_version=protocol_version,
        )

    async def _reject_task_reservation(
        self,
        flow_run_id: UUID,
        stream_id: UUID,
        task_run_id: UUID,
        error: str,
        *,
        producer_kind: Literal["CONSUMER", "SOURCE"],
    ) -> StreamInfo:
        """Fail an exact task stream reservation without an admitted owner."""
        async with self._session() as session:
            await self._flow(
                session,
                flow_run_id,
                update=True,
                allowed_execution_states=("CLAIMED", "ACTIVE"),
                require_manifest_sealed=self.execution is not None,
                allow_physical_cleanup=True,
            )
            if isinstance(self.execution, StreamSubtaskCredentials):
                await require_subtask(
                    session,
                    self.db,
                    self.execution,
                    task_run_id=task_run_id,
                    stream_id=stream_id,
                )
            if not isinstance(self.execution, StreamSubtaskCredentials):
                await require_parent_subtask(session, self.db, flow_run_id, task_run_id)
            await session.execute(
                sa.select(self.db.TaskRun)
                .where(self.db.TaskRun.id == task_run_id)
                .with_for_update()
            )
            stream = await session.scalar(
                sa.select(self.db.StreamPartition)
                .where(self.db.StreamPartition.id == stream_id)
                .with_for_update()
            )
            if stream is None:
                raise NativeStreamError("NOT_FOUND", "Unknown stream")
            if stream.released:
                raise NativeStreamError(
                    "REPLAY_HORIZON_EXPIRED", "Stream payload has been released"
                )
            if (
                stream.flow_run_id != flow_run_id
                or stream.producer_kind != producer_kind
                or stream.producer_task_run_id != task_run_id
            ):
                raise NativeStreamError(
                    "IDENTITY_CONFLICT", "Task stream reservation does not match"
                )
            if self.execution is not None:
                manifest = await session.scalar(
                    sa.select(self.db.StreamSubmission.id).where(
                        self.db.StreamSubmission.flow_run_id == flow_run_id,
                        self.db.StreamSubmission.task_run_id == task_run_id,
                        self.db.StreamSubmission.stream_id == stream_id,
                        self.db.StreamSubmission.state == "ACTIVE",
                    )
                )
                if manifest is None:
                    raise NativeStreamError(
                        "IDENTITY_CONFLICT",
                        "Task stream is outside the sealed manifest",
                    )
            has_consumer = await session.scalar(
                sa.select(
                    sa.exists().where(
                        self.db.StreamConsumer.output_stream_id == stream_id
                    )
                )
            )
            has_records = await session.scalar(
                sa.select(
                    sa.exists().where(self.db.StreamRecord.stream_id == stream_id)
                )
            )
            if (
                stream.owner_id is not None
                or stream.attempt != 0
                or stream.owner_epoch != 0
                or has_consumer
                or has_records
            ):
                raise NativeStreamError(
                    "STALE_OWNER", "An admitted output cannot be rejected"
                )
            _finish(stream, error)
            physical = await session.scalar(
                sa.select(self.db.StreamPhysicalSubtask).where(
                    self.db.StreamPhysicalSubtask.task_run_id == task_run_id
                )
            )
            if physical is not None:
                await release_terminal_allocation(session, self.db, physical)
            result = StreamInfo.model_validate(stream)
        return result

    async def reject_reserved_output(
        self,
        flow_run_id: UUID,
        stream_id: UUID,
        task_run_id: UUID,
        error: str,
    ) -> StreamInfo:
        """Fail an exact consumer output reservation before admission."""
        return await self._reject_task_reservation(
            flow_run_id,
            stream_id,
            task_run_id,
            error,
            producer_kind="CONSUMER",
        )

    async def reject_reserved_source(
        self,
        flow_run_id: UUID,
        stream_id: UUID,
        task_run_id: UUID,
        error: str,
    ) -> StreamInfo:
        """Fail an exact native source reservation before admission."""
        return await self._reject_task_reservation(
            flow_run_id,
            stream_id,
            task_run_id,
            error,
            producer_kind="SOURCE",
        )

    async def _fail_task_stream(
        self,
        flow_run_id: UUID,
        stream_id: UUID,
        task_run_id: UUID,
        attempt: int,
        error: str,
        *,
        producer_kind: Literal["CONSUMER", "SOURCE"],
    ) -> StreamInfo:
        """Fail a task stream using its exact terminal lifecycle witness."""
        _attempt(attempt)
        async with self._session() as session:
            task = await self._task(
                session,
                task_run_id,
                flow_run_id,
                attempt,
                allow_failed=True,
            )
            if task.state_type not in {
                StateType.FAILED,
                StateType.CRASHED,
                StateType.CANCELLED,
            }:
                raise NativeStreamError(
                    "ATTEMPT_NOT_CURRENT",
                    "Output failure requires a terminal TaskRun attempt",
                )
            stream = await session.scalar(
                sa.select(self.db.StreamPartition)
                .where(self.db.StreamPartition.id == stream_id)
                .with_for_update()
            )
            if stream is None:
                raise NativeStreamError("NOT_FOUND", "Unknown stream")
            if stream.released:
                raise NativeStreamError(
                    "REPLAY_HORIZON_EXPIRED", "Stream payload has been released"
                )
            if (
                stream.flow_run_id != flow_run_id
                or stream.producer_kind != producer_kind
                or stream.producer_task_run_id != task_run_id
            ):
                raise NativeStreamError(
                    "IDENTITY_CONFLICT", "Stream producer does not match TaskRun"
                )
            if stream.attempt > attempt:
                raise NativeStreamError(
                    "STALE_OWNER", "An older attempt cannot fail a newer output owner"
                )
            _finish(stream, error)
            physical = await session.scalar(
                sa.select(self.db.StreamPhysicalSubtask).where(
                    self.db.StreamPhysicalSubtask.task_run_id == task_run_id
                )
            )
            if physical is not None:
                await release_terminal_allocation(session, self.db, physical)
            result = StreamInfo.model_validate(stream)
        return result

    async def fail_task_output(
        self,
        flow_run_id: UUID,
        stream_id: UUID,
        task_run_id: UUID,
        attempt: int,
        error: str,
    ) -> StreamInfo:
        """Fail a consumer output from an exact terminal TaskRun witness."""
        return await self._fail_task_stream(
            flow_run_id,
            stream_id,
            task_run_id,
            attempt,
            error,
            producer_kind="CONSUMER",
        )

    async def fail_task_source(
        self,
        flow_run_id: UUID,
        stream_id: UUID,
        task_run_id: UUID,
        attempt: int,
        error: str,
    ) -> StreamInfo:
        """Fail a source output from an exact terminal TaskRun witness."""
        return await self._fail_task_stream(
            flow_run_id,
            stream_id,
            task_run_id,
            attempt,
            error,
            producer_kind="SOURCE",
        )

    async def claim_source(
        self, stream_id: UUID, task_run_id: UUID, owner_id: UUID, attempt: int
    ) -> SourceBinding:
        _attempt(attempt)
        async with self._session() as session:
            peek = await self._peek(session, stream_id)
            await self._task(session, task_run_id, peek.flow_run_id, attempt)
            stream = (await self._streams(session, [stream_id]))[stream_id]
            self._claim(stream, "SOURCE", task_run_id, owner_id, attempt)
            result = SourceBinding(
                flow_run_id=stream.flow_run_id,
                stream_id=stream_id,
                task_run_id=task_run_id,
                owner_id=owner_id,
                attempt=attempt,
                owner_epoch=stream.owner_epoch,
            )
        return result

    async def open_source(
        self,
        stream_id: UUID,
        task_run_id: UUID,
        owner_id: UUID,
        attempt: int,
        *,
        protocol_version: int = 1,
        source_protocol: str = "source-v1",
        metadata_lag: bool = False,
    ) -> SourceAdmission:
        """Admit an exact reserved source and return its durable position."""
        _attempt(attempt)
        if type(protocol_version) is not int or protocol_version != 1:
            raise NativeStreamError(
                "PROTOCOL_ERROR", "Unsupported stream protocol version"
            )
        if source_protocol != "source-v1":
            raise NativeStreamError("PROTOCOL_ERROR", "Unsupported source protocol")
        async with self._session() as session:
            peek = await self._peek(session, stream_id)
            flow = await self._flow(
                session, peek.flow_run_id, require_manifest_sealed=True
            )
            await self._task(
                session,
                task_run_id,
                peek.flow_run_id,
                attempt,
                metadata_lag=metadata_lag,
            )
            if flow.state_type in TERMINAL_STATES:
                raise NativeStreamError(
                    "TERMINAL_CONFLICT", "Cannot open a source for a final FlowRun"
                )
            stream = (await self._streams(session, [stream_id]))[stream_id]
            if (
                stream.protocol_version != protocol_version
                or stream.producer_kind != "SOURCE"
                or stream.producer_task_run_id != task_run_id
            ):
                raise NativeStreamError(
                    "IDENTITY_CONFLICT",
                    "Source admission requires its exact reservation",
                )
            self._claim(stream, "SOURCE", task_run_id, owner_id, attempt)
            binding = SourceBinding(
                flow_run_id=stream.flow_run_id,
                stream_id=stream_id,
                task_run_id=task_run_id,
                owner_id=owner_id,
                attempt=attempt,
                owner_epoch=stream.owner_epoch,
            )
            admission_state: Literal["OPEN", "COMPLETED"] = (
                "COMPLETED" if stream.state == "COMPLETED" else "OPEN"
            )
            result = SourceAdmission(
                binding=binding,
                state=admission_state,
                accepted_source_position=stream.producer_position,
            )
        return result

    async def append(
        self, binding: SourceBinding, position: int, value: JsonValue
    ) -> StreamEnvelope:
        _attempt(position)
        snapshot, encoded, digest = _canonical(value)
        async with self._session() as session:
            await self._task(
                session, binding.task_run_id, binding.flow_run_id, binding.attempt
            )
            stream = (await self._streams(session, [binding.stream_id]))[
                binding.stream_id
            ]
            self._source_owner(stream, binding)
            existing = await session.scalar(
                sa.select(self.db.StreamRecord).where(
                    self.db.StreamRecord.stream_id == stream.id,
                    self.db.StreamRecord.producer_position == position,
                )
            )
            if existing is not None:
                if existing.value_digest != digest:
                    raise NativeStreamError(
                        "IDENTITY_CONFLICT", "Source position has different content"
                    )
                return StreamEnvelope.model_validate(existing)
            authority = await session.scalar(
                sa.select(self.db.StreamExecutionAuthority).where(
                    self.db.StreamExecutionAuthority.flow_run_id == binding.flow_run_id
                )
            )
            if authority is not None and authority.source_admission_closed:
                raise NativeStreamError(
                    "SOURCE_DRAIN_REQUESTED",
                    "Native execution is draining and accepts no new source data",
                )
            if stream.state != "OPEN":
                raise NativeStreamError("TERMINAL_CONFLICT", "Cannot append after EOF")
            if position != stream.producer_position + 1:
                raise NativeStreamError(
                    "PROTOCOL_ERROR", "Source positions must be contiguous"
                )
            self._capacity(stream, len(encoded))
            stream.last_sequence += 1
            stream.producer_position = position
            stream.record_count += 1
            stream.byte_count += len(encoded)
            row = self.db.StreamRecord(
                stream_id=stream.id,
                sequence=stream.last_sequence,
                producer_position=position,
                value=snapshot,
                value_digest=digest,
                size_bytes=len(encoded),
            )
            session.add(row)
            await session.flush()
            result = StreamEnvelope.model_validate(row)
        return result

    async def open_consumer(
        self,
        input_stream_id: UUID,
        output_stream_id: UUID,
        task_run_id: UUID,
        owner_id: UUID,
        attempt: int,
        *,
        metadata_lag: bool = False,
        require_reserved_output: bool = False,
    ) -> ConsumerBinding:
        _attempt(attempt)
        if input_stream_id == output_stream_id:
            raise NativeStreamError(
                "IDENTITY_CONFLICT", "A task cannot consume its own output"
            )
        async with self._session() as session:
            peek = await self._peek(session, input_stream_id)
            # An inserted consumer takes an implicit FK lock on its FlowRun.
            # Acquire the parent before children to avoid reversing release's
            # FlowRun -> stream order; SHARE also fences terminal transitions.
            flow = await self._flow(
                session, peek.flow_run_id, require_manifest_sealed=True
            )
            await self._task(
                session,
                task_run_id,
                peek.flow_run_id,
                attempt,
                metadata_lag=metadata_lag,
            )
            if flow.state_type in TERMINAL_STATES:
                raise NativeStreamError(
                    "TERMINAL_CONFLICT", "Cannot open a consumer for a final FlowRun"
                )
            streams = await self._streams(session, [input_stream_id, output_stream_id])
            upstream, output = streams[input_stream_id], streams[output_stream_id]
            if upstream.flow_run_id != output.flow_run_id:
                raise NativeStreamError(
                    "IDENTITY_CONFLICT", "Streams must share a FlowRun"
                )
            if require_reserved_output and (
                output.producer_kind != "CONSUMER"
                or output.producer_task_run_id != task_run_id
            ):
                raise NativeStreamError(
                    "IDENTITY_CONFLICT",
                    "HTTP consumer admission requires its exact output reservation",
                )
            consumer = await session.scalar(
                sa.select(self.db.StreamConsumer)
                .where(self.db.StreamConsumer.id == task_run_id)
                .with_for_update()
            )
            if consumer is not None and (
                consumer.input_stream_id,
                consumer.output_stream_id,
            ) != (input_stream_id, output_stream_id):
                raise NativeStreamError(
                    "IDENTITY_CONFLICT", "Consumer ports are immutable"
                )
            if output.state == "COMPLETED" and (
                consumer is None
                or upstream.state != "COMPLETED"
                or consumer.completed_through != upstream.tail_sequence
                or consumer.inflight_sequence is not None
                or consumer.delivery_id is not None
            ):
                raise NativeStreamError(
                    "TERMINAL_CONFLICT",
                    "Closed output requires its exact drained binding",
                )
            if consumer is None:
                count = await session.scalar(
                    sa.select(sa.func.count())
                    .select_from(self.db.StreamConsumer)
                    .where(self.db.StreamConsumer.input_stream_id == input_stream_id)
                )
                if (
                    count is not None
                    and count
                    >= StreamLimits.model_validate(upstream.limits).max_consumers
                ):
                    raise NativeStreamError(
                        "CAPACITY", "Stream consumer capacity is exhausted"
                    )
            self._claim(output, "CONSUMER", task_run_id, owner_id, attempt)
            if consumer is None:
                consumer = self.db.StreamConsumer(
                    id=task_run_id,
                    flow_run_id=upstream.flow_run_id,
                    input_stream_id=input_stream_id,
                    output_stream_id=output_stream_id,
                    owner_id=owner_id,
                    attempt=attempt,
                    owner_epoch=output.owner_epoch,
                )
                session.add(consumer)
            elif consumer.owner_epoch != output.owner_epoch:
                consumer.owner_id, consumer.attempt, consumer.owner_epoch = (
                    owner_id,
                    attempt,
                    output.owner_epoch,
                )
                consumer.inflight_sequence, consumer.delivery_id = None, None
            result = ConsumerBinding(
                flow_run_id=upstream.flow_run_id,
                consumer_id=task_run_id,
                input_stream_id=input_stream_id,
                output_stream_id=output_stream_id,
                owner_id=owner_id,
                attempt=attempt,
                owner_epoch=output.owner_epoch,
            )
        return result

    async def read(self, binding: ConsumerBinding) -> StreamDelivery | None:
        async with self._session() as session:
            upstream, output, consumer = await self._bound(session, binding)
            if output.state == "FAILED":
                raise NativeStreamError("TERMINAL_CONFLICT", "Output is failed")
            row = await session.scalar(
                sa.select(self.db.StreamRecord).where(
                    self.db.StreamRecord.stream_id == upstream.id,
                    self.db.StreamRecord.sequence == consumer.completed_through + 1,
                )
            )
            if row is None:
                if consumer.inflight_sequence is not None:
                    raise NativeStreamError(
                        "PROTOCOL_ERROR", "In-flight record is missing"
                    )
                return None
            if output.state != "OPEN":
                raise NativeStreamError(
                    "TERMINAL_CONFLICT", "Closed output cannot consume input"
                )
            if consumer.inflight_sequence is None:
                consumer.inflight_sequence, consumer.delivery_id = row.sequence, uuid4()
            delivery_id = consumer.delivery_id
            if delivery_id is None:
                raise NativeStreamError(
                    "PROTOCOL_ERROR", "In-flight delivery identity is missing"
                )
            token = DeliveryToken(
                **binding.model_dump(),
                record_id=row.id,
                sequence=row.sequence,
                delivery_id=delivery_id,
            )
            result = StreamDelivery(
                token=token, value=row.value, managed_state=consumer.managed_state
            )
        return result

    async def complete(
        self,
        binding: ConsumerBinding,
        token: DeliveryToken,
        kind: Literal["YIELD", "RETURN"],
        value: JsonValue,
        managed_state: dict[str, JsonValue],
    ) -> StreamCompletionResult:
        if any(
            getattr(token, field) != getattr(binding, field)
            for field in ConsumerBinding.model_fields
        ):
            raise NativeStreamError(
                "IDENTITY_CONFLICT", "Delivery belongs to another binding"
            )
        if kind not in ("YIELD", "RETURN") or (kind == "RETURN" and value is not None):
            raise NativeStreamError(
                "PROTOCOL_ERROR", "Terminal event must be YIELD or output-free RETURN"
            )
        snapshot, encoded, value_digest = _canonical(value)
        state, state_bytes, _ = _canonical(managed_state)
        if not isinstance(state, dict):
            raise NativeStreamError(
                "PROTOCOL_ERROR", "Managed state must be a JSON object"
            )
        _, intent, _ = _canonical(
            {
                "token": token.model_dump(mode="json"),
                "kind": kind,
                "value": snapshot,
                "state": state,
            },
            maximum=150_000,
        )
        intent_digest = hashlib.sha256(intent).hexdigest()
        async with self._session() as session:
            upstream, output, consumer = await self._bound(session, binding)
            receipt = await session.scalar(
                sa.select(self.db.StreamCompletion).where(
                    self.db.StreamCompletion.consumer_id == consumer.id,
                    self.db.StreamCompletion.input_sequence == token.sequence,
                )
            )
            if receipt is not None:
                if receipt.intent_digest != intent_digest:
                    raise NativeStreamError(
                        "IDENTITY_CONFLICT", "Accepted terminal intent is immutable"
                    )
                return StreamCompletionResult(
                    input_sequence=token.sequence,
                    output_sequence=receipt.output_sequence,
                )
            if output.state != "OPEN":
                raise NativeStreamError("TERMINAL_CONFLICT", "Output is closed")
            if (
                consumer.inflight_sequence != token.sequence
                or consumer.delivery_id != token.delivery_id
                or consumer.completed_through + 1 != token.sequence
                or output.producer_position != consumer.completed_through
            ):
                raise NativeStreamError(
                    "IDENTITY_CONFLICT", "Delivery does not match durable progress"
                )
            row = await session.scalar(
                sa.select(self.db.StreamRecord).where(
                    self.db.StreamRecord.stream_id == upstream.id,
                    self.db.StreamRecord.sequence == token.sequence,
                )
            )
            if row is None or row.id != token.record_id:
                raise NativeStreamError(
                    "IDENTITY_CONFLICT", "Input record identity differs"
                )
            if (
                len(state_bytes)
                > StreamLimits.model_validate(upstream.limits).max_state_bytes
            ):
                raise NativeStreamError(
                    "PAYLOAD_TOO_LARGE", "Managed state exceeds its frozen limit"
                )
            output_sequence = None
            if kind == "YIELD":
                self._capacity(output, len(encoded))
                output.last_sequence += 1
                output_sequence = output.last_sequence
                output.record_count += 1
                output.byte_count += len(encoded)
                session.add(
                    self.db.StreamRecord(
                        stream_id=output.id,
                        sequence=output_sequence,
                        producer_position=token.sequence,
                        value=snapshot,
                        value_digest=value_digest,
                        size_bytes=len(encoded),
                    )
                )
            output.producer_position = token.sequence
            session.add(
                self.db.StreamCompletion(
                    consumer_id=consumer.id,
                    input_sequence=token.sequence,
                    delivery_id=token.delivery_id,
                    owner_epoch=binding.owner_epoch,
                    kind=kind,
                    intent_digest=intent_digest,
                    output_sequence=output_sequence,
                )
            )
            await session.flush()
            consumer.managed_state = state
            consumer.completed_through = token.sequence
            consumer.inflight_sequence, consumer.delivery_id = None, None
            await session.flush()
            result = StreamCompletionResult(
                input_sequence=token.sequence, output_sequence=output_sequence
            )
        return result

    async def finish_source(
        self, binding: SourceBinding, error: str | None = None
    ) -> None:
        async with self._session() as session:
            await self._task(
                session,
                binding.task_run_id,
                binding.flow_run_id,
                binding.attempt,
                allow_failed=error is not None,
            )
            stream = (await self._streams(session, [binding.stream_id]))[
                binding.stream_id
            ]
            self._source_owner(stream, binding)
            _finish(stream, error)

    async def close_source(
        self, binding: SourceBinding, expected_position: int
    ) -> None:
        """Commit source EOF only at the caller's exact accepted position."""
        if type(expected_position) is not int or expected_position < 0:
            raise NativeStreamError(
                "PROTOCOL_ERROR", "Source EOF position must be a nonnegative integer"
            )
        async with self._session() as session:
            await self._task(
                session,
                binding.task_run_id,
                binding.flow_run_id,
                binding.attempt,
            )
            stream = (await self._streams(session, [binding.stream_id]))[
                binding.stream_id
            ]
            self._source_owner(stream, binding)
            if stream.producer_position != expected_position:
                raise NativeStreamError(
                    "IDENTITY_CONFLICT",
                    "Source EOF position differs from durable progress",
                )
            _finish(stream, None)

    async def finish_consumer(
        self, binding: ConsumerBinding, error: str | None = None
    ) -> None:
        async with self._session() as session:
            upstream, output, consumer = await self._bound(
                session, binding, allow_failed=error is not None
            )
            if error is None and (
                upstream.state != "COMPLETED"
                or consumer.completed_through != upstream.tail_sequence
                or consumer.inflight_sequence is not None
            ):
                raise NativeStreamError(
                    "TERMINAL_CONFLICT", "Input must be completed and fully drained"
                )
            _finish(output, error)

    async def status(self, stream_id: UUID) -> StreamInfo:
        async with self._session() as session:
            stream = await self._peek(session, stream_id)
            if isinstance(self.execution, StreamSubtaskCredentials):
                stream = await session.scalar(
                    sa.select(self.db.StreamPartition)
                    .where(self.db.StreamPartition.id == stream_id)
                    .with_for_update(read=True)
                    .execution_options(populate_existing=True)
                )
                assert stream is not None
            return StreamInfo.model_validate(stream)

    async def read_prefix(self, stream_id: UUID, limit: int) -> list[StreamEnvelope]:
        _attempt(limit)
        async with self._session() as session:
            stream = (await self._streams(session, [stream_id]))[stream_id]
            limits = StreamLimits.model_validate(stream.limits)
            if limit > limits.max_prefix_records:
                raise NativeStreamError(
                    "CAPACITY", "Prefix read exceeds its frozen bound"
                )
            sizes = (
                sa.select(self.db.StreamRecord.size_bytes)
                .where(self.db.StreamRecord.stream_id == stream_id)
                .order_by(self.db.StreamRecord.sequence)
                .limit(limit)
                .subquery()
            )
            total = await session.scalar(sa.select(sa.func.sum(sizes.c.size_bytes)))
            if total is not None and total > limits.max_prefix_bytes:
                raise NativeStreamError(
                    "CAPACITY", "Prefix payload exceeds its frozen byte bound"
                )
            rows = (
                await session.scalars(
                    sa.select(self.db.StreamRecord)
                    .where(self.db.StreamRecord.stream_id == stream_id)
                    .order_by(self.db.StreamRecord.sequence)
                    .limit(limit)
                )
            ).all()
            return [StreamEnvelope.model_validate(row) for row in rows]

    async def release_flow(
        self, flow_run_id: UUID, *, verified_server: bool = False
    ) -> int:
        async with self._session() as session:
            if verified_server:
                flow = await session.scalar(
                    sa.select(self.db.FlowRun)
                    .where(self.db.FlowRun.id == flow_run_id)
                    .with_for_update()
                )
                authority_check = await session.scalar(
                    sa.select(self.db.StreamExecutionAuthority)
                    .where(self.db.StreamExecutionAuthority.flow_run_id == flow_run_id)
                    .with_for_update()
                )
                verified_retirement = await session.scalar(
                    sa.select(self.db.NativeStreamControlOperation.id).where(
                        self.db.NativeStreamControlOperation.flow_run_id == flow_run_id,
                        self.db.NativeStreamControlOperation.kind.in_(
                            ("SPAWN_FAILED", "VERIFIED_RETIRED")
                        ),
                    )
                )
                if (
                    flow is None
                    or authority_check is None
                    or authority_check.state not in {"TERMINAL", "RELEASED"}
                    or (
                        not authority_check.cancel_requested
                        and verified_retirement is None
                    )
                ):
                    raise NativeStreamError(
                        "TERMINAL_CONFLICT",
                        "Verified cancellation is not ready for release",
                    )
            else:
                flow = await self._flow(
                    session,
                    flow_run_id,
                    update=True,
                    allowed_execution_states=("TERMINAL", "RELEASED"),
                )
            if flow.state_type not in TERMINAL_STATES:
                raise NativeStreamError(
                    "TERMINAL_CONFLICT", "Only a final FlowRun can release payloads"
                )
            graph = await session.scalar(
                sa.select(self.db.StreamGraphRevision)
                .where(self.db.StreamGraphRevision.flow_run_id == flow_run_id)
                .with_for_update()
                .execution_options(populate_existing=True)
            )
            physical_subtasks = []
            if graph is not None:
                if (
                    graph.startup_completed_at is None
                    and graph.abort_operation_id is None
                ):
                    raise NativeStreamError(
                        "STARTUP_ABORT_REQUIRED",
                        "Pre-activation graph requires its exact startup abort receipt before release",
                    )
                physical_subtasks = list(
                    (
                        await session.scalars(
                            sa.select(self.db.StreamPhysicalSubtask)
                            .where(
                                self.db.StreamPhysicalSubtask.graph_revision_id
                                == graph.id
                            )
                            .order_by(self.db.StreamPhysicalSubtask.id)
                            .with_for_update()
                        )
                    ).all()
                )
            if any(
                subtask.assigned_worker_id is not None
                and not subtask.physical_slot_released
                for subtask in physical_subtasks
            ):
                raise NativeStreamError(
                    "PHYSICAL_STOP_REQUIRED",
                    "Assigned physical processes require exact worker death receipts before release",
                )
            bound_task_ids = set(
                (
                    await session.scalars(
                        sa.select(self.db.StreamSubmission.task_run_id).where(
                            self.db.StreamSubmission.flow_run_id == flow_run_id
                        )
                    )
                ).all()
            )
            bound_task_ids.update(
                (
                    await session.scalars(
                        sa.select(self.db.StreamFiniteSubmission.task_run_id).where(
                            self.db.StreamFiniteSubmission.flow_run_id == flow_run_id
                        )
                    )
                ).all()
            )
            if bound_task_ids:
                nonterminal_tasks = await session.scalar(
                    sa.select(sa.func.count())
                    .select_from(self.db.TaskRun)
                    .where(
                        self.db.TaskRun.id.in_(bound_task_ids),
                        self.db.TaskRun.state_type.not_in(TERMINAL_STATES),
                    )
                )
                if nonterminal_tasks:
                    raise NativeStreamError(
                        "METADATA_NOT_READY",
                        "Bound TaskRun terminal metadata has not been recorded",
                    )
            if graph is not None:
                await release_allocations(
                    session, self.db, [subtask.id for subtask in physical_subtasks]
                )
                graph.state = "RELEASED"
                await session.execute(
                    sa.update(self.db.StreamSubtaskGrant)
                    .where(
                        self.db.StreamSubtaskGrant.subtask_id.in_(
                            [subtask.id for subtask in physical_subtasks]
                        )
                    )
                    .values(state="RELEASED")
                )
            deployment_snapshot = await session.scalar(
                sa.select(self.db.NativeStreamDeploymentSnapshot)
                .where(
                    self.db.NativeStreamDeploymentSnapshot.flow_run_id == flow_run_id
                )
                .with_for_update()
            )
            launches = (
                await session.scalars(
                    sa.select(self.db.NativeStreamLaunchIdentity)
                    .where(
                        self.db.NativeStreamLaunchIdentity.flow_run_id == flow_run_id
                    )
                    .order_by(self.db.NativeStreamLaunchIdentity.generation)
                    .with_for_update()
                )
            ).all()
            replacements = (
                await session.scalars(
                    sa.select(self.db.NativeStreamReplacementOperation)
                    .where(
                        self.db.NativeStreamReplacementOperation.flow_run_id
                        == flow_run_id
                    )
                    .order_by(self.db.NativeStreamReplacementOperation.created)
                    .with_for_update()
                )
            ).all()
            manifests = (
                await session.scalars(
                    sa.select(self.db.StreamSubmission)
                    .where(self.db.StreamSubmission.flow_run_id == flow_run_id)
                    .order_by(self.db.StreamSubmission.submission_key)
                    .with_for_update()
                )
            ).all()
            finite_manifests = (
                await session.scalars(
                    sa.select(self.db.StreamFiniteSubmission)
                    .where(self.db.StreamFiniteSubmission.flow_run_id == flow_run_id)
                    .order_by(self.db.StreamFiniteSubmission.submission_key)
                    .with_for_update()
                )
            ).all()
            streams = (
                await session.scalars(
                    sa.select(self.db.StreamPartition)
                    .where(self.db.StreamPartition.flow_run_id == flow_run_id)
                    .order_by(self.db.StreamPartition.id)
                    .with_for_update()
                )
            ).all()
            ids = [stream.id for stream in streams]
            consumers = sa.select(self.db.StreamConsumer.id).where(
                self.db.StreamConsumer.flow_run_id == flow_run_id
            )
            await session.execute(
                sa.delete(self.db.StreamCompletion).where(
                    self.db.StreamCompletion.consumer_id.in_(consumers)
                )
            )
            await session.execute(
                sa.delete(self.db.StreamConsumer).where(
                    self.db.StreamConsumer.flow_run_id == flow_run_id
                )
            )
            await session.execute(
                sa.delete(self.db.StreamRecord).where(
                    self.db.StreamRecord.stream_id.in_(ids)
                )
            )
            await session.execute(
                sa.delete(self.db.StreamFiniteReceipt).where(
                    self.db.StreamFiniteReceipt.finite_submission_id.in_(
                        [manifest.id for manifest in finite_manifests]
                    )
                )
            )
            count = 0
            for stream in streams:
                if not stream.released:
                    count += 1
                    if stream.state == "OPEN":
                        _finish(
                            stream, "FlowRun payload released after final lifecycle"
                        )
                    stream.released = True
                    stream.record_count, stream.byte_count = 0, 0
            released_at = cast(DateTime, now("UTC"))
            for manifest in manifests:
                if manifest.state == "ACTIVE":
                    manifest.state = "RELEASED"
                    manifest.released_at = released_at
            for manifest in finite_manifests:
                if manifest.state == "ACTIVE":
                    manifest.state = "RELEASED"
                    manifest.released_at = released_at
            authority = await session.scalar(
                sa.select(self.db.StreamExecutionAuthority)
                .where(self.db.StreamExecutionAuthority.flow_run_id == flow_run_id)
                .with_for_update()
            )
            if authority is not None:
                authority.state = "RELEASED"
            if deployment_snapshot is not None:
                deployment_snapshot.state = "RELEASED"
            for launch in launches:
                launch.state = "RELEASED"
            for replacement in replacements:
                replacement.state = "RELEASED"
        return count
