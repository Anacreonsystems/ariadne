class StreamGraphStartupStopRequest(_Wire):
    operation_id: UUID
    abort_operation_id: UUID
    grant_id: UUID
    expected_physical_epoch: int = Field(ge=1, le=64, strict=True)
    death_witness: NativeStreamProcessDeathWitness | None = None
    unstarted: bool = False

    @model_validator(mode="after")
    def one_stop_proof(self) -> Self:
        if (self.death_witness is None) != self.unstarted:
            raise ValueError(
                "provide exactly one exact death witness or unstarted acknowledgement"
            )
        return self


class StreamWorkerStartupStopRequest(_Wire):
    principal: StreamWorkerPrincipal
    stop: StreamGraphStartupStopRequest


class StreamGraphStartupStopResult(_Wire):
    operation_id: UUID
    graph_revision_id: UUID
    subtask_id: UUID
    grant_id: UUID
    physical_epoch: int = Field(ge=1, le=64, strict=True)
    state: Literal["STOPPED"] = "STOPPED"
    graph_state: Literal["ABORTING", "RELEASED"]
