        "TERMINAL_RECONCILIATION"
    )

    @field_validator("error")
    @classmethod
    def bounded_error(cls, value: str) -> str:
        if len(value.encode("utf-8")) > 4096:
            raise ValueError("retirement error exceeds 4096 UTF-8 bytes")
        return value


