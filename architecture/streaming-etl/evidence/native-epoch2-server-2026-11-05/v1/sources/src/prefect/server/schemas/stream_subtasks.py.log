        "COMPLETED_RECONCILED",
        "FAILED_RECONCILED",
        "RETRY_EXHAUSTED",
        "ATTEMPT_LIMIT",
        "NONRETRIABLE_FAILURE",
        "REPLACEMENT_PREFLIGHT_FAILED",
    ]
