+        assert (
+            await m.bootstrap_subtask(session, db, subtask.id, scoped)
+        ).grant.id == grant.id
+    with pytest.raises(NativeStreamError, match="drift"):
+        async with db.session_context(begin_transaction=True) as session:
+            await m.activate_graph(
