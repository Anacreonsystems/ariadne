+async def test_capability_is_not_echoed_from_validation_or_off_allowlist(
+    db: PrefectDBInterface, physical_api: httpx.AsyncClient
+):
+    secret = "ab" * 32
+    basic = "Basic " + base64.b64encode(b"native-physical:test").decode()
