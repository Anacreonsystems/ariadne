from pathlib import Path
import datetime,hashlib,json,os,subprocess,time
ROOT=Path('/workspace/ariadne');OUT=Path('/tmp/native-epoch2-dag-live-sdk-v2');OUT.mkdir(exist_ok=True)
def snap(name):
 paths=list((ROOT/'src/prefect').rglob('*.py'))+list((ROOT/'tests').rglob('*.py'))+[ROOT/'pyproject.toml']
 values={str(p.relative_to(ROOT)):hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(paths) if '__pycache__' not in p.parts}
 value={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'files':values,'sha256':hashlib.sha256(json.dumps(values,sort_keys=True,separators=(',',':')).encode()).hexdigest()};(OUT/(name+'.json')).write_text(json.dumps(value,indent=2)+'\n');return value
for source_name in ['tests/test_native_dag_client_http.py','tests/server/api/test_stream_dags.py','tests/server/api/test_native_deployments.py','tests/server/api/test_stream_workers.py','tests/server/models/test_stream_dags.py','tests/fixtures/database.py']:
 (OUT/(source_name.replace('/','__')+'.log')).write_bytes((ROOT/source_name).read_bytes())
for label,backend,selection in [('postgres','postgresql+asyncpg://native_recovery:native_recovery@127.0.0.1:55436/native_epoch2_sdk_dag','postgres'),('sqlite','sqlite+aiosqlite:///:memory:','sqlite')]:
 before=snap(label+'-before');environment=os.environ.copy();environment['PREFECT_SERVER_DATABASE_CONNECTION_URL']=backend
 command=['uv','run','--no-sync','pytest','-n0','-q','tests/test_native_dag_client_http.py','-k',selection,'--tb=short','--junitxml',str(OUT/(label+'.xml'))]
 start=time.monotonic()
 with (OUT/(label+'.log')).open('wb') as output: process=subprocess.run(command,cwd=ROOT,env=environment,stdout=output,stderr=subprocess.STDOUT)
 after=snap(label+'-after');changed=sorted(x for x in before['files'].keys()|after['files'].keys() if before['files'].get(x)!=after['files'].get(x))
 result={'command':command,'exit_code':process.returncode,'seconds':round(time.monotonic()-start,6),'before_sha256':before['sha256'],'after_sha256':after['sha256'],'changed_paths':changed}
 (OUT/(label+'-execution.json')).write_text(json.dumps(result,indent=2)+'\n');print(json.dumps({'backend':label,**result}),flush=True)
