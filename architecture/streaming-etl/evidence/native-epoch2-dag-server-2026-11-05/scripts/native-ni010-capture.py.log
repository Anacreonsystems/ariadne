from pathlib import Path
import hashlib,json,sys
r=Path('/workspace/ariadne')
owned='''src/prefect/server/api/__init__.py
src/prefect/server/database/interface.py
src/prefect/server/database/orm_models.py
src/prefect/server/database/_migrations/versions/postgresql/2026_11_05_000000_d8a3f76b2c90_add_stream_dag_topology.py
src/prefect/server/database/_migrations/versions/sqlite/2026_11_05_000000_e9b4a87c3d01_add_stream_dag_topology.py
src/prefect/server/models/stream_dags.py
src/prefect/server/models/stream_worker_capacity.py
src/prefect/server/models/stream_executions.py
src/prefect/server/models/stream_subtask_authority.py
src/prefect/server/models/stream_subtasks.py
src/prefect/server/models/stream_workers.py
src/prefect/server/models/streams.py
src/prefect/server/schemas/native_deployments.py
src/prefect/server/schemas/stream_dags.py
src/prefect/server/services/task_run_recorder.py
tests/fixtures/database.py
tests/server/models/test_stream_dags.py
tests/server/database/test_stream_dag_migrations.py
tests/server/database/test_stream_subtask_migrations.py'''.splitlines()
allp={p for p in (r/'src/prefect').rglob('*.py')}|{p for p in (r/'tests/fixtures').rglob('*.py')}|{r/p for p in owned}
output={'owned':{p:hashlib.sha256((r/p).read_bytes()).hexdigest() for p in owned},'inputs':{str(p.relative_to(r)):hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(allp)},'scope':'NI2-010 server component; not full union acceptance'}
Path(sys.argv[1]).write_text(json.dumps(output,sort_keys=True,indent=2)+'\n')
print(json.dumps({'files':len(output['inputs']),'owned':len(owned),'sha256':hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest()}))
