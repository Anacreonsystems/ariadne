 for cols in [['id','profile'],['id','flow_run_id'],['id','admission_operation_id','profile']]:uq(lines,m.StreamGraphRevision,cols,False)
 ck(lines,'stream_graph_revision','profile_valid',"profile = 'partitioned-fixed-v1' AND assignment_epoch = 1")
 text='\n'.join(lines)+'\n';ast.parse(text)
 path=Path('src/prefect/server/database/_migrations/versions')/backend/f'2026_11_05_000000_{revision}_add_stream_dag_topology.py';path.write_text(text)
