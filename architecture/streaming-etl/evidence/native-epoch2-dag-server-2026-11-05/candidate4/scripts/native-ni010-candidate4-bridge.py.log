import ast,hashlib,json,marshal,types
from pathlib import Path
root=Path('/workspace/ariadne');p=root/'src/prefect/server/models/stream_dags.py'
before=p.read_text();before_bytes=before.encode()
expected=json.loads((root/'architecture/streaming-etl/evidence/native-epoch2-dag-server-2026-11-05/index.json').read_text())['source']['owned_files'][str(p.relative_to(root))]
assert hashlib.sha256(before_bytes).hexdigest()==expected
assert 'from typing import cast\n' in before and 'DAG_PROFILE = "partitioned-dag-v1"\n' in before
after=before.replace('from typing import cast\n','from typing import Literal, cast\n',1).replace('DAG_PROFILE = "partitioned-dag-v1"\n','DAG_PROFILE: Literal["partitioned-dag-v1"] = "partitioned-dag-v1"\n',1)
assert len(before.splitlines())==len(after.splitlines())
class NormalizeBridge(ast.NodeTransformer):
 def visit_ImportFrom(self,node):
  if node.module=='typing':node.names=[n for n in node.names if n.name!='Literal']
  return node
 def visit_AnnAssign(self,node):
  if isinstance(node.target,ast.Name) and node.target.id=='DAG_PROFILE':
   return ast.Assign(targets=[node.target],value=node.value)
  return node
old=ast.parse(before);new=ast.parse(after)
assert ast.dump(old,include_attributes=False)==ast.dump(NormalizeBridge().visit(new),include_attributes=False)
def executable_codes(source):
 out={}
 def visit(code):
  for item in code.co_consts:
   if isinstance(item,types.CodeType):
    key=item.co_qualname+'@'+str(item.co_firstlineno)
    assert key not in out,key
    out[key]=hashlib.sha256(marshal.dumps(item)).hexdigest();visit(item)
 visit(compile(source,str(p),'exec'));return out
codes_before=executable_codes(before);codes_after=executable_codes(after)
assert codes_before==codes_after
constant=lambda text:next(ast.literal_eval(n.value) for n in ast.parse(text).body if isinstance(n,(ast.Assign,ast.AnnAssign)) and ((isinstance(n,ast.AnnAssign) and isinstance(n.target,ast.Name) and n.target.id=='DAG_PROFILE') or (isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='DAG_PROFILE' for t in n.targets))))
assert constant(before)==constant(after)=='partitioned-dag-v1'
functions=lambda text:{(n.name,n.lineno):ast.dump(n,include_attributes=False) for n in ast.walk(ast.parse(text)) if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
assert functions(before)==functions(after)
Path('/tmp/native-ni010-candidate4-before.py.log').write_bytes(before_bytes)
Path('/tmp/native-ni010-candidate4-after.py.log').write_text(after)
proof={'schema':'native-ni2-010-type-only-bridge-v1','path':str(p.relative_to(root)),'before_sha256':hashlib.sha256(before_bytes).hexdigest(),'after_sha256':hashlib.sha256(after.encode()).hexdigest(),'line_count_unchanged':len(before.splitlines()),'diff_scope':'typing.Literal import and annotation of existing DAG_PROFILE only','constant_before':constant(before),'constant_after':constant(after),'executable_module_ast_equal_after_removing_only_bridge':True,'function_and_class_ast_equal':True,'function_and_nested_codeobject_marshal_equal':True,'codeobjects':codes_after,'module_annotation_metadata_changes':True,'no_runtime_behavior_claim_from_types':'Module __annotations__ gains DAG_PROFILE; function/class bodies and executable codeobjects are identical.'}
Path('/tmp/native-ni010-candidate4-equivalence.json').write_text(json.dumps(proof,indent=2,sort_keys=True)+'\n')
ast.parse(after);p.write_text(after)
print(json.dumps({k:v for k,v in proof.items() if k!='codeobjects'}));print('codeobjects',len(codes_after))
