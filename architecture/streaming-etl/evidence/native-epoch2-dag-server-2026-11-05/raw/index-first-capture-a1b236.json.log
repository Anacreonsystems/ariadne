    {
      "finding": "Early discovery incorrectly admitted SQLite region metadata; final backend boundary refuses both capability registration and admission with exact UNSUPPORTED_BACKEND and no mutation.",
      "raw": "raw/native-ni010-model-admission-sqlite1.log"
    },
    {
      "finding": "Grouped locator used unsupported min(uuid); fixed with named occupied column and deterministic host/boot ordering.",
      "raw": "raw/native-ni010-model-fences-pg2.log"
    },
    {
      "finding": "Corruption fixture attempted RELEASED manifest without required timestamp; corrected constraint-valid fixture.",
      "raw": "raw/native-ni010-model-fences-sqlite2.log"
    },
    {
      "finding": "Abort oracle expected explicit zero Counter keys; correct empty Counter is verified.",
      "raw": "raw/native-ni010-model-complete-pg4.log"
    },
    {
      "finding": "Same zero-Counter test oracle remained in a formatted successor; fixed before final gates.",
      "raw": "raw/native-ni010-model-migration-pg5.log"
    },
